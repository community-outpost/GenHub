FILE_VERSION = 2;
STARTLAYOUTBLOCK
  LAYOUTINIT = W3DOptionsMenuInit;
  LAYOUTUPDATE = OptionsMenuUpdate;
  LAYOUTSHUTDOWN = OptionsMenuShutdown;
ENDLAYOUTBLOCK
WINDOW
  WINDOWTYPE = USER;
  SCREENRECT = UPPERLEFT: 150 100,
               BOTTOMRIGHT: 650 500,
               CREATIONRESOLUTION: 800 600;
  NAME = "OptionsMenu.wnd:OptionsMenuParent";
  STATUS = ENABLED+BORDER+IMAGE;
  STYLE = USER;
  SYSTEMCALLBACK = "OptionsMenuSystem";
  INPUTCALLBACK = "OptionsMenuInput";
  TOOLTIPCALLBACK = "[None]";
  DRAWCALLBACK = "[None]";
  FONT = NAME: "Arial", SIZE: 12, BOLD: 1;
  HEADERTEMPLATE = "[None]";
  TOOLTIPDELAY = -1;
  TEXTCOLOR = ENABLED:  255 255 255 255, ENABLEDBORDER:  0 0 0 255,
              DISABLED: 128 128 128 255, DISABLEDBORDER: 0 0 0 255,
              HILITE:   255 255 255 255, HILITEBORDER:   0 0 0 255;
  ENABLEDDRAWDATA = IMAGE: MainMenuRuler, COLOR: 30 30 50 240, BORDERCOLOR: 100 100 140 255;
  DISABLEDDRAWDATA = IMAGE: NoImage, COLOR: 64 64 64 255, BORDERCOLOR: 0 0 0 255;
  HILITEDRAWDATA = IMAGE: NoImage, COLOR: 40 40 70 240, BORDERCOLOR: 150 150 200 255;
  CHILD
  WINDOW
    WINDOWTYPE = STATIC_TEXT;
    SCREENRECT = UPPERLEFT: 200 120,
                 BOTTOMRIGHT: 600 150,
                 CREATIONRESOLUTION: 800 600;
    NAME = "OptionsMenu.wnd:TitleLabel";
    STATUS = ENABLED;
    STYLE = USER;
    FONT = NAME: "Arial", SIZE: 16, BOLD: 1;
    TEXTCOLOR = ENABLED: 255 215 0 255, ENABLEDBORDER: 0 0 0 255,
                DISABLED: 128 128 128 255, DISABLEDBORDER: 0 0 0 255,
                HILITE: 255 215 0 255, HILITEBORDER: 0 0 0 255;
    TEXT = "GUI:Options";
  END
  WINDOW
    WINDOWTYPE = PUSHBUTTON;
    SCREENRECT = UPPERLEFT: 250 440,
                 BOTTOMRIGHT: 370 475,
                 CREATIONRESOLUTION: 800 600;
    NAME = "OptionsMenu.wnd:ButtonAccept";
    STATUS = ENABLED+BORDER+IMAGE;
    STYLE = USER;
    FONT = NAME: "Arial", SIZE: 11, BOLD: 1;
    ENABLEDDRAWDATA = IMAGE: MenuButtonNormal, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    HILITEDRAWDATA = IMAGE: MenuButtonHilited, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    TEXT = "GUI:Accept";
  END
  WINDOW
    WINDOWTYPE = PUSHBUTTON;
    SCREENRECT = UPPERLEFT: 430 440,
                 BOTTOMRIGHT: 550 475,
                 CREATIONRESOLUTION: 800 600;
    NAME = "OptionsMenu.wnd:ButtonCancel";
    STATUS = ENABLED+BORDER+IMAGE;
    STYLE = USER;
    FONT = NAME: "Arial", SIZE: 11, BOLD: 1;
    ENABLEDDRAWDATA = IMAGE: MenuButtonNormal, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    HILITEDRAWDATA = IMAGE: MenuButtonHilited, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    TEXT = "GUI:Cancel";
  END
END

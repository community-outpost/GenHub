FILE_VERSION = 2;
STARTLAYOUTBLOCK
  LAYOUTINIT = W3DSkirmishGameOptionsMenuInit;
  LAYOUTUPDATE = SkirmishGameOptionsMenuUpdate;
  LAYOUTSHUTDOWN = SkirmishGameOptionsMenuShutdown;
ENDLAYOUTBLOCK
WINDOW
  WINDOWTYPE = USER;
  SCREENRECT = UPPERLEFT: 50 40,
               BOTTOMRIGHT: 750 560,
               CREATIONRESOLUTION: 800 600;
  NAME = "SkirmishGameOptionsMenu.wnd:SkirmishParent";
  STATUS = ENABLED+BORDER+IMAGE;
  STYLE = USER;
  SYSTEMCALLBACK = "SkirmishGameOptionsMenuSystem";
  INPUTCALLBACK = "SkirmishGameOptionsMenuInput";
  TOOLTIPCALLBACK = "[None]";
  DRAWCALLBACK = "[None]";
  FONT = NAME: "Arial", SIZE: 11, BOLD: 1;
  HEADERTEMPLATE = "[None]";
  TOOLTIPDELAY = -1;
  TEXTCOLOR = ENABLED:  255 255 255 255, ENABLEDBORDER:  0 0 0 255,
              DISABLED: 128 128 128 255, DISABLEDBORDER: 0 0 0 255,
              HILITE:   255 255 255 255, HILITEBORDER:   0 0 0 255;
  ENABLEDDRAWDATA = IMAGE: MainMenuBackdrop, COLOR: 20 25 35 240, BORDERCOLOR: 70 85 110 255;
  CHILD
  WINDOW
    WINDOWTYPE = STATIC_TEXT;
    SCREENRECT = UPPERLEFT: 70 60,
                 BOTTOMRIGHT: 400 90,
                 CREATIONRESOLUTION: 800 600;
    NAME = "SkirmishGameOptionsMenu.wnd:HeaderTitle";
    STATUS = ENABLED;
    STYLE = USER;
    FONT = NAME: "Arial", SIZE: 14, BOLD: 1;
    TEXTCOLOR = ENABLED: 255 215 0 255, ENABLEDBORDER: 0 0 0 255;
    TEXT = "GUI:SkirmishGameOptions";
  END
  WINDOW
    WINDOWTYPE = PUSHBUTTON;
    SCREENRECT = UPPERLEFT: 570 510,
                 BOTTOMRIGHT: 720 545,
                 CREATIONRESOLUTION: 800 600;
    NAME = "SkirmishGameOptionsMenu.wnd:ButtonPlay";
    STATUS = ENABLED+BORDER+IMAGE;
    STYLE = USER;
    FONT = NAME: "Arial", SIZE: 12, BOLD: 1;
    ENABLEDDRAWDATA = IMAGE: MenuButtonNormal, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    HILITEDRAWDATA = IMAGE: MenuButtonHilited, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    TEXT = "GUI:PlayGame";
  END
  WINDOW
    WINDOWTYPE = PUSHBUTTON;
    SCREENRECT = UPPERLEFT: 70 510,
                 BOTTOMRIGHT: 220 545,
                 CREATIONRESOLUTION: 800 600;
    NAME = "SkirmishGameOptionsMenu.wnd:ButtonBack";
    STATUS = ENABLED+BORDER+IMAGE;
    STYLE = USER;
    FONT = NAME: "Arial", SIZE: 12, BOLD: 1;
    ENABLEDDRAWDATA = IMAGE: MenuButtonNormal, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    HILITEDRAWDATA = IMAGE: MenuButtonHilited, COLOR: 255 255 255 255, BORDERCOLOR: 0 0 0 255;
    TEXT = "GUI:Back";
  END
END

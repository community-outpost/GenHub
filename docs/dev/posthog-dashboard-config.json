{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "GenHub Product Analytics Dashboard",
  "description": "Comprehensive PostHog product analytics dashboard configurations and insight definitions for GenHub telemetry events.",
  "dashboards": [
    {
      "id": "genhub-executive-overview",
      "name": "GenHub - Executive Overview & Engagement",
      "description": "High-level engagement metrics including active users, game launches, updates, downloads, and sharing volume.",
      "pinned": true,
      "tiles": [
        {
          "name": "Daily Active Installations (DAU)",
          "type": "Trends",
          "display": "ActionsLineGraph",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_started",
                "name": "Game Launchers",
                "math": "dau"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "interval": "day"
          }
        },
        {
          "name": "Total Game Sessions Started",
          "type": "Trends",
          "display": "BoldNumber",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_started",
                "name": "Total Game Sessions",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            }
          }
        },
        {
          "name": "Profile Launches: Launcher UI vs Shortcut / Pinned",
          "type": "Trends",
          "display": "ActionsBar",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "profile_launched",
                "name": "Profile Launches",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "breakdownFilter": {
              "breakdowns": [
                {
                  "type": "event",
                  "property": "launch_source"
                }
              ]
            }
          }
        },
        {
          "name": "Profiles Pinned to Desktop",
          "type": "Trends",
          "display": "BoldNumber",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "profile_pinned",
                "name": "Profiles Pinned",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            }
          }
        },
        {
          "name": "App Updates Served Funnel (Check -> Download -> Apply)",
          "type": "Funnels",
          "display": "FunnelViz",
          "query": {
            "kind": "FunnelsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "app_update_checked",
                "name": "Updates Checked"
              },
              {
                "kind": "EventsNode",
                "event": "app_update_downloaded",
                "name": "Updates Downloaded"
              },
              {
                "kind": "EventsNode",
                "event": "app_update_applied",
                "name": "Updates Applied & Restarted"
              }
            ],
            "funnelsFilter": {
              "funnelOrderType": "ordered",
              "funnelWindowInterval": 1,
              "funnelWindowIntervalUnit": "day"
            },
            "dateRange": {
              "date_from": "-30d"
            }
          }
        },
        {
          "name": "Active Installations by Full Build Version",
          "type": "Trends",
          "display": "ActionsTable",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_started",
                "name": "Active Builds",
                "math": "dau"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "breakdownFilter": {
              "breakdowns": [
                {
                  "type": "event",
                  "property": "full_display_version"
                }
              ]
            }
          }
        },
        {
          "name": "Updates Applied Breakdown (From Version -> To Version)",
          "type": "Trends",
          "display": "ActionsTable",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "app_update_applied",
                "name": "Updates Applied",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "breakdownFilter": {
              "breakdowns": [
                {
                  "type": "event",
                  "property": "to_version"
                }
              ]
            }
          }
        },
        {
          "name": "Publisher Content Downloads Completed",
          "type": "Trends",
          "display": "BoldNumber",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "content_download_completed",
                "name": "Downloads Completed",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            }
          }
        },
        {
          "name": "UploadThing Files Uploaded",
          "type": "Trends",
          "display": "BoldNumber",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "uploadthing_upload_completed",
                "name": "Successful Uploads",
                "math": "total"
              },
              {
                "kind": "EventsNode",
                "event": "uploadthing_upload_failed",
                "name": "Failed Uploads",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            }
          }
        }
      ]
    },
    {
      "id": "genhub-game-launch-sessions",
      "name": "GenHub - Game Launch & Session Dynamics",
      "description": "Deep-dive into game sessions, game variants (Zero Hour vs Generals), runners (Wine, Proton, Native), and session length.",
      "pinned": false,
      "tiles": [
        {
          "name": "Game Sessions by Game Type",
          "type": "Trends",
          "display": "ActionsPie",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_started",
                "name": "Sessions",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "breakdownFilter": {
              "breakdowns": [
                {
                  "type": "event",
                  "property": "game_type"
                }
              ]
            }
          }
        },
        {
          "name": "Runner Environments (Linux / Wine / Proton / Native)",
          "type": "Trends",
          "display": "ActionsBarValue",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_started",
                "name": "Sessions",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "breakdownFilter": {
              "breakdowns": [
                {
                  "type": "event",
                  "property": "runner"
                }
              ]
            }
          }
        },
        {
          "name": "Average Session Duration (Minutes)",
          "type": "Trends",
          "display": "ActionsLineGraph",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_ended",
                "name": "Avg Session Duration",
                "math": "avg",
                "math_property": "session_duration_seconds"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            }
          }
        },
        {
          "name": "Session Exit Gracefulness Rate",
          "type": "Trends",
          "display": "ActionsLineGraph",
          "query": {
            "kind": "TrendsQuery",
            "series": [
              {
                "kind": "EventsNode",
                "event": "game_session_ended",
                "name": "Graceful Exits",
                "math": "total"
              }
            ],
            "dateRange": {
              "date_from": "-30d"
            },
            "breakdownFilter": {
              "breakdowns": [
                {
                  "type": "event",
                  "property": "was_graceful"
                }
              ]
            }
          }
        }
      ]
    },

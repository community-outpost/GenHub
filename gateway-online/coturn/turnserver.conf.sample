# GenHub Online edge TURN relay sample.
# Copy to turnserver.conf, replace ${COTURN_SECRET} with the value stored via
# `wrangler secret put COTURN_SECRET`, then run: turnserver -c turnserver.conf
listening-port=3478
tls-listening-port=5349
realm=genhub-online
server-name=genhub-online
# Ephemeral REST credentials minted by the edge (GET /v1/networks/{id}/turn).
use-auth-secret
static-auth-secret=${COTURN_SECRET}
# Relay port range for game packet allocations. coturn burns two ports per
# allocation, so size for 2x peak concurrent relayed peers: 2000 ports here
# support roughly 1000 relayed players. Never run the old 41-port sample in
# production; exhausted relays fail allocations silently mid-match.
min-port=49160
max-port=51160
# Serve turns: with TLS for clients behind UDP-blocking NATs.
# cert=/etc/coturn/fullchain.pem
# pkey=/etc/coturn/privkey.pem
# Refuse to relay back into the host or onto multicast: relays only ever
# connect game clients to each other.
no-loopback-peers
no-multicast-peers
# Peer access control: coturn allows any peer address with no matching rule,
# so deny private, loopback-adjacent, and reserved ranges explicitly. Relay
# peers are addressed by their public allocation addresses, never by the
# 10.42.0.0/20 overlay IPs, so denying 10.0.0.0/8 blocks nothing legit.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Game traffic is UDP only; bound relay abuse cost with quotas. Keep the
# total at or below the 1000-allocation capacity the host is sized for, so
# quota errors surface before CPU/memory saturation does.
no-tcp-relay
user-quota=12
total-quota=1000
fingerprint
# Relay-only by product design: no direct peer-to-peer hole punching.
no-cli
log-file=/var/log/coturn/turn.log
simple-log
# Optional Prometheus scrape for allocation pressure (ports exhausted,
# active sessions). Point your scraper at this port when enabled.
# prometheus
# prometheus-port=9641

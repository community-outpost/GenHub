{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genhub-online-edge",
  "main": "src/index.ts",
  // Keep in sync with vitest.config.ts and the pinned workers-types version.
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE_ROOM", "class_name": "PresenceRoom" },
      { "name": "DIRECTORY_INDEX", "class_name": "DirectoryIndex" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresenceRoom", "DirectoryIndex"] }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": "3600",
    "JOIN_GRANT_TTL_SECONDS": "600",
    "TURN_TTL_SECONDS": "1800",
    "PRESENCE_TIMEOUT_SECONDS": "90",
    "JOIN_RATE_LIMIT": "10",
    "JOIN_RATE_WINDOW_SECONDS": "600",
    "MAX_NETWORKS_PER_IP": "10",
    "DIRECTORY_RATE_PER_MIN": "600",
    "EMPTY_NETWORK_TTL_SECONDS": "300",
    "OVERLAY_SUBNET": "10.42.0.0/20",
    // Comma-separated TURN endpoints handed to members, e.g.
    // "turn:turn.example.com:3478,turns:turn.example.com:5349".
    "TURN_URIS": "turn:turn.example.invalid:3478"
  }
}

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GenHub.Common.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GenHub.Features.Views"
        xmlns:profiles="clr-namespace:GenHub.Features.GameProfiles.Views"
        xmlns:downloads="clr-namespace:GenHub.Features.Downloads.Views"
        xmlns:news="clr-namespace:GenHub.Features.News.Views"
        xmlns:settings="clr-namespace:GenHub.Features.Settings.Views"
        xmlns:tools="clr-namespace:GenHub.Features.Tools.Views"
        xmlns:info="clr-namespace:GenHub.Features.Info.Views"
        xmlns:notifications="clr-namespace:GenHub.Common.Views"
        xmlns:helpers="clr-namespace:GenHub.Common.Helpers"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="GenHub.Common.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="GenHub"
        WindowStartupLocation="CenterScreen"
        Icon="avares://GenHub/Assets/Icons/generalshub-icon.png"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        helpers:WindowChromeHelper.AdaptForPlatform="True"
        Background="#111118"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="Grid.TitleBarArea">
            <Setter Property="Background" Value="#111118"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover">
            <Setter Property="Background" Value="#222230"/>
            <Setter Property="Foreground" Value="#EEEEF5"/>
        </Style>
        <Style Selector="Button.CloseButton:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.TitleBarButton:pressed">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.CloseButton:pressed">
            <Setter Property="Background" Value="#B02517"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Background Gradient for modern depth -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" Radius="1.2">
                    <GradientStop Offset="0" Color="#22123B" />     <!-- Deep purple accent hint at top -->
                    <GradientStop Offset="0.4" Color="#13131A" />   <!-- Subtle transitional tone -->
                    <GradientStop Offset="1" Color="#0B0B0E" />     <!-- Extremely dark, grounded base -->
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Window Container -->
        <Grid RowDefinitions="Auto,*">
            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Classes="TitleBarArea" ColumnDefinitions="Auto,*,Auto" PointerPressed="OnTitleBarPointerPressed">
                <!-- App Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="avares://GenHub/Assets/Icons/generalshub-icon.png" Width="20" Height="20"/>
                    <TextBlock Text="GenHub"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#EEEEF5"/>
                </StackPanel>

                <!-- Draggable region middle spacer -->
                <Rectangle Grid.Column="1" Fill="Transparent" IsHitTestVisible="False"/>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <Button Classes="TitleBarButton" Click="MinimizeButton_Click" ToolTip.Tip="Minimize">
                        <Path Width="10" Height="1" Fill="{Binding $parent[Button].Foreground}"
                              Data="M 0,0 L 10,0" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}"/>
                    </Button>
                    <Button Classes="TitleBarButton" Click="MaximizeButton_Click" ToolTip.Tip="Maximize">
                        <Path Width="10" Height="10" Fill="Transparent"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                              Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
                    </Button>
                    <Button Classes="TitleBarButton CloseButton" Click="CloseButton_Click" ToolTip.Tip="Close">
                        <Path Width="10" Height="10" Fill="Transparent"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                              Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Layout: Sidebar and Content Area -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#16161F" BorderBrush="#262636" BorderThickness="0,1,1,0">
                    <views:SidebarView DataContext="{Binding}" />
                </Border>

                <!-- Content Area -->
                <Grid Grid.Column="1" Background="#0F0F16">
                    <Panel Margin="0">
                        <profiles:GameProfileLauncherView IsVisible="{Binding IsGameProfilesSelected}" DataContext="{Binding GameProfilesViewModel}" />
                        <downloads:DownloadsView IsVisible="{Binding IsDownloadsSelected}" DataContext="{Binding DownloadsViewModel}" />
                        <news:NewsView IsVisible="{Binding IsNewsSelected}" DataContext="{Binding NewsViewModel}" />
                        <tools:ToolsView IsVisible="{Binding IsToolsSelected}" DataContext="{Binding ToolsViewModel}" />
                        <settings:SettingsView IsVisible="{Binding IsSettingsSelected}" DataContext="{Binding SettingsViewModel}" />
                        <info:InfoView IsVisible="{Binding IsInfoSelected}" DataContext="{Binding InfoViewModel}" />
                    </Panel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Global Notification Container Overlay -->
        <notifications:NotificationContainer
            DataContext="{Binding NotificationService}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            ZIndex="1000"/>

        <!-- Linux custom window resize grips -->
        <Panel Name="LinuxResizeGrips" IsVisible="False" IsHitTestVisible="True">
            <Border Name="GripN" Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="TopSide" />
            <Border Name="GripS" Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomSide" />
            <Border Name="GripW" Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="LeftSide" />
            <Border Name="GripE" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="RightSide" />
            <Border Name="GripNW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" />
            <Border Name="GripNE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" />
            <Border Name="GripSW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" />
            <Border Name="GripSE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" />
        </Panel>
    </Panel>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GenHub.Infrastructure.Converters"
             x:Class="GenHub.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenHub/Assets/Styles/ThemeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:StringToImageConverter x:Key="StringToImageConverter" />
            <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:IntToBoolConverter x:Key="IntToBoolConverter" />
            <local:EqualityConverter x:Key="EqualityConverter" />
            <local:BoolToExpandIconConverter x:Key="BoolToExpandIconConverter" />
            <local:BoolToExpandTextConverter x:Key="BoolToExpandTextConverter" />
            <local:StripHtmlConverter x:Key="StripHtmlConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://GenHub/Assets/Styles/ComboBoxStyles.axaml" />
        <StyleInclude Source="avares://GenHub/Assets/Styles/ExpanderStyles.axaml" />
        <StyleInclude Source="avares://GenHub/Assets/Styles/SidebarStyles.axaml" />
        <StyleInclude Source="avares://GenHub/Assets/Styles/ScrollbarStyles.axaml" />
        <StyleInclude Source="avares://GenHub/Common/Controls/SidebarLayoutStyles.axaml" />

        <!-- Global ToolTip Styles: Ensure full text visibility without premature truncation -->
        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="600" />
            <Setter Property="MaxHeight" Value="500" />
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </Application.Styles>
</Application>

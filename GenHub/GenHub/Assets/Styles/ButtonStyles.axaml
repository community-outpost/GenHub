<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Opt-in action roles. Navigation, filter chips and branded controls keep their own styles. -->
    <Style Selector="Button.action-primary, Button.action-secondary, Button.action-danger, Button.icon-action">
        <Setter Property="MinHeight" Value="{DynamicResource ActionMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ActionPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource ActionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action-primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.action-primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.action-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.action-primary:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.action-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.action-primary:disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ActionFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.action-secondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-secondary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ActionFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.action-danger">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.action-danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource ActionDangerHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.action-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ActionDangerHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.action-danger:pressed">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.action-danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.action-danger:disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.action-danger:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ActionFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger)">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.icon-action:not(.action-primary):not(.action-secondary):not(.action-danger):focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ActionFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.action-compact">
        <Setter Property="FontSize" Value="{DynamicResource ActionCompactFontSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource ActionCompactMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ActionCompactPadding}" />
    </Style>
    <Style Selector="Button.icon-action">
        <Setter Property="MinWidth" Value="{DynamicResource ActionCompactMinHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ActionCompactMinHeight}" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button.action-primary PathIcon, Button.action-secondary PathIcon, Button.action-danger PathIcon, Button.icon-action PathIcon">
        <Setter Property="Width" Value="{DynamicResource ActionIconSize}" />
        <Setter Property="Height" Value="{DynamicResource ActionIconSize}" />
    </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Style Selector="Button.library-action, ToggleButton.library-tab, RadioButton.library-tab">
            <Setter Property="CornerRadius" Value="{DynamicResource ActionCornerRadius}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.library-action:pointerover /template/ ContentPresenter, ToggleButton.library-tab:pointerover /template/ ContentPresenter, RadioButton.library-tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
        </Style>
        <Style Selector="Button.library-play">
            <Setter Property="MinWidth" Value="134" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.library-play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.library-stop">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="Button.library-row-action">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.library-row-action, ListBoxItem:focus-within Button.library-row-action, Button.library-row-stop">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="ToggleButton.library-tab, RadioButton.library-tab">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="ToggleButton.library-tab:checked /template/ ContentPresenter, RadioButton.library-tab:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.library-secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.library-compatibility">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.library-compatibility TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.library-compatibility.compatibility-retail">
            <Setter Property="BorderBrush" Value="{DynamicResource CompatibilityRetailBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CompatibilityRetailBackgroundBrush}" />
        </Style>
        <Style Selector="Border.library-compatibility.compatibility-retail TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CompatibilityRetailForegroundBrush}" />
        </Style>
        <Style Selector="Border.library-compatibility.compatibility-nonretail">
            <Setter Property="BorderBrush" Value="{DynamicResource CompatibilityNonRetailBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CompatibilityNonRetailBackgroundBrush}" />
        </Style>
        <Style Selector="Border.library-compatibility.compatibility-nonretail TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CompatibilityNonRetailForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.library-section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.library-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
</Styles>

      "publisherType": "thesuperhackers",
      "targetGame": 1,
      "isStandalone": false,
      "upstreamSync": {
        "provider": "GitHubReleases",
        "repository": "TheSuperHackers/GeneralsGameCode",
        "variantAxis": "game-type",

          {
            "pattern": "generalszh-.*\\.zip$",
            "variant": "Zero Hour",
            "isDefault": true,
            "targetGame": 1
          },
          {
            "pattern": "generals-.*\\.zip$",
            "variant": "Generals",
            "isDefault": false,
            "targetGame": 0

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GenHub.Features.AppUpdate.ViewModels"
             xmlns:cv="using:GenHub.Infrastructure.Converters"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             x:Class="GenHub.Features.AppUpdate.Views.UpdateNotificationView"
             x:DataType="vm:UpdateNotificationViewModel"
             x:Name="Root">

    <UserControl.Resources>
        <cv:IsSubscribedConverter x:Key="IsSubscribedConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Tab Navigation Button Styles -->
        <Style Selector="Button.tab-btn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.tab-btn.active">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.tab-btn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Clickable PR Link Style -->
        <Style Selector="Button.pr-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pr-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Subscribe Button Style handling state via Tag binding -->
        <Style Selector="Button.SubscribeState">
            <Setter Property="Content" Value="{localization:Localize Updates.Button.Subscribe}"/>
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBackgroundBrush}"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SubscribeState:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
        </Style>
        <Style Selector="Button.SubscribeState:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.SubscribeState[Tag=True]">
            <Setter Property="Content" Value="{localization:Localize Updates.Button.Subscribed}"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Background" Value="#1F22C55E"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.SubscribeState[Tag=True]:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F22C55E"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,12">

        <!-- Top Header: Tabs on Left, Sort by on Right (Same Row!) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <!-- Left: Tab Navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Classes="tab-btn"
                        Classes.active="{Binding !IsBrowseTabSelected}"
                        Command="{Binding ShowUpdateTabCommand}"
                        Content="{localization:Localize Updates.Tab.Update}"/>
                <Button Classes="tab-btn"
                        Classes.active="{Binding IsBrowseTabSelected}"
                        Command="{Binding ShowBrowseBuildsTabCommand}"
                        Content="{localization:Localize Updates.Tab.BrowseBuilds}"/>
            </StackPanel>

            <!-- Right: Sort by Dropdown (Only visible on Browse Builds tab) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsBrowseTabSelected}">
                <TextBlock Text="{localization:Localize Updates.SortBy.Label}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding AvailableSortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          MinWidth="160"
                          FontSize="12"
                          Padding="8,4"
                          CornerRadius="6"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Panel Grid.Row="1">
            <!-- Tab 0: Update -->
            <ScrollViewer IsVisible="{Binding !IsBrowseTabSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,0,0,8">
                    <!-- Update Status Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsUpdateAvailable}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                            <!-- Icon -->
                            <Border Grid.RowSpan="2" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Top">
                                <Viewbox Width="24" Height="24">
                                    <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z" Fill="White" />
                                </Viewbox>
                            </Border>

                            <!-- Title & Version -->
                            <StackPanel Grid.Column="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{localization:Localize Updates.Card.AvailableTitle}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <!-- Force Refresh Button inside the card -->
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="4">
                                         <Button Command="{Binding ForceRefreshCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="8"
                                                ToolTip.Tip="{localization:Localize Updates.Tooltip.ForceRefresh}">
                                            <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.86,17.45 19.71,14H17.58C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                      Foreground="#AAAAAA" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding DismissCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="8"
                                                ToolTip.Tip="{localization:Localize Updates.Tooltip.Dismiss}">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Foreground="#AAAAAA" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                    <TextBlock Text="{localization:Localize Updates.Label.Version}" FontSize="14" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding DisplayLatestVersion}" FontSize="14" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{localization:Localize Updates.Label.IsReady}" FontSize="14" Foreground="#CCFFFFFF"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Release Notes Link -->
                            <Button Grid.Row="1" Grid.Column="1" Content="{localization:Localize Updates.Button.ViewReleaseNotes}" Command="{Binding ViewReleaseNotesCommand}"
                                     Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Padding="0" Margin="0,8,0,0" HorizontalAlignment="Left" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Settings / Subscription Info -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{localization:Localize Updates.InstallationSource.Label}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{localization:Localize Updates.Label.CurrentVersionColon}" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding InstalledVersionDisplay}" FontSize="12" Foreground="#888888"/>
                                </StackPanel>
                            </Grid>

                            <!-- Current Source Display -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="{localization:Localize Updates.Button.Unsubscribe}" Command="{Binding UnsubscribeCommand}" IsVisible="{Binding IsSubscribedToAny}"
                                        Background="#30FF0000" Foreground="#FF5555" FontSize="12" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Artifact Selection -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsSubscribedToAny}">
                                <TextBlock Text="{localization:Localize Updates.SelectVersion.Label}" FontSize="12" Foreground="#AAAAAA"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}"
                                              HorizontalAlignment="Stretch" PlaceholderText="{Binding VersionPlaceholderText}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayVersion}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}" FontSize="10" Opacity="0.7"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsLoadingVersions}" Width="60" Height="4" VerticalAlignment="Center" Margin="8,0,0,0"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="2"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Tab 1: Browse Builds -->
            <Grid IsVisible="{Binding IsBrowseTabSelected}" ColumnDefinitions="3*,2*">
                <!-- Left Column: Open Pull Requests -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceElevatedDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Column Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{localization:Localize Updates.OpenPRs.Label}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <Border Background="{DynamicResource AccentBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvailablePullRequests.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBadgeForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Scrollable PR List -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailablePullRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <!-- Left side: PR Info (bounded for text trimming) -->
                                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto" Margin="0,0,12,0">
                                                    <!-- Row 0: PR Number + Title in a 2-column grid so Title trims with ellipsis -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                                        <Button Grid.Column="0"
                                                                Command="{Binding #Root.((vm:UpdateNotificationViewModel)DataContext).OpenPullRequestUrlCommand}"
                                                                CommandParameter="{Binding Number}"
                                                                Classes="pr-link"
                                                                Margin="0,0,6,0"
                                                                ToolTip.Tip="{localization:Localize Updates.Tooltip.OpenPR}">
                                                            <TextBlock Text="{Binding Number, StringFormat='#{0}'}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       TextDecorations="Underline"/>
                                                        </Button>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Row 1: Author, Branch, Date -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Opacity="0.6" Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <TextBlock Text="{localization:Localize Updates.Label.By}" FontSize="12"/>
                                                            <TextBlock Text="{Binding Author}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        </StackPanel>
                                                        <TextBlock Text="•" FontSize="12"/>
                                                        <TextBlock Text="{Binding BranchName}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                        <TextBlock Text="•" FontSize="12" IsVisible="{Binding UpdatedAt, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding UpdatedAt, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <TextBlock Text="{localization:Localize Updates.Label.UpdatedColon}" FontSize="12"/>
                                                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:g}'}" FontSize="12"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Right side: Subscribe Button -->
                                                <Button Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding #Root.((vm:UpdateNotificationViewModel)DataContext).SubscribeToPrCommand}"
                                                        CommandParameter="{Binding Number}"
                                                        Classes="SmallAction SubscribeState">
                                                    <Button.Tag>
                                                        <MultiBinding Converter="{StaticResource IsSubscribedConverter}">
                                                            <Binding Path="." />
                                                            <Binding Path="#Root.((vm:UpdateNotificationViewModel)DataContext).SubscribedPr" />
                                                            <Binding Path="#Root.((vm:UpdateNotificationViewModel)DataContext).SubscribedBranch" />
                                                        </MultiBinding>
                                                    </Button.Tag>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right Column: Branches -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceElevatedDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Column Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{localization:Localize Updates.Branches.Label}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <Border Background="{DynamicResource AccentBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvailableBranches.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBadgeForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Scrollable Branches List -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableBranches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"/>
                                                <Button Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding #Root.((vm:UpdateNotificationViewModel)DataContext).SubscribeToBranchCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="SmallAction SubscribeState">
                                                    <Button.Tag>
                                                        <MultiBinding Converter="{StaticResource IsSubscribedConverter}">
                                                            <Binding Path="." />
                                                            <Binding Path="#Root.((vm:UpdateNotificationViewModel)DataContext).SubscribedPr" />
                                                            <Binding Path="#Root.((vm:UpdateNotificationViewModel)DataContext).SubscribedBranch" />
                                                        </MultiBinding>
                                                    </Button.Tag>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Panel>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <!-- Global Refresh Button & Current Version -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Command="{Binding ManualRefreshCommand}" Content="{localization:Localize Updates.Button.CheckForUpdates}"
                        Background="Transparent" Foreground="#AAAAAA" FontSize="14" Cursor="Hand"
                        ToolTip.Tip="{localization:Localize Updates.Tooltip.CheckForUpdates}"/>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InstalledVersionDisplay}"
                               FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Detailed Progress Display -->
            <StackPanel Grid.Column="1" IsVisible="{Binding IsInstalling}" VerticalAlignment="Center" Margin="16,0">
                <ProgressBar Value="{Binding DownloadProgress}" Height="4" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource AccentBrush}" CornerRadius="2"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanDownloadUpdate}"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    Padding="24,10" CornerRadius="20" FontWeight="Bold" FontSize="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                              Width="16" Height="16"
                              Foreground="White"/>
                    <TextBlock Text="{Binding InstallButtonText}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:GenHub.Features.Tools.WndEditor.Views"
             xmlns:vm="clr-namespace:GenHub.Features.Tools.WndEditor.ViewModels"
             x:Class="GenHub.Features.Tools.WndEditor.Views.WndEditorView">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}"/>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Command="{Binding NewDocumentCommand}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.New}"
                  FontSize="11" FontWeight="SemiBold"/>
          <Button Command="{Binding OpenFileWithDialogCommand}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.Open}"
                  FontSize="11" FontWeight="SemiBold"/>
          <Button Command="{Binding SaveFileCommand}"
                  IsEnabled="{Binding HasDocument}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.Save}"
                  FontSize="11" FontWeight="SemiBold"/>
          <Button Command="{Binding SaveFileAsWithDialogCommand}"
                  IsEnabled="{Binding HasDocument}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.SaveAs}"
                  FontSize="11" FontWeight="SemiBold"/>
          <Button Command="{Binding UndoCommand}"
                  IsEnabled="{Binding CanUndo}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.Undo}"
                  FontSize="11" FontWeight="SemiBold"/>
          <Button Command="{Binding RedoCommand}"
                  IsEnabled="{Binding CanRedo}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.Redo}"
                  FontSize="11" FontWeight="SemiBold"/>
          <Button Command="{Binding ValidateDocumentCommand}"
                  IsEnabled="{Binding HasDocument}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{localization:Localize Tools.WndEditor.Toolbar.Validate}"
                  FontSize="11" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding DocumentTitle}"
                   FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="12,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ToggleButton IsChecked="{Binding IsPanMode, Mode=TwoWay}"
                        Padding="8,4"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        ToolTip.Tip="{localization:Localize Tools.WndEditor.Canvas.PanTooltip}"
                        AutomationProperties.Name="{localization:Localize Tools.WndEditor.Canvas.PanTooltip}">
            <material:MaterialIcon Kind="HandBackLeft" Width="14" Height="14"/>
          </ToggleButton>
          <Button Command="{Binding ZoomOutCommand}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  ToolTip.Tip="{localization:Localize Tools.WndEditor.Canvas.ZoomOutTooltip}"
                  AutomationProperties.Name="{localization:Localize Tools.WndEditor.Canvas.ZoomOutTooltip}">
            <material:MaterialIcon Kind="MagnifyMinus" Width="14" Height="14"/>
          </Button>
          <Button Command="{Binding ResetZoomCommand}"
                  Padding="8,4" MinWidth="52"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Content="{Binding ZoomDisplayText}"
                  FontSize="11"
                  ToolTip.Tip="{localization:Localize Tools.WndEditor.Canvas.ZoomResetTooltip}"
                  AutomationProperties.Name="{localization:Localize Tools.WndEditor.Canvas.ZoomResetTooltip}"/>
          <Button Command="{Binding ZoomInCommand}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  ToolTip.Tip="{localization:Localize Tools.WndEditor.Canvas.ZoomInTooltip}"
                  AutomationProperties.Name="{localization:Localize Tools.WndEditor.Canvas.ZoomInTooltip}">
            <material:MaterialIcon Kind="MagnifyPlus" Width="14" Height="14"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid ColumnDefinitions="320,4,*,4,380" IsVisible="{Binding HasDocument}">
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14" ClipToBounds="True">
          <TabControl>
            <TabItem Header="{localization:Localize Tools.WndEditor.Tabs.Windows}">
              <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBox Grid.Row="0"
                         Text="{Binding WindowsFilter, Mode=TwoWay}"
                         Watermark="{localization:Localize Tools.WndEditor.Tree.FilterWatermark}"
                         FontSize="11" Margin="0,8,0,6"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                  <Button Command="{Binding ExpandAllNodesCommand}"
                          Padding="8,4"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="6"
                          Content="{localization:Localize Tools.WndEditor.Tree.ExpandAll}"
                          FontSize="11"/>
                  <Button Command="{Binding CollapseAllNodesCommand}"
                          Padding="8,4"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="6"
                          Content="{localization:Localize Tools.WndEditor.Tree.CollapseAll}"
                          FontSize="11"/>
                </StackPanel>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                  <TreeView ItemsSource="{Binding RootNodes}"
                            SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                            BorderThickness="0" Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:WndTreeNodeViewModel">
                        <Border Margin="4,1" Padding="6,3" CornerRadius="6" Background="Transparent" ToolTip.Tip="{Binding FullName}">
                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentTintBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                              <TextBlock Text="{Binding Window.ControlTypeName}"
                                         FontSize="9" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2"
                                    IsVisible="{Binding IsHidden}"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                              <TextBlock Text="{localization:Localize Tools.WndEditor.Tree.HiddenBadge}"
                                         FontSize="9"
                                         Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                          </Grid>
                        </Border>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                  <Button Command="{Binding AddChildWindowCommand}"
                          Padding="8,4"
                          Background="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="6"
                          Content="{localization:Localize Tools.WndEditor.Tree.AddChild}"
                          FontSize="11" FontWeight="SemiBold"/>
                  <Button Command="{Binding DeleteSelectedWindowCommand}"
                          IsEnabled="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Padding="8,4"
                          Background="{DynamicResource ErrorBadgeBackgroundBrush}"
                          Foreground="{DynamicResource ErrorBrush}"
                          BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                          CornerRadius="6"
                          Content="{localization:Localize Tools.WndEditor.Tree.Delete}"
                          FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="{localization:Localize Tools.WndEditor.Tabs.Files}">
              <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,8,0,6">
                  <Button Command="{Binding BrowseFilesDirectoryCommand}"
                          Padding="8,4"
                          Background="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="6"
                          Content="{localization:Localize Tools.WndEditor.Files.Browse}"
                          FontSize="11" FontWeight="SemiBold"/>
                  <Button Command="{Binding RefreshFilesCommand}"
                          Padding="8,4"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="6"
                          Content="{localization:Localize Tools.WndEditor.Files.Refresh}"
                          FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding FilesDirectory}"
                           FontSize="10" Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                           ToolTip.Tip="{Binding FilesDirectory}"/>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WndFileEntryViewModel">
                          <Button Command="{Binding ElementName=Root, Path=DataContext.OpenExplorerFileCommand}"
                                  CommandParameter="{Binding}"
                                  Background="Transparent" BorderThickness="0"
                                  Padding="0" Margin="4,1"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Border Padding="6,3" CornerRadius="6" Background="Transparent">
                              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding FullPath}"/>
                                <Border Grid.Column="1"
                                        IsVisible="{Binding IsCurrent}"
                                        Background="{DynamicResource AccentTintBackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                  <TextBlock Text="{localization:Localize Tools.WndEditor.Files.OpenBadge}"
                                             FontSize="10" FontWeight="SemiBold"
                                             Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

        <Border Grid.Column="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
              <TextBlock Grid.Column="0"
                         Text="{localization:Localize Tools.WndEditor.Pane.Preview}"
                         FontWeight="Bold" FontSize="14"
                         Foreground="{DynamicResource TextPrimary}"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding AssetStatusText}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding AssetStatusTooltip}"
                           IsVisible="{Binding AssetStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{localization:Localize Tools.WndEditor.Assets.Label}"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding AvailableInstallations}"
                          SelectedItem="{Binding SelectedAssetInstallation, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          MinWidth="200" FontSize="11"
                          PlaceholderText="{localization:Localize Tools.WndEditor.Assets.SelectorWatermark}"
                          ToolTip.Tip="{localization:Localize Tools.WndEditor.Assets.SelectorTooltip}"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    ClipToBounds="True">
              <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel x:Name="CanvasHost"
                       Background="Transparent"
                       Cursor="{Binding CanvasCursor}"
                       PointerPressed="OnCanvasHostPointerPressed"
                       PointerMoved="OnCanvasPointerMoved"
                       PointerReleased="OnCanvasPointerReleased"
                       PointerWheelChanged="OnCanvasWheelChanged">
                  <ItemsControl ItemsSource="{Binding CanvasItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WndCanvasItemViewModel">
                        <Panel PointerPressed="OnCanvasItemPointerPressed" Background="Transparent"
                               Opacity="{Binding CanvasOpacity}" ToolTip.Tip="{Binding Label}">
                          <Border Width="{Binding Width}" Height="{Binding Height}"
                                  Background="{DynamicResource SurfaceHoverBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1" CornerRadius="2"/>
                          <Border Width="{Binding Width}" Height="{Binding Height}"
                                  Background="{Binding FillOverlay}"
                                  IsVisible="{Binding ShowFill}"
                                  BorderThickness="0" CornerRadius="2"
                                  IsHitTestVisible="False"/>
                          <Image Width="{Binding Width}" Height="{Binding Height}"
                                 Source="{Binding Image}"
                                 Stretch="Fill"
                                 IsVisible="{Binding HasImage}"
                                 IsHitTestVisible="False"/>
                          <Border Width="{Binding Width}" Height="{Binding Height}"
                                  IsVisible="{Binding HasBorderOverlay}"
                                  BorderBrush="{Binding BorderOverlay}"
                                  BorderThickness="1" CornerRadius="2"
                                  IsHitTestVisible="False"/>
                          <Border Width="{Binding Width}" Height="{Binding Height}"
                                  IsVisible="{Binding IsSelected}"
                                  BorderBrush="{DynamicResource AccentBrush}"
                                  BorderThickness="2" CornerRadius="2"/>
                          <ItemsControl ItemsSource="{Binding Overlays}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Canvas Width="{Binding Width}" Height="{Binding Height}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                              <ControlTheme TargetType="ContentPresenter" x:DataType="vm:WndCanvasOverlayViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                              </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:WndCanvasOverlayViewModel">
                                <Image Source="{Binding Image}"
                                       Width="{Binding Width}" Height="{Binding Height}"
                                       Stretch="Fill" IsHitTestVisible="False"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Image Source="{Binding GlyphImage}"
                                 Width="{Binding GlyphWidth}" Height="{Binding GlyphHeight}"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center" HorizontalAlignment="Left"
                                 IsVisible="{Binding HasGlyph}"
                                 IsHitTestVisible="False"/>
                          <TextBlock Text="{Binding ContentText}"
                                     Width="{Binding Width}" Height="{Binding Height}"
                                     Padding="{Binding ContentTextPadding}"
                                     FontSize="{Binding ContentFontSize}"
                                     FontWeight="{Binding ContentFontWeight}"
                                     Foreground="{Binding ContentTextBrush}"
                                     TextAlignment="{Binding ContentTextAlignment}"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasContentText}"
                                     IsHitTestVisible="False"/>
                          <TextBlock Text="{Binding Label}"
                                     Margin="4,2" FontSize="10"
                                     Foreground="{DynamicResource TextSecondary}"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="{Binding Width}"
                                     IsVisible="{Binding ShowPrimaryNameTag}"
                                     IsHitTestVisible="False"/>
                          <TextBlock Text="{Binding Label}"
                                     Margin="4,2" FontSize="10" FontStyle="Italic"
                                     Foreground="{DynamicResource TextMuted}"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="{Binding Width}"
                                     IsVisible="{Binding ShowFallbackNameTag}"
                                     IsHitTestVisible="False"/>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns"/>

        <Border Grid.Column="4"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14" ClipToBounds="True">
          <Grid>
            <TabControl IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TabItem Header="{localization:Localize Tools.WndEditor.Tabs.General}">
                <views:WndGeneralPropertiesView DataContext="{Binding SelectedProperties}" Margin="0,8,0,0"/>
              </TabItem>
              <TabItem Header="{localization:Localize Tools.WndEditor.Tabs.Control}">
                <views:WndControlPropertiesView DataContext="{Binding SelectedProperties}" Margin="0,8,0,0"/>
              </TabItem>
              <TabItem Header="{localization:Localize Tools.WndEditor.Tabs.Raw}">
                <views:WndRawTextView DataContext="{Binding SelectedProperties}" Margin="0,8,0,0"/>
              </TabItem>
            </TabControl>
            <StackPanel IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="{localization:Localize Tools.WndEditor.Pane.NoSelectionTitle}"
                         FontWeight="Bold" FontSize="14"
                         Foreground="{DynamicResource TextPrimary}"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{localization:Localize Tools.WndEditor.Pane.NoSelectionMessage}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="24"
              IsVisible="{Binding !HasDocument}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="{localization:Localize Tools.WndEditor.Empty.Title}"
                     FontWeight="Bold" FontSize="16"
                     Foreground="{DynamicResource TextPrimary}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{localization:Localize Tools.WndEditor.Empty.Message}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondary}"
                     HorizontalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Button Command="{Binding OpenFileWithDialogCommand}"
                    Padding="12,6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Content="{localization:Localize Tools.WndEditor.Empty.OpenButton}"
                    FontSize="11" FontWeight="SemiBold"/>
            <Button Command="{Binding NewDocumentCommand}"
                    Padding="12,6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Content="{localization:Localize Tools.WndEditor.Empty.NewButton}"
                    FontSize="11" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             x:Class="GenHub.Features.Tools.WndEditor.Views.WndRawTextView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="{localization:Localize Tools.WndEditor.Raw.Hint}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="4,4,4,8"/>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SurfaceElevatedBrush}">
      <TextBox Text="{Binding RawText, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas,Menlo,monospace" FontSize="11" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
      <Button Command="{Binding ApplyRawTextCommand}" Padding="12,6" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource PrimaryButtonForeground}" BorderThickness="0" CornerRadius="6" Content="{localization:Localize Tools.WndEditor.Raw.Apply}" FontSize="11" FontWeight="SemiBold"/>
      <Button Command="{Binding ResetRawTextCommand}" Padding="12,6" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Content="{localization:Localize Tools.WndEditor.Raw.Reset}" FontSize="11" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.GenHotkeys.ViewModels"
             xmlns:enums="using:GenHub.Core.Models.Enums"
             xmlns:hotkeyModels="using:GenHub.Core.Models.Tools.GenHotkeys"
             xmlns:converters="using:GenHub.Infrastructure.Converters"
             xmlns:hotkeyConverters="using:GenHub.Features.Tools.GenHotkeys.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="GenHub.Features.Tools.GenHotkeys.Views.GenHotkeysView"
             x:DataType="vm:GenHotkeysViewModel"
             Focusable="True"
             KeyDown="OnRootKeyDown">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/Tools/Views/ToolIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
      <converters:EqualityConverter x:Key="EqualsToConverter" />
      <converters:NotNullConverter x:Key="NotNullConverter" />
      <converters:BoolToBorderConverter x:Key="BoolToBorderConverter" />
      <converters:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
      <hotkeyConverters:CornerToHorizontalAlignmentConverter x:Key="CornerToHorizontalAlignmentConverter" />
      <hotkeyConverters:CornerToVerticalAlignmentConverter x:Key="CornerToVerticalAlignmentConverter" />
      <hotkeyConverters:FactionToGeometryConverter x:Key="FactionToGeometryConverter" />
      <hotkeyConverters:FactionToBrushConverter x:Key="FactionToBrushConverter" />
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.KeyButton">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerColor}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.KeyButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHighlightBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- Action card button styling and hover retention -->
    <Style Selector="Button.action-card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerColor}" />
      <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.action-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHighlightBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>
    <Style Selector="Button.action-card.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource GeneralsAccentBrush}" />
      <Setter Property="Background" Value="#25DAA520" />
    </Style>
    <Style Selector="Button.action-card.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource GeneralsAccentBrush}" />
      <Setter Property="Background" Value="#35DAA520" />
    </Style>
    <Style Selector="Button.action-card.conflict">
      <Setter Property="BorderBrush" Value="#EF4444" />
    </Style>
    <Style Selector="Button.action-card.conflict:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#DC2626" />
      <Setter Property="Background" Value="#20EF4444" />
    </Style>
    <Style Selector="Button.action-card.conflict.selected">
      <Setter Property="BorderBrush" Value="#EF4444" />
      <Setter Property="Background" Value="#30EF4444" />
    </Style>
    <Style Selector="Button.action-card.conflict.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#DC2626" />
      <Setter Property="Background" Value="#40EF4444" />
    </Style>

    <!-- Prevent ListBoxItem pointerover from wiping out selected highlight -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GeneralsAccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GeneralsAccentBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <!-- TOP TOOLBAR / SETTINGS HEADER -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12" Padding="12">
      <StackPanel Spacing="10">
        <!-- Row 1: Game Switcher, Profile Management, Export Button -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Game Tabs -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Game:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <RadioButton Content="Generals"
                         IsChecked="{Binding SelectedGame, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:GameType.Generals}}"
                         GroupName="GameSelector"
                         Classes="TabButton"/>
            <RadioButton Content="Zero Hour"
                         IsChecked="{Binding SelectedGame, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:GameType.ZeroHour}}"
                         GroupName="GameSelector"
                         Classes="TabButton"/>
          </StackPanel>

          <!-- Profile Selector & Presets -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24,0" VerticalAlignment="Center">
            <TextBlock Text="Profile:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      Width="180">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="hotkeyModels:HotkeyProfile">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Text="{Binding NewProfileName}" Watermark="New Profile Name..." Width="140"/>
            <Button Content="New" Command="{Binding CreateNewProfileCommand}" Classes="Secondary" Padding="8,4"/>

            <!-- Rename Profile Button + Flyout -->
            <Button Classes="Secondary" Padding="8,4" ToolTip.Tip="Rename Current Profile">
              <PathIcon Data="{StaticResource ToolIcon.PencilOutline}" Width="14" Height="14" VerticalAlignment="Center"/>
              <Button.Flyout>
                <Flyout>
                  <StackPanel Spacing="8" Width="220">
                    <TextBlock Text="Rename Profile" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding RenameProfileText, Mode=TwoWay}" Watermark="Enter new profile name..."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                      <Button Content="Save" Command="{Binding RenameCurrentProfileCommand}" Classes="Primary" Padding="12,4"/>
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button Command="{Binding DeleteCurrentProfileCommand}" Classes="Secondary" Padding="8,4" ToolTip.Tip="Delete Profile">
              <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="14" Height="14" VerticalAlignment="Center"/>
            </Button>

            <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerColor}" Margin="4,0"/>

            <!-- Presets Menu -->
            <TextBlock Text="Presets:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Content="Legionnaire QWERTY"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="Legionnaire"
                    Classes="Secondary" Padding="8,4"
                    ToolTip.Tip="Apply Legionnaire's standard QWERTY grid hotkeys"/>
            <Button Content="Leikeze"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="Leikeze"
                    Classes="Secondary" Padding="8,4"
                    ToolTip.Tip="Apply Leikeze standard hotkeys"/>
            <Button Content="Vanilla"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="Vanilla"
                    Classes="Secondary" Padding="8,4"
                    ToolTip.Tip="Reset to original game default hotkeys"/>
          </StackPanel>

          <!-- Export Addon (.BIG) Action -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding ExportAddonCommand}"
                    Classes="Primary"
                    IsEnabled="{Binding !IsBusy}"
                    Padding="14,8"
                    ToolTip.Tip="Packs customized hotkeys and icons into a new .big archive, deploys to game folder, and registers as a GenHub Addon">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource ToolIcon.PackageVariantClosed}" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="Create GenHub Addon (.BIG)" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Row 2: Icon Overlay Settings & Category Filters -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <!-- Icon Overlay Options -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding OverlayEnabled}"
                      Content="Overlay Hotkey Badge on Icons (TGA)"
                      FontWeight="SemiBold"
                      ToolTip.Tip="Generates in-game icon textures with the hotkey stamped directly on them (similar to Legionnaire &amp; Leikeze indicators)"/>
            <TextBlock Text="Position:" VerticalAlignment="Center" IsVisible="{Binding OverlayEnabled}"/>
            <ComboBox ItemsSource="{Binding AvailableCorners}"
                      SelectedItem="{Binding SelectedCorner}"
                      IsVisible="{Binding OverlayEnabled}"
                      Width="130"/>
          </StackPanel>

          <!-- Faction & Category Filters -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Category:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding AvailableCategories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Width="120"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- MAIN BODY: FACTIONS + ENTITIES + COMMAND CARDS + KEYBOARD ASSIGNMENT -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*,320" Margin="0,0,0,8">
      <!-- LEFT: Factions & GameObjects List with Faction Icons -->
      <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="8" Margin="0,0,8,0">
        <Grid RowDefinitions="Auto,*">
          <!-- Faction Selector with Icons for USA, GLA, China -->
          <ComboBox Grid.Row="0"
                    ItemsSource="{Binding Factions}"
                    SelectedItem="{Binding SelectedFaction}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="hotkeyModels:HotkeyFaction">
                <DockPanel Margin="2,3">
                  <Border DockPanel.Dock="Left"
                          Width="26" Height="26"
                          CornerRadius="6"
                          Background="#16171E"
                          BorderBrush="{Binding Converter={StaticResource FactionToBrushConverter}}"
                          BorderThickness="1.5"
                          Margin="0,0,8,0"
                          ClipToBounds="True">
                    <Image Source="{Binding Converter={StaticResource FactionToImageConverter}}"
                           Width="20" Height="20"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormattedTitle}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{Binding DisplayNameDescription}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding FilteredGameObjects}"
                   SelectedItem="{Binding SelectedGameObject}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HotkeyGameObjectViewModel">
                <DockPanel Margin="2,4">
                  <Border DockPanel.Dock="Right"
                          IsVisible="{Binding HasConflicts}"
                          Background="#3DF87171"
                          CornerRadius="4"
                          Padding="4,2"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="This unit/building contains overlapping hotkeys!">
                    <TextBlock Text="⚠️" FontSize="10" Foreground="#EF4444" FontWeight="Bold"/>
                  </Border>
                  <Image DockPanel.Dock="Left" Source="{Binding IconBitmap}" Width="46" Height="36" Stretch="Uniform" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- CENTER: Command Cards Grid for Selected GameObject with Way Bigger Images -->
      <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="12" Margin="0,0,8,0">
        <Grid RowDefinitions="Auto,*" DataContext="{Binding SelectedGameObject}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Image Source="{Binding IconBitmap}" Width="72" Height="58" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold"/>
              <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.6"/>
            </StackPanel>
          </StackPanel>

          <!-- Command Layouts View with Way Bigger Buttons -->
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Layouts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource DividerColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="8">
                    <Grid RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Text="Command Layout" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"/>
                      <!-- Action Buttons Wrap Grid with Way Bigger Images -->
                      <ItemsControl Grid.Row="1" ItemsSource="{Binding}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="136" ItemHeight="150" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:HotkeyActionViewModel">
                            <Button Command="{Binding $parent[UserControl].((vm:GenHotkeysViewModel)DataContext).SelectActionCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="action-card"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.conflict="{Binding IsConflict}"
                                    Margin="3"
                                    ToolTip.Tip="{Binding ConflictReason}">
                              <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- Cameo Icon with Live Superimposed Hotkey Badge -->
                                <Grid Grid.Row="0" Width="105" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <!-- Cameo Image -->
                                  <Image Source="{Binding IconBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                  <!-- Superimposed Hotkey Badge directly on icon with live alignment -->
                                  <Border IsVisible="{Binding $parent[UserControl].((vm:GenHotkeysViewModel)DataContext).OverlayEnabled}"
                                          HorizontalAlignment="{Binding $parent[UserControl].((vm:GenHotkeysViewModel)DataContext).SelectedCorner, Converter={StaticResource CornerToHorizontalAlignmentConverter}}"
                                          VerticalAlignment="{Binding $parent[UserControl].((vm:GenHotkeysViewModel)DataContext).SelectedCorner, Converter={StaticResource CornerToVerticalAlignmentConverter}}"
                                          Background="#E010141C"
                                          BorderBrush="{Binding IsConflict, Converter={StaticResource BoolToBorderConverter}}"
                                          BorderThickness="1.5"
                                          CornerRadius="4"
                                          Padding="5,1"
                                          Margin="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                      <TextBlock Text="⚠️" FontSize="10" IsVisible="{Binding IsConflict}" Foreground="#EF4444" VerticalAlignment="Center"/>
                                      <TextBlock Text="{Binding HotkeyBadge}" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource GeneralsAccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                  </Border>
                                </Grid>

                                <!-- Action Label -->
                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="0,6,0,0"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- RIGHT: Interactive Virtual Keyboard & Hotkey Assignment Bar -->
      <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="Hotkey Assignment" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

          <!-- Selected Action Summary Box with Larger Cameo -->
          <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="8" Margin="0,0,0,12"
                  IsVisible="{Binding SelectedAction, Converter={StaticResource NotNullConverter}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- Live Preview Cameo with superimposed hotkey -->
              <Grid Grid.Column="0" Width="72" Height="58" Margin="0,0,8,0">
                <Image Source="{Binding SelectedAction.IconBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border IsVisible="{Binding OverlayEnabled}"
                        HorizontalAlignment="{Binding SelectedCorner, Converter={StaticResource CornerToHorizontalAlignmentConverter}}"
                        VerticalAlignment="{Binding SelectedCorner, Converter={StaticResource CornerToVerticalAlignmentConverter}}"
                        Background="#E010141C"
                        BorderBrush="{Binding SelectedAction.IsConflict, Converter={StaticResource BoolToBorderConverter}}"
                        BorderThickness="1.5"
                        CornerRadius="4"
                        Padding="4,1"
                        Margin="2">
                  <TextBlock Text="{Binding SelectedAction.HotkeyBadge}" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource GeneralsAccentBrush}"/>
                </Border>
              </Grid>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedAction.DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedAction.HotkeyString}" FontSize="9" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Column="2" Background="{DynamicResource SurfaceElevatedDarkBrush}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedAction.HotkeyBadge}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource GeneralsAccentBrush}"/>
              </Border>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2" Text="Click key or press on physical keyboard:" FontSize="11" Opacity="0.7" Margin="0,0,0,6"/>

          <!-- Virtual Keyboard Grid -->
          <StackPanel Grid.Row="3" Spacing="4" VerticalAlignment="Top">
            <!-- Row 1: Numbers -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
              <Button Content="1" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="1" Width="26" Height="28" Padding="0"/>
              <Button Content="2" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="2" Width="26" Height="28" Padding="0"/>
              <Button Content="3" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="3" Width="26" Height="28" Padding="0"/>
              <Button Content="4" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="4" Width="26" Height="28" Padding="0"/>
              <Button Content="5" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="5" Width="26" Height="28" Padding="0"/>
              <Button Content="6" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="6" Width="26" Height="28" Padding="0"/>
              <Button Content="7" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="7" Width="26" Height="28" Padding="0"/>
              <Button Content="8" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="8" Width="26" Height="28" Padding="0"/>
              <Button Content="9" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="9" Width="26" Height="28" Padding="0"/>
              <Button Content="0" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="0" Width="26" Height="28" Padding="0"/>
            </StackPanel>

            <!-- Row 2: QWERTYUIOP -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
              <Button Content="Q" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="Q" Width="26" Height="28" Padding="0"/>
              <Button Content="W" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="W" Width="26" Height="28" Padding="0"/>
              <Button Content="E" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="E" Width="26" Height="28" Padding="0"/>
              <Button Content="R" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="R" Width="26" Height="28" Padding="0"/>
              <Button Content="T" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="T" Width="26" Height="28" Padding="0"/>
              <Button Content="Y" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="Y" Width="26" Height="28" Padding="0"/>
              <Button Content="U" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="U" Width="26" Height="28" Padding="0"/>
              <Button Content="I" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="I" Width="26" Height="28" Padding="0"/>
              <Button Content="O" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="O" Width="26" Height="28" Padding="0"/>
              <Button Content="P" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="P" Width="26" Height="28" Padding="0"/>
            </StackPanel>

            <!-- Row 3: ASDFGHJKL -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
              <Button Content="A" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="A" Width="28" Height="28" Padding="0"/>
              <Button Content="S" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="S" Width="28" Height="28" Padding="0"/>
              <Button Content="D" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="D" Width="28" Height="28" Padding="0"/>
              <Button Content="F" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="F" Width="28" Height="28" Padding="0"/>
              <Button Content="G" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="G" Width="28" Height="28" Padding="0"/>
              <Button Content="H" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="H" Width="28" Height="28" Padding="0"/>
              <Button Content="J" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="J" Width="28" Height="28" Padding="0"/>
              <Button Content="K" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="K" Width="28" Height="28" Padding="0"/>
              <Button Content="L" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="L" Width="28" Height="28" Padding="0"/>
            </StackPanel>

            <!-- Row 4: ZXCVBNM -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
              <Button Content="Z" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="Z" Width="30" Height="28" Padding="0"/>
              <Button Content="X" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="X" Width="30" Height="28" Padding="0"/>
              <Button Content="C" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="C" Width="30" Height="28" Padding="0"/>
              <Button Content="V" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="V" Width="30" Height="28" Padding="0"/>
              <Button Content="B" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="B" Width="30" Height="28" Padding="0"/>
              <Button Content="N" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="N" Width="30" Height="28" Padding="0"/>
              <Button Content="M" Click="OnKeyButtonClicked" Classes="KeyButton" Tag="M" Width="30" Height="28" Padding="0"/>
            </StackPanel>

            <!-- Row 5: Clear Hotkey Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
              <Button Content="Clear Key [-]" Command="{Binding ClearHotkeyCommand}" Classes="Secondary" Width="120" Height="28"/>
            </StackPanel>
          </StackPanel>

          <!-- Conflict Status Panel with Clear Explanation -->
          <Border Grid.Row="4" Background="#28DC2626" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0"
                  IsVisible="{Binding HasConflicts}">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="⚠️ Hotkey Conflicts Detected!" FontWeight="Bold" Foreground="#EF4444"/>
              </StackPanel>
              <TextBlock Text="{Binding ConflictSummary}" FontSize="11" TextWrapping="Wrap" Foreground="#FCA5A5" LineHeight="16"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- STATUS BAR -->
    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Opacity="0.8"/>
        <TextBlock Grid.Column="1" Text="Changes auto-saved to profile" VerticalAlignment="Center" FontSize="10" Opacity="0.5"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.TextureEditor.ViewModels"
             xmlns:constants="using:GenHub.Core.Constants"
             xmlns:controls="clr-namespace:GenHub.Common.Controls"
             xmlns:editors="clr-namespace:GenHub.Common.Editors"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="GenHub.Features.Tools.TextureEditor.Views.TextureEditorView"
             x:DataType="vm:TextureEditorViewModel"
             x:Name="Root">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}"/>
    <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}"/>
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}"/>
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}"/>
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}"/>
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <!-- Header / Toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="0,0,0,16" Padding="12" BoxShadow="0 4 12 0 #20000000">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource ToolIcon.ImageOutline}" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"
                       IsVisible="{Binding HasAtlas}"/>
            <TextBlock Text="{localization:Localize TextureEditor.Header.NoAtlas}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"
                       IsVisible="{Binding !HasAtlas}"/>
            <TextBlock Text="{Binding AtlasDimensions}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       IsVisible="{Binding HasAtlas}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding HasAtlas}">
          <Button Command="{Binding ZoomOutCommand}" Classes="Secondary" Padding="8" ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.ZoomOut}">
            <PathIcon Data="{StaticResource ToolIcon.MagnifyMinus}" Width="16" Height="16"/>
          </Button>
          <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center"
                     Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
          <Button Command="{Binding ZoomInCommand}" Classes="Secondary" Padding="8" ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.ZoomIn}">
            <PathIcon Data="{StaticResource ToolIcon.MagnifyPlus}" Width="16" Height="16"/>
          </Button>
          <Button Command="{Binding ResetZoomCommand}" Classes="Secondary" Padding="8" ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.ResetZoom}">
            <PathIcon Data="{StaticResource ToolIcon.Refresh}" Width="16" Height="16"/>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding OpenFileCommand}" Classes="Secondary" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.OpenAtlas}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.FolderOpenOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.Open}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SaveCommand}" Classes="Primary" IsEnabled="{Binding HasAtlas}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.Save}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.ContentSaveOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.Save}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SaveAsCommand}" Classes="Secondary" IsEnabled="{Binding HasAtlas}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.SaveAs}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.PencilOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.SaveAs}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding ScanRegistryCommand}" Classes="Secondary" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.ScanRegistry}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.Magnify}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.Scan}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding AutoPackCommand}" Classes="Secondary" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.AutoPack}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.PackageVariantClosed}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.AutoPack}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding ExportIniCommand}" Classes="Secondary" IsEnabled="{Binding HasAtlas}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.ExportIni}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.TrayArrowDown}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.ExportIni}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding ExportSheetCommand}" Classes="Secondary" IsEnabled="{Binding HasAtlas}"
                  ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.ExportSheet}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.ContentSaveOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize TextureEditor.Button.ExportSheet}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*,260">
      <!-- Left: slices + library -->
      <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="0,0,8,0"
              Padding="12" BoxShadow="0 4 12 0 #20000000">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="{localization:Localize TextureEditor.Label.Slices}" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
          <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="{localization:Localize TextureEditor.Tab.Slices}">
              <ListBox ItemsSource="{Binding Slices}" SelectedItem="{Binding SelectedSlice, Mode=TwoWay}"
                       SelectionMode="Single" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TextureSliceViewModel">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                      <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Margin="0,0,10,0"
                              Background="{DynamicResource SurfaceElevatedBrush}" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"/>
                          <PathIcon Data="{StaticResource ToolIcon.ImageOutline}" Width="20" Height="20"
                                    Foreground="{DynamicResource TextMuted}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}x{1} • L{2} T{3}">
                              <Binding Path="Width"/>
                              <Binding Path="Height"/>
                              <Binding Path="Left"/>
                              <Binding Path="Top"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="{localization:Localize TextureEditor.Tab.Files}">
              <editors:EditorFileExplorerControl DataContext="{Binding FileExplorer}"/>
            </TabItem>
            <TabItem Header="{localization:Localize TextureEditor.Tab.Library}">
              <controls:MappedImagePickerControl Name="ImagePicker"
                                                ItemsSource="{Binding RegistryImages}"
                                                ThumbnailProvider="{Binding PickerThumbnailProvider}"/>
            </TabItem>
          </TabControl>
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,8,0,0">
            <Button Grid.Column="0" Command="{Binding AddSliceCommand}" Classes="Secondary" Margin="0,0,4,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding HasAtlas}"
                    ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.AddSlice}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.Plus}" Width="14" Height="14"/>
                <TextBlock Text="{localization:Localize TextureEditor.Button.Add}" VerticalAlignment="Center" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{Binding DuplicateCommand}" Classes="Secondary" Margin="4,0,4,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding CanDuplicate}"
                    ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.DuplicateSlice}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.ContentCopy}" Width="14" Height="14"/>
                <TextBlock Text="{localization:Localize TextureEditor.Button.Duplicate}" VerticalAlignment="Center" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding DeleteCommand}" Classes="Danger" Margin="4,0,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsEnabled="{Binding SelectedSlice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.DeleteSlice}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="14" Height="14"/>
                <TextBlock Text="{localization:Localize Common.Button.Delete}" VerticalAlignment="Center" FontSize="12"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- Center: canvas -->
      <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="8,0,8,0"
              ClipToBounds="True" BoxShadow="0 4 12 0 #20000000">
        <Panel>
          <ScrollViewer Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding HasAtlas}">
            <Panel Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
              <Image Source="{Binding AtlasBitmap}" Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                     Stretch="Fill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
              <ItemsControl Name="SliceOverlay" ItemsSource="{Binding Slices}" Background="Transparent">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter" x:DataType="vm:TextureSliceViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding DisplayX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding DisplayY}"/>
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TextureSliceViewModel">
                    <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                            Classes="slice" Classes.selected="{Binding IsSelected}" Classes.invalid="{Binding !IsWithinTexture}"
                            BorderThickness="2" Background="Transparent"
                            Cursor="SizeAll"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>

          <!-- Empty state -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                      IsVisible="{Binding !HasAtlas}" Margin="24">
            <PathIcon Data="{StaticResource ToolIcon.ImageOutline}" Width="52" Height="52"
                      Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
            <TextBlock Text="{localization:Localize TextureEditor.Empty.Title}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="{localization:Localize TextureEditor.Empty.Description}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            <Button Command="{Binding OpenFileCommand}" Classes="Primary" HorizontalAlignment="Center" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.FolderOpenOutline}" Width="16" Height="16"/>
                <TextBlock Text="{localization:Localize TextureEditor.Button.OpenAtlas}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Busy overlay -->
          <Border Background="#99000000" IsVisible="{Binding IsBusy}" CornerRadius="12">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="24,20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 8 24 0 #40000000" MinWidth="240"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Spacing="12">
                <TextBlock Text="{localization:Localize TextureEditor.Label.Working}" HorizontalAlignment="Center" FontWeight="SemiBold"
                           FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SurfaceHoverBrush}"/>
                <Button Command="{Binding CancelOperationCommand}" Classes="Secondary" HorizontalAlignment="Center">
                  <TextBlock Text="{localization:Localize Common.Button.Cancel}" VerticalAlignment="Center" FontSize="12"/>
                </Button>
              </StackPanel>
            </Border>
          </Border>
        </Panel>
      </Border>

      <!-- Right: inspector -->
      <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="8,0,0,0"
              Padding="12" BoxShadow="0 4 12 0 #20000000">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="{localization:Localize TextureEditor.Label.Inspector}" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"/>
            <StackPanel Spacing="12" IsVisible="{Binding SelectedSlice, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize TextureEditor.Label.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBox Text="{Binding SelectedSlice.Name, Mode=TwoWay}"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{localization:Localize TextureEditor.Label.Left}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding SelectedSlice.Left, Mode=TwoWay}" Minimum="0" Maximum="{Binding AtlasPixelWidth}" Increment="1" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{localization:Localize TextureEditor.Label.Top}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SelectedSlice.Top, Mode=TwoWay}" Minimum="0" Maximum="{Binding AtlasPixelHeight}" Increment="1" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{localization:Localize TextureEditor.Label.Right}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SelectedSlice.Right, Mode=TwoWay}" Minimum="0" Maximum="{Binding AtlasPixelWidth}" Increment="1" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{localization:Localize TextureEditor.Label.Bottom}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding SelectedSlice.Bottom, Mode=TwoWay}" Minimum="0" Maximum="{Binding AtlasPixelHeight}" Increment="1"/>
              </Grid>
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{localization:Localize TextureEditor.Label.Size}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} x {1} px">
                        <Binding Path="SelectedSlice.Width"/>
                        <Binding Path="SelectedSlice.Height"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SelectedSlice.IsWithinTexture}">
                  <PathIcon Data="{StaticResource ToolIcon.Check}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{localization:Localize TextureEditor.Label.WithinBounds}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !SelectedSlice.IsWithinTexture}">
                  <PathIcon Data="{StaticResource ToolIcon.AlertTriangle}" Width="14" Height="14" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{localization:Localize TextureEditor.Label.OutOfBounds}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SelectedSlice.HasGuardBorder}">
                  <PathIcon Data="{StaticResource ToolIcon.Check}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{localization:Localize TextureEditor.Label.GuardOk}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{localization:Localize TextureEditor.Label.Presets}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static constants:TextureEditorConstants.PresetLargeCameo}" Classes="Secondary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.PresetLarge}">
                  <TextBlock Text="{localization:Localize TextureEditor.Preset.Large}" FontSize="12"/>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static constants:TextureEditorConstants.PresetSmallCameo}" Classes="Secondary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.PresetSmall}">
                  <TextBlock Text="{localization:Localize TextureEditor.Preset.Small}" FontSize="12"/>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static constants:TextureEditorConstants.PresetHudButton}" Classes="Secondary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        ToolTip.Tip="{localization:Localize TextureEditor.Tooltip.PresetHud}">
                  <TextBlock Text="{localization:Localize TextureEditor.Preset.Hud}" FontSize="12"/>
                </Button>
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding SelectedSlice, Converter={x:Static ObjectConverters.IsNull}}">
              <PathIcon Data="{StaticResource ToolIcon.VectorSquare}" Width="32" Height="32"
                        Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
              <TextBlock Text="{localization:Localize TextureEditor.Inspector.Empty}" FontSize="12"
                         Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.Primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.Primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.Secondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.Secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
    <Style Selector="Button.Danger">
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.Danger:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Border.slice">
      <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Border.slice.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.slice.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>

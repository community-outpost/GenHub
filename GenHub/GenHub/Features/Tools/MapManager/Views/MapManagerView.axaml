<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Tools.MapManager.ViewModels;assembly=GenHub"
             xmlns:vm_tools="clr-namespace:GenHub.Features.Tools.ViewModels;assembly=GenHub"
             xmlns:models="clr-namespace:GenHub.Core.Models.Tools.MapManager;assembly=GenHub.Core"
             xmlns:enums="clr-namespace:GenHub.Core.Models.Enums;assembly=GenHub.Core"
             xmlns:converters="clr-namespace:GenHub.Infrastructure.Converters;assembly=GenHub"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GenHub.Features.Tools.MapManager.Views.MapManagerView"
             x:DataType="vm:MapManagerViewModel"
             x:Name="Root"
             DragDrop.AllowDrop="True">

  <UserControl.Resources>
    <ResourceDictionary>
      <converters:FileSizeConverter x:Key="FileSizeConverter" />
      <converters:BoolToTypeConverter x:Key="BoolToTypeConverter" />
      <converters:AssetCountConverter x:Key="AssetCountConverter" />
      <converters:MapTypeDisplayConverter x:Key="MapTypeDisplayConverter" />
      <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
      <converters:EqualityConverter x:Key="EqualsToConverter" />
      <converters:LocalizedFormatConverter x:Key="LocalizedFormatConverter" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto" MinWidth="600"
        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <!-- Header/Tabs & Toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="0,0,0,16" Padding="6" BoxShadow="0 4 12 0 #20000000">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Game Tabs -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <RadioButton Content="{localization:Localize Maps.Tab.Generals}"
                       IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:GameType.Generals}}"
                       GroupName="GameTabs"
                       Classes="TabButton"/>
          <RadioButton Content="{localization:Localize Maps.Tab.ZeroHour}"
                       IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:GameType.ZeroHour}}"
                       GroupName="GameTabs"
                       Classes="TabButton"/>
        </StackPanel>

        <!-- Import Bar Integrated -->
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="16,0">
          <TextBox Grid.Column="0" Watermark="{localization:Localize Maps.Watermark.ImportUrl}"
                   Text="{Binding ImportUrl}" Margin="0,0,8,0" VerticalContentAlignment="Center"
                   HorizontalAlignment="Stretch"/>
          <Button Grid.Column="1" Command="{Binding ImportFromUrlCommand}"
                  Classes="action-primary action-compact" Margin="0,0,4,0" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{localization:Localize Maps.Tooltip.ImportFromUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.TrayArrowDown}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Maps.Button.Import}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding BrowseAndImportCommand}"
                  Classes="action-secondary icon-action" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{localization:Localize Maps.Tooltip.BrowseFiles}" AutomationProperties.Name="{localization:Localize Maps.Tooltip.BrowseFiles}">
            <PathIcon Data="{StaticResource ToolIcon.Paperclip}" Width="16" Height="16"/>
          </Button>
        </Grid>

        <!-- Search Bar -->
        <TextBox Grid.Column="2" Watermark="{localization:Localize Maps.Watermark.Search}"
                 Text="{Binding SearchText}"
                 Width="170"
                 VerticalAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource ToolIcon.Magnify}" Width="16" Height="16"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
          </TextBox.InnerLeftContent>
        </TextBox>

        <!-- Utilities -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Command="{Binding LoadMapsCommand}" Classes="action-secondary icon-action" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{localization:Localize Maps.Tooltip.RefreshList}" AutomationProperties.Name="{localization:Localize Maps.Tooltip.RefreshList}">
            <PathIcon Data="{StaticResource ToolIcon.Refresh}" Width="16" Height="16"/>
          </Button>
          <Button Command="{Binding OpenFolderCommand}" Classes="action-secondary icon-action" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{localization:Localize Maps.Tooltip.OpenFolder}" AutomationProperties.Name="{localization:Localize Maps.Tooltip.OpenFolder}">
            <PathIcon Data="{StaticResource ToolIcon.FolderOpenOutline}" Width="16" Height="16"/>
          </Button>
          <Button Command="{Binding ToggleMapPackPanelCommand}" Classes="action-secondary action-compact" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{localization:Localize Maps.Tooltip.MapPackManager}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.PackageVariantClosed}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Maps.Button.Pack}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Map List -->
    <Panel Grid.Row="1">
      <Border Background="{DynamicResource CardBackground}" CornerRadius="12" ClipToBounds="True" BoxShadow="0 4 12 0 #20000000">
        <DataGrid Name="MapsGrid"
                  ItemsSource="{Binding CurrentMaps}"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  RowHeight="48"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="48" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:MapFile">
                  <Grid Width="32" Height="32" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="{Binding ThumbnailBitmap}"
                           Width="32" Height="32"
                           Stretch="Uniform"
                           IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <PathIcon Data="{StaticResource ToolIcon.MapOutline}"
                              Width="20" Height="20"
                              Foreground="{DynamicResource TextMuted}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{localization:Localize Maps.Column.Name}" Binding="{Binding DisplayName}" Width="*" MinWidth="180" SortMemberPath="DisplayName" />
            <DataGridTemplateColumn Header="{localization:Localize Maps.Column.Players}" Width="Auto" MinWidth="85" SortMemberPath="PlayerCount">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:MapFile">
                  <TextBlock Text="{Binding FormattedPlayerCount}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="4,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{localization:Localize Maps.Column.Size}" Width="Auto" MinWidth="95" SortMemberPath="SizeBytes">
              <DataGridTextColumn.Binding>
                <Binding Path="SizeBytes" Converter="{StaticResource FileSizeConverter}" Mode="OneWay" />
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{localization:Localize Maps.Column.Type}" Width="Auto" MinWidth="150" SortMemberPath="MapTypeSortKey">
              <DataGridTextColumn.Binding>
                <Binding Path="." Converter="{StaticResource MapTypeDisplayConverter}" Mode="OneWay" />
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{localization:Localize Maps.Column.Modified}" Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="Auto" MinWidth="180" SortMemberPath="LastModified" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Empty State -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                  IsVisible="{Binding !CurrentMaps.Count}"
                  IsHitTestVisible="False">
        <PathIcon Data="{StaticResource ToolIcon.MapOutline}" Width="52" Height="52" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
        <TextBlock Text="{localization:Localize Maps.Empty.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
        <TextBlock Text="{localization:Localize Maps.Empty.Description}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Drag & Drop Overlay -->
      <Border Name="DragDropOverlay"
              Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="2"
              IsVisible="False"
              IsHitTestVisible="False"
              CornerRadius="12"
              Opacity="0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
          </Transitions>
        </Border.Transitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
          <PathIcon Data="{StaticResource ToolIcon.TrayArrowDown}" Width="64" Height="64" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="{localization:Localize Maps.DragDrop.Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
          <TextBlock Text="{localization:Localize Maps.DragDrop.Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Loading Overlay -->
      <Border Background="#99000000" IsVisible="{Binding IsBusy}" CornerRadius="12">
        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="24,20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                BoxShadow="0 8 24 0 #40000000" MinWidth="300" MaxWidth="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontWeight="SemiBold"
                       FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
            <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100"
                         Height="6" CornerRadius="3"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource SurfaceHoverBrush}" />
            <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}"
                       HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       IsVisible="{Binding !IsIndeterminate}"/>
          </StackPanel>
        </Border>
      </Border>
    </Panel>

    <!-- Action Bar -->
    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="0,16,0,0" Padding="12" BoxShadow="0 4 12 0 #20000000">
      <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="400">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{localization:Localize Maps.Label.Selected}" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedMaps.Count}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          </StackPanel>
          <Button Command="{Binding DeleteSelectedCommand}"
                  Classes="action-danger ActionBarBtn action-compact" IsEnabled="{Binding SelectedMaps.Count}"
                  ToolTip.Tip="{localization:Localize Maps.Tooltip.DeleteSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Common.Button.Delete}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="12,0"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding UncompressSelectedCommand}"
                  Classes="action-secondary ActionBarBtn action-compact" IsEnabled="{Binding HasSelectedZips}"
                  ToolTip.Tip="{localization:Localize Maps.Tooltip.UncompressSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.PackageVariantClosed}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Maps.Button.Uncompress}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBox MinWidth="110" MaxWidth="160" Watermark="{localization:Localize Maps.Watermark.ZipName}" Text="{Binding ZipName}" Height="32" VerticalAlignment="Center" ToolTip.Tip="{localization:Localize Maps.Tooltip.ZipName}"/>
          <Button Command="{Binding ExportToZipCommand}"
                  Classes="action-secondary ActionBarBtn action-compact" IsEnabled="{Binding SelectedMaps.Count}"
                  ToolTip.Tip="{localization:Localize Maps.Tooltip.ZipSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.ZipBoxOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Maps.Button.Zip}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Command="{Binding UploadAndShareCommand}"
                    Classes="action-primary SplitLeft ActionBarBtn action-compact"
                    ToolTip.Tip="{localization:Localize Maps.Tooltip.UploadAndShare}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.CloudUploadOutline}" Width="16" Height="16"/>
                <TextBlock Text="{localization:Localize Maps.Button.Upload}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <ToggleButton
                    IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                    Classes="Primary SplitRight ActionBarBtn"
                    ToolTip.Tip="{localization:Localize Maps.Tooltip.ViewHistory}">
              <PathIcon Data="{StaticResource ToolIcon.ChevronRight}" Width="14" Height="14" VerticalAlignment="Center"/>
            </ToggleButton>
            <Popup IsOpen="{Binding IsHistoryOpen}"
                   Placement="Bottom" PlacementTarget="{Binding $parent[StackPanel]}"
                   IsLightDismissEnabled="False">
              <Border Background="{DynamicResource DetailsBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                      Padding="14" MinWidth="340" MaxHeight="400" BoxShadow="{DynamicResource FlyoutBoxShadow}">
                <Grid RowDefinitions="Auto,*">
                  <Grid Grid.Row="1">
                    <ScrollViewer IsVisible="{Binding UploadHistory.Count}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding UploadHistory}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm_tools:UploadHistoryItemViewModel">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <Border Background="Transparent" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="4,0,0,0">
                                      <Panel>
                                        <TextBlock Text="{localization:Localize Maps.Label.Active}" FontSize="10" Foreground="{Binding StatusColor}"
                                                   IsVisible="{Binding IsActive}"/>
                                        <TextBlock Text="{localization:Localize Maps.Label.Expired}" FontSize="10" Foreground="{Binding StatusColor}"
                                                   IsVisible="{Binding !IsActive}"/>
                                      </Panel>
                                    </Border>
                                  </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Classes="action-secondary icon-action"
                                        Command="{Binding #Root.((vm:MapManagerViewModel)DataContext).CopyUrlCommand}"
                                        CommandParameter="{Binding Url}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Localize Maps.Tooltip.CopyLink}" AutomationProperties.Name="{localization:Localize Maps.Tooltip.CopyLink}">
                                  <PathIcon Data="{StaticResource ToolIcon.ContentCopy}" Width="16" Height="16"/>
                                </Button>

                                <Button Grid.Column="2" Classes="action-secondary icon-action"
                                        Command="{Binding #Root.((vm:MapManagerViewModel)DataContext).CopyGenHubLinkCommand}"
                                        CommandParameter="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Localize Maps.Tooltip.CopyGenHubLink}" AutomationProperties.Name="{localization:Localize Maps.Tooltip.CopyGenHubLink}">
                                  <PathIcon Data="{StaticResource ToolIcon.ShareOutline}" Width="16" Height="16"/>
                                </Button>

                                <Button Grid.Column="3" Classes="action-danger icon-action"
                                        Command="{Binding #Root.((vm:MapManagerViewModel)DataContext).RemoveHistoryItemCommand}"
                                        CommandParameter="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Localize Maps.Tooltip.DeleteHistoryItem}" AutomationProperties.Name="{localization:Localize Maps.Tooltip.DeleteHistoryItem}">
                                  <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="16" Height="16"/>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{localization:Localize Maps.Empty.NoHistory}" IsVisible="{Binding !UploadHistory.Count}"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,20"/>
                  </Grid>

                  <!-- Clear All Button -->
                  <Button Command="{Binding ClearHistoryCommand}"
                          Classes="action-danger action-compact"
                          HorizontalAlignment="Stretch"
                          Margin="0,10,0,0"
                          IsVisible="{Binding UploadHistory.Count}"
                          ToolTip.Tip="{localization:Localize Maps.Tooltip.ClearHistory}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource ToolIcon.DeleteSweepOutline}" Width="16" Height="16"/>
                      <TextBlock Text="{localization:Localize Maps.Button.ClearAllHistory}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Popup>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer Storage Notice -->
    <TextBlock Grid.Row="3" Text="{localization:Localize Maps.Label.StorageQuotaNotice}"
               FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="600"/>

    <!-- MapPack Modal Overlay -->
    <Grid Grid.Row="0" Grid.RowSpan="4"
          Background="#AA000000"
          IsVisible="{Binding IsMapPackPanelOpen}">
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Width="450"
              MaxHeight="700"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              BoxShadow="0 8 32 0 #40000000">
        <Grid RowDefinitions="Auto,*,Auto" Margin="24">
          <!-- Header -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize Maps.MapPack.Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{localization:Localize Maps.MapPack.Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ToggleMapPackPanelCommand}"
                    Classes="action-secondary icon-action" VerticalAlignment="Top" ToolTip.Tip="{localization:Localize Common.Button.Close}" AutomationProperties.Name="{localization:Localize Common.Button.Close}">
              <PathIcon Data="{StaticResource ToolIcon.Close}" Width="16" Height="16"/>
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20">
              <!-- Create New Section -->
              <StackPanel Spacing="12">
                <TextBlock Text="{localization:Localize Maps.MapPack.CreateNew}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{localization:Localize Maps.MapPack.SelectedMaps}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <ItemsControl ItemsSource="{Binding SelectedMaps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MapFile">
                              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                  <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{localization:Localize Maps.MapPack.NoMapsSelected}" IsVisible="{Binding !SelectedMaps.Count}"
                                   FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="{localization:Localize Maps.MapPack.PackName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Watermark="{localization:Localize Maps.MapPack.Watermark}" Text="{Binding NewMapPackName}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                  <Button Grid.Column="0" Content="{localization:Localize Maps.MapPack.Button.Create}"
                          Command="{Binding CreateMapPackCommand}"
                          Classes="action-secondary action-compact" Margin="0,0,4,0"
                          HorizontalAlignment="Stretch"/>
                  <Button Grid.Column="1" Command="{Binding CreateAndAddMapPackToProfileCommand}"
                          Classes="action-primary action-compact" Margin="4,0,0,0"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="{localization:Localize Maps.MapPack.Tooltip.CreateAndAddToProfile}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource ToolIcon.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                      <TextBlock Text="{localization:Localize Maps.MapPack.Button.CreateAndAddToProfile}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>

              <Separator Background="{DynamicResource BorderBrush}"/>

              <!-- Existing MapPacks Section -->
              <StackPanel Spacing="12">
                <TextBlock Text="{localization:Localize Maps.MapPack.ExistingPacks}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <ItemsControl ItemsSource="{Binding MapPacks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MapPack">
                      <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="4">
                              <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                  <Border Grid.Column="1" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" IsVisible="{Binding TargetGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                                      <TextBlock Text="{Binding TargetGame, Converter={x:Static converters:GameTypeDisplayConverter.Instance}}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                  </Border>
                                  <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" IsVisible="{Binding IsLoaded}">
                                      <TextBlock Text="{localization:Localize Maps.MapPack.Badge.Loaded}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                  </Border>
                              </Grid>
                              <TextBlock Text="{Binding CreatedDate, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='Maps.MapPack.CreatedDateFormat'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                              <TextBlock Text="{Binding MapFilePaths.Count, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='Maps.MapPack.MapsCountFormat'}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Command="{Binding #Root.((vm:MapManagerViewModel)DataContext).AddMapPackToProfileCommand}"
                                    CommandParameter="{Binding}" Classes="action-secondary action-compact"
                                    ToolTip.Tip="{localization:Localize Maps.MapPack.Tooltip.AddToProfile}">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource ToolIcon.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{localization:Localize Maps.MapPack.Button.AddToProfile}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                              </StackPanel>
                            </Button>
                            <Button Command="{Binding #Root.((vm:MapManagerViewModel)DataContext).DeleteMapPackCommand}"
                                    CommandParameter="{Binding}" Classes="action-danger icon-action" ToolTip.Tip="{localization:Localize Maps.MapPack.Tooltip.Delete}" AutomationProperties.Name="{localization:Localize Maps.MapPack.Tooltip.Delete}">
                              <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="16" Height="16"/>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{localization:Localize Maps.MapPack.NoPacksFound}" IsVisible="{Binding !MapPacks.Count}"
                           FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,10"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="RadioButton.TabButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" CornerRadius="8" Padding="16,8" Background="Transparent">
            <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold"
                       Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.TabButton:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.TabButton:checked /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.TabButton:checked">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Button styles -->
    <Style Selector="ToggleButton.Primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.Primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>

    <!-- Shared split-button layout follows the action styles so split corners and height win. -->
    <StyleInclude Source="avares://GenHub/Features/Tools/Views/ToolActionBarStyles.axaml" />


    <Style Selector="ToggleButton.Primary:checked">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
    </Style>

  </UserControl.Styles>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             x:Class="GenHub.Features.Tools.ModBuilder.Controls.ProgressCard">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Background="{DynamicResource SurfaceElevatedBrush}"
          BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBorderConverter}}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="14"
          BoxShadow="0 2 8 0 #20000000">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">

        <!-- Stage Icon -->
        <Border Grid.Column="0"
                Width="38" Height="38"
                Background="{Binding StageColor}"
                CornerRadius="8"
                Margin="0,0,12,0">
          <Path Width="20" Height="20"
                Fill="{DynamicResource TextPrimary}"
                Data="{Binding StageIcon}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"/>
        </Border>

        <!-- Stage Name -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding StageName}"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{Binding StageDescription}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSecondary}"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status Badge -->
        <Border Grid.Column="2"
                Background="{Binding StatusBackground}"
                CornerRadius="6"
                Padding="8,4"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{Binding StatusForeground}"/>
        </Border>

      </Grid>

      <!-- Progress Bar -->
      <Border Grid.Row="1"
              Height="6"
              Background="{DynamicResource SurfaceHoverBrush}"
              CornerRadius="3"
              Margin="0,10,0,0"
              ClipToBounds="True">
        <Border Width="{Binding ProgressWidth}"
                HorizontalAlignment="Left"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="3">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.3"/>
            </Transitions>
          </Border.Transitions>
        </Border>
      </Border>

      <!-- Metrics -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,10,0,0">

        <!-- Files Processed -->
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding FilesProcessed, StringFormat='{}{0} files'}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="Processed"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextSecondary}"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Processing Speed -->
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding ProcessingSpeed, StringFormat='{}{0:F1}/s'}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="Speed"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextSecondary}"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Time Remaining -->
        <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding TimeRemaining, StringFormat='{}{0:mm\\:ss}'}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="Remaining"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextSecondary}"
                     Margin="0,2,0,0"/>
        </StackPanel>

      </Grid>

      <!-- Current File -->
      <Border Grid.Row="3"
              Background="{DynamicResource SurfaceHoverBrush}"
              CornerRadius="6"
              Padding="8,6"
              Margin="0,10,0,0"
              IsVisible="{Binding HasCurrentFile}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0"
                     Text="Processing:"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondary}"
                     Margin="0,0,8,0"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding CurrentFile}"
                     FontFamily="JetBrains Mono, Consolas, Courier New, monospace"
                     FontSize="11"
                     Foreground="{DynamicResource TextPrimary}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding CurrentFile}"/>
        </Grid>
      </Border>

    </Grid>

  </Border>

</UserControl>

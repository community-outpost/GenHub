<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             x:Class="GenHub.Features.Tools.ModBuilder.Controls.ProgressCard">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Background="{StaticResource BackgroundElevatedBrush}"
          BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBorderConverter}}"
          BorderThickness="{StaticResource BorderThicknessNormal}"
          CornerRadius="{StaticResource CornerRadiusLarge}"
          Padding="{StaticResource PaddingMedium}"
          BoxShadow="{StaticResource ShadowNormal}">

    <Border.Styles>
      <Style Selector="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
      </Style>
    </Border.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">

        <!-- Stage Icon -->
        <Border Grid.Column="0"
                Width="40" Height="40"
                Background="{Binding StageColor}"
                CornerRadius="{StaticResource CornerRadiusMedium}"
                Margin="0,0,12,0">
          <Path Width="24" Height="24"
                Fill="{StaticResource TextPrimaryBrush}"
                Data="{Binding StageIcon}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <!-- Stage Name -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding StageName}"
                     FontSize="{StaticResource FontSizeLarge}"
                     FontWeight="{StaticResource FontWeightSemiBold}"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding StageDescription}"
                     FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status Badge -->
        <Border Grid.Column="2"
                Background="{Binding StatusBackground}"
                CornerRadius="{StaticResource CornerRadiusSmall}"
                Padding="8,4"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}"
                     FontSize="{StaticResource FontSizeSmall}"
                     FontWeight="{StaticResource FontWeightSemiBold}"
                     Foreground="{Binding StatusForeground}"/>
        </Border>

      </Grid>

      <!-- Progress Bar -->
      <Border Grid.Row="1"
              Height="6"
              Background="{StaticResource SurfaceBrush}"
              CornerRadius="3"
              Margin="0,12,0,0"
              ClipToBounds="True">
        <Border Width="{Binding ProgressWidth}"
                HorizontalAlignment="Left"
                Background="{StaticResource AccentGradientBrush}"
                CornerRadius="3">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.3"/>
            </Transitions>
          </Border.Transitions>
        </Border>
      </Border>

      <!-- Metrics -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,12,0,0">

        <!-- Files Processed -->
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding FilesProcessed, StringFormat='{}{0} files'}"
                     FontSize="{StaticResource FontSizeMedium}"
                     FontWeight="{StaticResource FontWeightSemiBold}"
                     Foreground="{StaticResource AccentPrimaryBrush}"/>
          <TextBlock Text="Processed"
                     FontSize="{StaticResource FontSizeXSmall}"
                     Foreground="{StaticResource TextTertiaryBrush}"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Processing Speed -->
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding ProcessingSpeed, StringFormat='{}{0:F1}/s'}"
                     FontSize="{StaticResource FontSizeMedium}"
                     FontWeight="{StaticResource FontWeightSemiBold}"
                     Foreground="{StaticResource AccentPrimaryBrush}"/>
          <TextBlock Text="Speed"
                     FontSize="{StaticResource FontSizeXSmall}"
                     Foreground="{StaticResource TextTertiaryBrush}"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Time Remaining -->
        <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding TimeRemaining, StringFormat='{}{0:mm\\:ss}'}"
                     FontSize="{StaticResource FontSizeMedium}"
                     FontWeight="{StaticResource FontWeightSemiBold}"
                     Foreground="{StaticResource AccentPrimaryBrush}"/>
          <TextBlock Text="Remaining"
                     FontSize="{StaticResource FontSizeXSmall}"
                     Foreground="{StaticResource TextTertiaryBrush}"
                     Margin="0,2,0,0"/>
        </StackPanel>

      </Grid>

      <!-- Current File -->
      <Border Grid.Row="3"
              Background="{StaticResource SurfaceBrush}"
              CornerRadius="{StaticResource CornerRadiusSmall}"
              Padding="{StaticResource PaddingSmall}"
              Margin="0,12,0,0"
              IsVisible="{Binding HasCurrentFile}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0"
                     Text="Processing:"
                     FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Margin="0,0,8,0"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding CurrentFile}"
                     FontFamily="{StaticResource FontFamilyMonospace}"
                     FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding CurrentFile}"/>
        </Grid>
      </Border>

    </Grid>

  </Border>

</UserControl>

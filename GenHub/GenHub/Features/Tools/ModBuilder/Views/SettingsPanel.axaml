<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ModBuilder.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GenHub.Features.Tools.ModBuilder.Views.SettingsPanel"
             x:DataType="vm:SettingsPanelViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.settings-btn">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.settings-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="20">

      <!-- Header -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="ModBuilder Settings"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Configure build performance, cache, and UI preferences"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Command="{Binding ResetToDefaultsCommand}"
                  Classes="settings-btn"
                  ToolTip.Tip="Reset all settings to defaults">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Fill="{DynamicResource TextPrimary}" Data="{StaticResource IconReset}" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="Reset to Defaults" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Cache Management Section -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <StackPanel Spacing="16">
          <TextBlock Text="Cache Management"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>

          <!-- Cache Statistics -->
          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="Cache Size:"
                         Foreground="{DynamicResource TextSecondary}"
                         Width="120"/>
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Text="{Binding CacheSizeFormatted}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"/>

              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="Cached Files:" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                         Text="{Binding CachedFileCount}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0"
                         Text="Status:"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                         Text="{Binding IsCacheOperationInProgress, Converter={StaticResource BoolToStringConverter}, ConverterParameter='In Progress|Ready'}"
                         FontWeight="SemiBold"
                         Foreground="{Binding IsCacheOperationInProgress, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFD740|#10B981'}"/>
            </Grid>
          </Border>

          <!-- Cache Actions -->
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Command="{Binding ClearCacheCommand}"
                    IsEnabled="{Binding !IsCacheOperationInProgress}"
                    Classes="settings-btn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,6,0"
                    Padding="0,12"
                    ToolTip.Tip="Clear all cached build files">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="14" Height="14" Fill="{DynamicResource TextPrimary}" Data="{StaticResource IconTrash}" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Clear Cache" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Command="{Binding RebuildCacheCommand}"
                    IsEnabled="{Binding !IsCacheOperationInProgress}"
                    Classes="settings-btn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="6,0,0,0"
                    Padding="0,12"
                    ToolTip.Tip="Rebuild cache index">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="14" Height="14" Fill="{DynamicResource TextPrimary}" Data="{StaticResource IconReload}" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Rebuild Index" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="Clearing cache will remove all cached build artifacts. Files will be rebuilt on next build."
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondary}"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Performance Settings Section -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <StackPanel Spacing="16">
          <TextBlock Text="Performance Settings"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>

          <!-- Compression Level -->
          <StackPanel Spacing="8">
            <TextBlock Text="Default Compression Level"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox ItemsSource="{Binding CompressionLevels}"
                      SelectedItem="{Binding SelectedCompressionLevel}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Default compression level for archives"/>
            <TextBlock Text="Higher compression = smaller files but slower builds"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <!-- Thread Count -->
          <StackPanel Spacing="8">
            <TextBlock Text="Thread Count"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Grid ColumnDefinitions="*,Auto">
              <Slider Grid.Column="0"
                      Minimum="1"
                      Maximum="{Binding ThreadCountOptions.Count}"
                      Value="{Binding SelectedThreadCount}"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      ToolTip.Tip="Number of parallel threads for builds"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding SelectedThreadCount}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"
                         MinWidth="30"
                         TextAlignment="Right"/>
            </Grid>
            <TextBlock Text="More threads = faster builds but higher CPU usage"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <!-- Buffer Size -->
          <StackPanel Spacing="8">
            <TextBlock Text="I/O Buffer Size (KB)"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox ItemsSource="{Binding BufferSizeOptions}"
                      SelectedItem="{Binding SelectedBufferSize}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Buffer size for file I/O operations"/>
            <TextBlock Text="Larger buffers = better performance for large files"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <!-- Default Options -->
          <Separator Background="{DynamicResource BorderBrush}"/>

          <CheckBox Content="Enable Multi-Processing by Default"
                    IsChecked="{Binding EnableMultiProcessingByDefault}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="Use parallel processing for new projects"/>

          <CheckBox Content="Enable Verbose Logging by Default"
                    IsChecked="{Binding EnableVerboseLoggingByDefault}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="Show detailed build information for new projects"/>
        </StackPanel>
      </Border>

      <!-- UI Preferences Section -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <StackPanel Spacing="16">
          <TextBlock Text="UI Preferences"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>

          <!-- Font Size -->
          <StackPanel Spacing="8">
            <TextBlock Text="Build Output Font Size"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox ItemsSource="{Binding FontSizeOptions}"
                      SelectedItem="{Binding SelectedFontSize}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Font size for build output console"/>
          </StackPanel>

          <!-- UI Options -->
          <Separator Background="{DynamicResource BorderBrush}"/>

          <CheckBox Content="Enable Animations"
                    IsChecked="{Binding EnableAnimations}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="Enable smooth transitions and animations"/>

          <CheckBox Content="Auto-Scroll Build Output"
                    IsChecked="{Binding EnableAutoScroll}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="Automatically scroll to latest build output"/>

          <CheckBox Content="Enable Syntax Highlighting"
                    IsChecked="{Binding EnableSyntaxHighlighting}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="Color-code build output by log level"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

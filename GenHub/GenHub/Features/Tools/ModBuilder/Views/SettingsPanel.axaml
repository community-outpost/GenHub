<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ModBuilder.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GenHub.Features.Tools.ModBuilder.Views.SettingsPanel"
             x:DataType="vm:SettingsPanelViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.settings-btn">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.settings-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="20">

      <!-- Header -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.Subtitle}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Command="{Binding ResetToDefaultsCommand}"
                  Classes="settings-btn"
                  ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipResetDefaults}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Fill="{DynamicResource TextPrimary}" Data="{StaticResource IconReset}" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.ButtonResetDefaults}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Cache Management Section -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <StackPanel Spacing="16">
          <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.CacheManagementHeader}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>

          <!-- Cache Statistics -->
          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{localization:Localize Tools.ModBuilder.Settings.LabelCacheSize}"
                         Foreground="{DynamicResource TextSecondary}"
                         Width="120"/>
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Text="{Binding CacheSizeFormatted}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"/>

              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{localization:Localize Tools.ModBuilder.Settings.LabelCachedFiles}" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                         Text="{Binding CachedFileCount}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0"
                         Text="{localization:Localize Tools.ModBuilder.Settings.LabelStatus}"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                         Text="{Binding IsCacheOperationInProgress, Converter={StaticResource BoolToStringConverter}, ConverterParameter='In Progress|Ready'}"
                         FontWeight="SemiBold"
                         Foreground="{Binding IsCacheOperationInProgress, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFD740|#10B981'}"/>
            </Grid>
          </Border>

          <!-- Cache Actions -->
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Command="{Binding ClearCacheCommand}"
                    IsEnabled="{Binding !IsCacheOperationInProgress}"
                    Classes="settings-btn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,6,0"
                    Padding="0,12"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipClearCache}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="14" Height="14" Fill="{DynamicResource TextPrimary}" Data="{StaticResource IconTrash}" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.ButtonClearCache}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Command="{Binding RebuildCacheCommand}"
                    IsEnabled="{Binding !IsCacheOperationInProgress}"
                    Classes="settings-btn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="6,0,0,0"
                    Padding="0,12"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipRebuildIndex}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="14" Height="14" Fill="{DynamicResource TextPrimary}" Data="{StaticResource IconReload}" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.ButtonRebuildIndex}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.NoticeClearCache}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondary}"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Performance Settings Section -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <StackPanel Spacing="16">
          <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.PerformanceHeader}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>

          <!-- Compression Level -->
          <StackPanel Spacing="8">
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.LabelCompressionLevel}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox ItemsSource="{Binding CompressionLevels}"
                      SelectedItem="{Binding SelectedCompressionLevel}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipCompressionLevel}"/>
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.NoticeCompression}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <!-- Thread Count -->
          <StackPanel Spacing="8">
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.LabelThreadCount}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Grid ColumnDefinitions="*,Auto">
              <Slider Grid.Column="0"
                      Minimum="1"
                      Maximum="{Binding ThreadCountOptions.Count}"
                      Value="{Binding SelectedThreadCount}"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipThreadCount}"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding SelectedThreadCount}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"
                         MinWidth="30"
                         TextAlignment="Right"/>
            </Grid>
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.NoticeThreadCount}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <!-- Buffer Size -->
          <StackPanel Spacing="8">
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.LabelIoBufferSize}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox ItemsSource="{Binding BufferSizeOptions}"
                      SelectedItem="{Binding SelectedBufferSize}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipIoBufferSize}"/>
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.NoticeIoBufferSize}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- UI Preferences Section -->
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="18"
              BoxShadow="0 4 16 0 #20000000">
        <StackPanel Spacing="16">
          <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.UiPreferencesHeader}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>

          <!-- Font Size -->
          <StackPanel Spacing="8">
            <TextBlock Text="{localization:Localize Tools.ModBuilder.Settings.LabelFontSize}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox ItemsSource="{Binding FontSizeOptions}"
                      SelectedItem="{Binding SelectedFontSize}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipFontSize}"/>
          </StackPanel>

          <!-- UI Options -->
          <Separator Background="{DynamicResource BorderBrush}"/>

          <CheckBox Content="{localization:Localize Tools.ModBuilder.Settings.CheckEnableAnimations}"
                    IsChecked="{Binding EnableAnimations}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipEnableAnimations}"/>

          <CheckBox Content="{localization:Localize Tools.ModBuilder.Settings.CheckAutoScroll}"
                    IsChecked="{Binding EnableAutoScroll}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipAutoScroll}"/>

          <CheckBox Content="{localization:Localize Tools.ModBuilder.Settings.CheckSyntaxHighlighting}"
                    IsChecked="{Binding EnableSyntaxHighlighting}"
                    Foreground="{DynamicResource TextPrimary}"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.Settings.TooltipSyntaxHighlighting}"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GenHub.Features.Tools.ModBuilder.ViewModels"
        xmlns:models="using:GenHub.Features.Tools.ModBuilder.Models"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="GenHub.Features.Tools.ModBuilder.Views.BundlePackEditorDialog"
        x:DataType="vm:BundlePackEditorViewModel"
        Title="Bundle Pack Editor"
        Icon="/Assets/Icons/generalshub-icon.png"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WindowBackground}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16"
          Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.Title}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <TextBlock Text="{Binding BundlePackName}"
                   FontSize="13.5"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.TotalFiles}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding TotalFileCount}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding TotalSizeFormatted}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>

    <!-- Main content -->
    <Grid Grid.Row="1" ColumnDefinitions="*,320">
      <!-- File list -->
      <Border Grid.Column="0"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14"
              Margin="0,0,10,0">

        <Grid RowDefinitions="Auto,Auto,*">
          <!-- Search bar -->
          <TextBox Grid.Row="0"
                   Text="{Binding SearchFilter}"
                   Watermark="{localization:Localize Tools.ModBuilder.BundleEditor.WatermarkSearchFiles}"
                   VerticalContentAlignment="Center"
                   Margin="0,0,0,12">
            <TextBox.InnerLeftContent>
              <Path Data="{StaticResource IconSearch}"
                    Fill="{DynamicResource TextSecondary}"
                    Width="14" Height="14"
                    Stretch="Uniform"
                    Margin="10,0,6,0"/>
            </TextBox.InnerLeftContent>
          </TextBox>

          <!-- Toolbar -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Command="{Binding AddFilesCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" BorderThickness="0"
                    Padding="12,7" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipAddFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconAdd}"
                      Fill="White"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.ButtonAddFiles}" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>

            <Button Command="{Binding RemoveFilesCommand}"
                    IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12,7" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipRemoveFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconRemove}"
                      Fill="{DynamicResource TextSecondary}"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.ButtonRemove}"/>
              </StackPanel>
            </Button>

            <Separator Width="1" Height="20" Background="{DynamicResource BorderBrush}"/>

            <Button Command="{Binding MoveUpCommand}"
                    IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="8,7" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipMoveUp}">
              <Path Data="{StaticResource IconChevronUp}"
                    Fill="{DynamicResource TextPrimary}"
                    Width="13" Height="13"
                    Stretch="Uniform"/>
            </Button>

            <Button Command="{Binding MoveDownCommand}"
                    IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="8,7" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipMoveDown}">
              <Path Data="{StaticResource IconChevronDown}"
                    Fill="{DynamicResource TextPrimary}"
                    Width="13" Height="13"
                    Stretch="Uniform"/>
            </Button>

            <Separator Width="1" Height="20" Background="{DynamicResource BorderBrush}"/>

            <Button Command="{Binding ConvertAllToDdsCommand}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12,7" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipConvertAll}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconConverting}"
                      Fill="{DynamicResource AccentBrush}"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.ButtonConvertAll}"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- File list -->
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Files}"
                   SelectedItem="{Binding SelectedFile}"
                   Background="{DynamicResource SurfaceElevatedBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   CornerRadius="8">

            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:BundleFileInfo">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4">
                  <!-- File icon -->
                  <Border Grid.Column="0"
                          Width="32" Height="32"
                          Background="{DynamicResource AccentBadgeBackgroundBrush}"
                          BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                          CornerRadius="6"
                          Margin="0,0,10,0">
                    <Path Data="{Binding IconData}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                  </Border>

                  <!-- File info -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding FileName}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextSecondary}">
                      <Run Text="{Binding FileType}"/>
                      <Run Text="•"/>
                      <Run Text="{Binding FileSizeFormatted}"/>
                    </TextBlock>
                  </StackPanel>

                  <!-- Status badges -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0">
                    <Border Background="{DynamicResource SuccessBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            IsVisible="{Binding IsCached}">
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.TagCached}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>

                    <Border Background="{DynamicResource WarningBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            IsVisible="{Binding IsModified}">
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.TagModified}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                  </StackPanel>

                  <!-- Order number -->
                  <TextBlock Grid.Column="3"
                             Text="{Binding Order}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondary}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Preview panel -->
      <Border Grid.Column="1"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">

        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0"
                     Text="{localization:Localize Tools.ModBuilder.BundleEditor.FilePreviewHeader}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"
                     Margin="0,0,0,12"/>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12"
                        IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">

              <!-- File details -->
              <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.LabelFileName}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding SelectedFile.FileName}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.LabelSourcePath}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding SelectedFile.SourcePath}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.LabelFileType}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding SelectedFile.FileType}"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextPrimary}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.LabelFileSize}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding SelectedFile.FileSizeFormatted}"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextPrimary}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.LabelLastModified}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding SelectedFile.LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"/>
              </StackPanel>

              <!-- Image preview placeholder -->
              <Border Background="{DynamicResource SurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="8"
                      Height="180"
                      Margin="0,8,0,0">
                <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.ImagePreviewComingSoon}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer actions -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
      <TextBlock Grid.Column="0"
                 Text="{localization:Localize Tools.ModBuilder.BundleEditor.NoticeChangesSavedOnProjectSave}"
                 FontSize="11.5"
                 Foreground="{DynamicResource TextSecondary}"
                 VerticalAlignment="Center"
                 IsVisible="{Binding HasChanges}"/>

      <Button Grid.Column="1"
              Command="{Binding SaveCommand}"
              ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipSave}"
              Background="{DynamicResource AccentBrush}"
              Foreground="White" BorderThickness="0"
              Padding="18,8" CornerRadius="8"
              Margin="0,0,8,0"
              MinWidth="100" Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Path Data="{StaticResource IconSave}"
                Fill="White"
                Width="13" Height="13"
                Stretch="Uniform"/>
          <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.ButtonSave}" FontWeight="SemiBold"/>
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Command="{Binding CancelCommand}"
              ToolTip.Tip="{localization:Localize Tools.ModBuilder.BundleEditor.TooltipCancel}"
              Background="{DynamicResource SurfaceElevatedBrush}"
              Foreground="{DynamicResource TextPrimary}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Padding="18,8" CornerRadius="8"
              MinWidth="100" Cursor="Hand">
        <TextBlock Text="{localization:Localize Tools.ModBuilder.BundleEditor.ButtonCancel}" HorizontalAlignment="Center"/>
      </Button>
    </Grid>
  </Grid>
</Window>

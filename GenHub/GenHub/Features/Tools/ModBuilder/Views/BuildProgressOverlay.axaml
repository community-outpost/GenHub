<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ModBuilder.ViewModels"
             xmlns:controls="using:GenHub.Features.Tools.ModBuilder.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="GenHub.Features.Tools.ModBuilder.Views.BuildProgressOverlay"
             x:DataType="vm:BuildProgressViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/Tools/ModBuilder/Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="/Features/Tools/ModBuilder/Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Full-screen modal overlay -->
  <Panel>
    <!-- Semi-transparent backdrop -->
    <Border Background="{StaticResource OverlayBrush}"
            IsVisible="{Binding IsVisible}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Border.Transitions>
    </Border>

    <!-- Main content card -->
    <Border Background="{StaticResource BackgroundElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="{StaticResource BorderThicknessNormal}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            BoxShadow="{StaticResource ShadowXLarge}"
            MaxWidth="900"
            MaxHeight="700"
            Padding="{StaticResource PaddingXLarge}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsVisible}">

      <Border.Transitions>
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Border.Transitions>

      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource SpacingNormal}">
          <TextBlock Text="Building Project"
                     FontSize="{StaticResource FontSizeHeading2}"
                     FontWeight="{StaticResource FontWeightSemiBold}"
                     Foreground="{StaticResource TextPrimaryBrush}"/>

          <TextBlock Text="{Binding ProjectName}"
                     FontSize="{StaticResource FontSizeMedium}"
                     Foreground="{StaticResource TextSecondaryBrush}"/>

          <!-- Overall progress bar -->
          <ProgressBar Value="{Binding OverallProgress}"
                       Maximum="100"
                       Height="8"
                       CornerRadius="4"
                       Foreground="{StaticResource AccentGradientBrush}"
                       Background="{StaticResource SurfaceBrush}"/>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding CurrentStage}"
                       FontSize="{StaticResource FontSizeNormal}"
                       Foreground="{StaticResource AccentPrimaryBrush}"/>

            <TextBlock Grid.Column="1"
                       FontSize="{StaticResource FontSizeNormal}"
                       Foreground="{StaticResource TextSecondaryBrush}">
              <Run Text="{Binding OverallProgress, StringFormat='{}{0:F1}'}"/>
              <Run Text="%"/>
            </TextBlock>
          </Grid>
        </StackPanel>

        <!-- Stage cards -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,24,0,0"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Stages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource SpacingMedium}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:ProgressCard DataContext="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Metrics and actions -->
        <Grid Grid.Row="2"
              Margin="0,24,0,0"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*,*,*">

          <!-- Real-time metrics -->
          <StackPanel Grid.Row="0" Grid.Column="0"
                      Spacing="{StaticResource SpacingXSmall}">
            <TextBlock Text="Files/sec"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
            <TextBlock Text="{Binding FilesPerSecond, StringFormat='{}{0:F1}'}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
          </StackPanel>

          <StackPanel Grid.Row="0" Grid.Column="1"
                      Spacing="{StaticResource SpacingXSmall}">
            <TextBlock Text="Cache Hits"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
            <TextBlock FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       Foreground="{StaticResource SuccessBrush}">
              <Run Text="{Binding CacheHits}"/>
              <Run Text="/" FontSize="{StaticResource FontSizeNormal}"/>
              <Run Text="{Binding TotalFiles}" FontSize="{StaticResource FontSizeNormal}"/>
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Row="0" Grid.Column="2"
                      Spacing="{StaticResource SpacingXSmall}">
            <TextBlock Text="Elapsed"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
            <TextBlock Text="{Binding ElapsedTime}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
          </StackPanel>

          <StackPanel Grid.Row="0" Grid.Column="3"
                      Spacing="{StaticResource SpacingXSmall}">
            <TextBlock Text="ETA"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
            <TextBlock Text="{Binding EstimatedTimeRemaining}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       Foreground="{StaticResource InfoBrush}"/>
          </StackPanel>

          <!-- Cancel button -->
          <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding CancelCommand}"
                  Classes="Danger">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconStop}"
                    Fill="{Binding $parent[Button].Foreground}"
                    Width="16" Height="16"
                    Stretch="Uniform"/>
              <TextBlock Text="Cancel Build"/>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Panel>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GenHub.Features.Tools.ModBuilder.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="GenHub.Features.Tools.ModBuilder.Views.ConfigEditorDialog"
        x:DataType="vm:ConfigEditorViewModel"
        Title="Configuration Editor"
        Icon="/Assets/Icons/generalshub-icon.png"
        Width="1200" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WindowBackground}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16"
          Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.Title}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.Subtitle}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.TotalItems}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding BundleItems.Count}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Right"/>
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Right">
          <Run Text="{Binding BundlePacks.Count}"/>
          <Run Text="{localization:Localize Tools.ModBuilder.ConfigEditor.PacksUnit}"/>
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- Main content with tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex}">
      <!-- Bundle Items Tab -->
      <TabItem Header="{localization:Localize Tools.ModBuilder.ConfigEditor.TabBundleItems}">
        <Grid ColumnDefinitions="380,12,*" Margin="0,12,0,0">
          <!-- Left: List & Actions -->
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <Button Command="{Binding AddBundleItemCommand}"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="White" BorderThickness="0"
                      Padding="14,8" CornerRadius="8" Cursor="Hand"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipAddItem}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconAdd}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                  <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.ButtonAddItem}" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>

              <Button Command="{Binding RemoveBundleItemCommand}"
                      IsEnabled="{Binding SelectedBundleItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      Padding="14,8" CornerRadius="8" Cursor="Hand"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipRemoveItem}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconRemove}" Fill="{DynamicResource TextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                  <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.ButtonRemoveItem}"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Items ListBox -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="8">
              <ListBox ItemsSource="{Binding BundleItems}"
                       SelectedItem="{Binding SelectedBundleItem}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BundleItemEditorViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding SourcePattern}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource AccentBadgeBackgroundBrush}"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                              CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                              IsVisible="{Binding IsBig}">
                        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.TagBig}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>

          <!-- Right: Detail Editor Inspector -->
          <Border Grid.Column="2" Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Panel>
                <!-- Selected State -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedBundleItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.BundleItemSettingsHeader}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                  <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                  <!-- Item Name -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelBundleName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding SelectedBundleItem.Name, Mode=TwoWay}" Watermark="{localization:Localize Tools.ModBuilder.ConfigEditor.WatermarkBundleName}" />
                  </StackPanel>

                  <!-- Source Pattern -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelSourceFiles}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.DescSourceFiles}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox Text="{Binding SelectedBundleItem.SourcePattern, Mode=TwoWay}" Watermark="{localization:Localize Tools.ModBuilder.ConfigEditor.WatermarkSourceFiles}" />

                    <!-- Quick Presets -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.QuickPresetsLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                      <Button Command="{Binding SetSourcePatternCommand}" CommandParameter="GameFilesEdited/**/*.*"
                              Padding="8,4" FontSize="11" CornerRadius="6"
                              Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Content="{localization:Localize Tools.ModBuilder.ConfigEditor.PresetAllFiles}" Cursor="Hand"
                              ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipPresetAllFiles}"/>
                      <Button Command="{Binding SetSourcePatternCommand}" CommandParameter="GameFilesEdited/Data/INI/**/*.ini"
                              Padding="8,4" FontSize="11" CornerRadius="6"
                              Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Content="{localization:Localize Tools.ModBuilder.ConfigEditor.PresetIniFiles}" Cursor="Hand"
                              ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipPresetIniFiles}"/>
                      <Button Command="{Binding SetSourcePatternCommand}" CommandParameter="GameFilesEdited/Art/Textures/**/*.tga"
                              Padding="8,4" FontSize="11" CornerRadius="6"
                              Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Content="{localization:Localize Tools.ModBuilder.ConfigEditor.PresetTextures}" Cursor="Hand"
                              ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipPresetTextures}"/>
                      <Button Command="{Binding SetSourcePatternCommand}" CommandParameter="GameFilesEdited/Data/Audio/**/*.*"
                              Padding="8,4" FontSize="11" CornerRadius="6"
                              Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Content="{localization:Localize Tools.ModBuilder.ConfigEditor.PresetAudio}" Cursor="Hand"
                              ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipPresetAudio}"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- BIG Archive Settings -->
                  <Border Background="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                      <CheckBox Content="{localization:Localize Tools.ModBuilder.ConfigEditor.CheckPackAsBig}" IsChecked="{Binding SelectedBundleItem.IsBig, Mode=TwoWay}"
                                FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipPackAsBig}"/>
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.DescPackAsBig}"
                                 FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                      <StackPanel Spacing="6" IsVisible="{Binding SelectedBundleItem.IsBig}">
                        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelArchiveSuffix}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Text="{Binding SelectedBundleItem.BigSuffix, Mode=TwoWay}" Watermark="{localization:Localize Tools.ModBuilder.ConfigEditor.WatermarkArchiveSuffix}"
                                 ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipArchiveSuffix}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Empty State -->
                <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.SelectBundleItemPrompt}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding SelectedBundleItem, Converter={x:Static ObjectConverters.IsNull}}"/>
              </Panel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- Bundle Packs Tab -->
      <TabItem Header="{localization:Localize Tools.ModBuilder.ConfigEditor.TabBundlePacks}">
        <Grid ColumnDefinitions="380,12,*" Margin="0,12,0,0">
          <!-- Left: Packs List & Actions -->
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <Button Command="{Binding AddBundlePackCommand}"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="White" BorderThickness="0"
                      Padding="14,8" CornerRadius="8" Cursor="Hand"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipAddPack}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconAdd}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                  <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.ButtonAddPack}" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>

              <Button Command="{Binding RemoveBundlePackCommand}"
                      IsEnabled="{Binding SelectedBundlePack, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      Padding="14,8" CornerRadius="8" Cursor="Hand"
                      ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipRemovePack}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconRemove}" Fill="{DynamicResource TextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                  <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.ButtonRemovePack}"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Packs ListBox -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="8">
              <ListBox ItemsSource="{Binding BundlePacks}"
                       SelectedItem="{Binding SelectedBundlePack}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BundlePackConfigViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding ItemNames.Count, StringFormat='{}{0} item(s) included'}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="{DynamicResource WarningBadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="5,2" IsVisible="{Binding Big}">
                          <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.TagPackBig}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SuccessBadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="5,2" IsVisible="{Binding AllowBuild}">
                          <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.TagPackBuild}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource AccentBadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="5,2" IsVisible="{Binding AllowInstall}">
                          <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.TagPackInstall}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>

          <!-- Right: Pack Detail Inspector -->
          <Border Grid.Column="2" Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Panel>
                <!-- Selected State -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedBundlePack, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.BundlePackSettingsHeader}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                  <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                  <!-- Pack Name -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelPackName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding SelectedBundlePack.Name, Mode=TwoWay}" Watermark="{localization:Localize Tools.ModBuilder.ConfigEditor.WatermarkPackName}" />
                  </StackPanel>

                  <!-- Included Bundle Items (Checklist) -->
                  <StackPanel Spacing="8">
                    <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelIncludedItems}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.DescIncludedItems}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12" MinHeight="100">
                      <ItemsControl ItemsSource="{Binding PackItemSelections}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BundleItemSelectionItemViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4">
                              <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>

                  <!-- Format & Packaging Options -->
                  <Border Background="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelPackagingFormat}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                      <CheckBox Content="{localization:Localize Tools.ModBuilder.ConfigEditor.CheckPackIntoOneBig}"
                                IsChecked="{Binding SelectedBundlePack.Big, Mode=TwoWay}"
                                Foreground="{DynamicResource TextPrimary}"
                                ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipPackIntoOneBig}"/>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelCustomOutputFile}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Text="{Binding SelectedBundlePack.OutputFile, Mode=TwoWay}" Watermark="{localization:Localize Tools.ModBuilder.ConfigEditor.WatermarkCustomOutputFile}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Build & Deployment Options -->
                  <Border Background="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.LabelActionsTargets}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                      <CheckBox Content="{localization:Localize Tools.ModBuilder.ConfigEditor.CheckAllowBuild}"
                                IsChecked="{Binding SelectedBundlePack.AllowBuild, Mode=TwoWay}"
                                Foreground="{DynamicResource TextPrimary}"
                                ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipAllowBuild}"/>
                      <CheckBox Content="{localization:Localize Tools.ModBuilder.ConfigEditor.CheckAllowInstall}"
                                IsChecked="{Binding SelectedBundlePack.AllowInstall, Mode=TwoWay}"
                                Foreground="{DynamicResource TextPrimary}"
                                ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipAllowInstall}"/>
                      <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.NoticeGenHubWorkspaces}"
                                 FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Empty State -->
                <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.SelectBundlePackPrompt}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding SelectedBundlePack, Converter={x:Static ObjectConverters.IsNull}}"/>
              </Panel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Footer actions -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="{DynamicResource WarningBadgeBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="8,3"
                IsVisible="{Binding HasChanges}">
          <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.UnsavedChangesBadge}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource WarningBrush}"/>
        </Border>

        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.NoticeUnsavedChanges}"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasChanges}"/>
      </StackPanel>

      <Button Grid.Column="1"
              Command="{Binding SaveCommand}"
              ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipSave}"
              Background="{DynamicResource AccentBrush}"
              Foreground="White" BorderThickness="0"
              Padding="18,8" CornerRadius="8"
              Margin="0,0,8,0"
              MinWidth="100" Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Path Data="{StaticResource IconSave}"
                Fill="White"
                Width="13" Height="13"
                Stretch="Uniform"/>
          <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.ButtonSave}" FontWeight="SemiBold"/>
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Command="{Binding CancelCommand}"
              ToolTip.Tip="{localization:Localize Tools.ModBuilder.ConfigEditor.TooltipClose}"
              Background="{DynamicResource SurfaceElevatedBrush}"
              Foreground="{DynamicResource TextPrimary}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Padding="18,8" CornerRadius="8"
              MinWidth="100" Cursor="Hand">
        <TextBlock Text="{localization:Localize Tools.ModBuilder.ConfigEditor.ButtonClose}" HorizontalAlignment="Center"/>
      </Button>
    </Grid>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GenHub.Features.Tools.ModBuilder.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="GenHub.Features.Tools.ModBuilder.Views.ConfigEditorDialog"
        x:DataType="vm:ConfigEditorViewModel"
        Title="Configuration Editor"
        Icon="/Assets/Icons/generalshub-icon.png"
        Width="1200" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WindowBackground}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/ModBuilderStyles.axaml"/>
        <ResourceInclude Source="../Styles/ModBuilderIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16"
          Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Configuration Editor"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <TextBlock Text="Manage bundle items and packs for your mod"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Total Items"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding BundleItems.Count}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Right"/>
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Right">
          <Run Text="{Binding BundlePacks.Count}"/>
          <Run Text="packs"/>
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- Main content with tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex}">
      <!-- Bundle Items Tab -->
      <TabItem Header="Bundle Items">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <!-- Toolbar -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Command="{Binding AddBundleItemCommand}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" BorderThickness="0"
                    Padding="14,8" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="Add a new bundle item">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconAdd}"
                      Fill="White"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="Add Item" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>

            <Button Command="{Binding RemoveBundleItemCommand}"
                    IsEnabled="{Binding SelectedBundleItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="14,8" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="Remove selected bundle item">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconRemove}"
                      Fill="{DynamicResource TextSecondary}"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="Remove"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Bundle Items List -->
          <Border Grid.Row="1"
                  Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12">

            <DataGrid ItemsSource="{Binding BundleItems}"
                      SelectedItem="{Binding SelectedBundleItem}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0">

              <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    MinWidth="150"/>

                <DataGridTextColumn Header="Display Name"
                                    Binding="{Binding DisplayName}"
                                    Width="*"
                                    MinWidth="200"/>

                <DataGridTextColumn Header="Files"
                                    Binding="{Binding FileCount}"
                                    Width="Auto"
                                    MinWidth="80"/>

                <DataGridCheckBoxColumn Header="Is .big"
                                        Binding="{Binding IsBig}"
                                        Width="Auto"
                                        MinWidth="80"/>

                <DataGridTextColumn Header="Language"
                                    Binding="{Binding SetGameLanguageOnInstall}"
                                    Width="Auto"
                                    MinWidth="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Bundle Packs Tab -->
      <TabItem Header="Bundle Packs">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <!-- Toolbar -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Command="{Binding AddBundlePackCommand}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" BorderThickness="0"
                    Padding="14,8" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="Add a new bundle pack">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconAdd}"
                      Fill="White"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="Add Pack" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>

            <Button Command="{Binding RemoveBundlePackCommand}"
                    IsEnabled="{Binding SelectedBundlePack, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="14,8" CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="Remove selected bundle pack">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconRemove}"
                      Fill="{DynamicResource TextSecondary}"
                      Width="13" Height="13"
                      Stretch="Uniform"/>
                <TextBlock Text="Remove"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Bundle Packs List -->
          <Border Grid.Row="1"
                  Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12">

            <DataGrid ItemsSource="{Binding BundlePacks}"
                      SelectedItem="{Binding SelectedBundlePack}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0">

              <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    MinWidth="150"/>

                <DataGridTextColumn Header="Display Name"
                                    Binding="{Binding DisplayName}"
                                    Width="*"
                                    MinWidth="200"/>

                <DataGridTextColumn Header="Items"
                                    Binding="{Binding ItemNames.Count}"
                                    Width="Auto"
                                    MinWidth="80"/>

                <DataGridCheckBoxColumn Header="Allow Build"
                                        Binding="{Binding AllowBuild}"
                                        Width="Auto"
                                        MinWidth="100"/>

                <DataGridCheckBoxColumn Header="Allow Install"
                                        Binding="{Binding AllowInstall}"
                                        Width="Auto"
                                        MinWidth="100"/>

                <DataGridTextColumn Header="Language"
                                    Binding="{Binding SetGameLanguageOnInstall}"
                                    Width="Auto"
                                    MinWidth="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Footer actions -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="#1AFFD740"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="8,3"
                IsVisible="{Binding HasChanges}">
          <TextBlock Text="Unsaved Changes"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource WarningBrush}"/>
        </Border>

        <TextBlock Text="Changes will be saved to configuration files"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasChanges}"/>
      </StackPanel>

      <Button Grid.Column="1"
              Command="{Binding SaveCommand}"
              Background="{DynamicResource AccentBrush}"
              Foreground="White" BorderThickness="0"
              Padding="18,8" CornerRadius="8"
              Margin="0,0,8,0"
              MinWidth="100" Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Path Data="{StaticResource IconSave}"
                Fill="White"
                Width="13" Height="13"
                Stretch="Uniform"/>
          <TextBlock Text="Save" FontWeight="SemiBold"/>
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Command="{Binding CancelCommand}"
              Background="{DynamicResource SurfaceElevatedBrush}"
              Foreground="{DynamicResource TextPrimary}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Padding="18,8" CornerRadius="8"
              MinWidth="100" Cursor="Hand">
        <TextBlock Text="Close" HorizontalAlignment="Center"/>
      </Button>
    </Grid>
  </Grid>
</Window>

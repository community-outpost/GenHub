<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GenHub.Features.Tools.ReplayManager.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="820" d:DesignHeight="640"
        x:Class="GenHub.Features.Tools.ReplayManager.Views.GameClientSelectionView"
        x:DataType="vm:GameClientSelectionViewModel"
        Title="Select Game Client"
        Width="820" Height="640"
        MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource SurfaceBackgroundBrush}">

    <Grid RowDefinitions="40,*">
        <!-- Custom Title Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              Background="{DynamicResource SurfaceBackgroundBrush}"
              x:Name="TitleBarGrid"
              PointerPressed="OnTitleBarPointerPressed">

            <!-- App icon and title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="avares://GenHub/Assets/Icons/generalshub-icon.png"
                       Width="22" Height="22" />
                <TextBlock Text="Select Game Client"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <!-- Minimize Button -->
            <Button Grid.Column="2"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Padding="0"
                    Width="46" Height="40"
                    Click="MinimizeButton_Click">
                <Path Data="M4,11H20V13H4Z"
                      Fill="{Binding $parent[Button].Foreground}"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,0" />
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </Button.Styles>
            </Button>

            <!-- Maximize/Restore Button -->
            <Button Grid.Column="3"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Padding="0"
                    Width="46" Height="40"
                    Click="MaximizeButton_Click">
                <Path x:Name="MaximizeIcon"
                      Data="M4,4H20V20H4V4M6,8V18H18V8H6Z"
                      Fill="{Binding $parent[Button].Foreground}"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </Button.Styles>
            </Button>

            <!-- Close Button -->
            <Button Grid.Column="4"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Padding="0"
                    Width="46" Height="40"
                    Click="CloseButton_Click">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Fill="{Binding $parent[Button].Foreground}"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
            <!-- Header Context -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Select Compatible Game Client" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding ReplayFileName}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding ReplayFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding HasCrcInfo}">
                            <Border CornerRadius="4" Background="{DynamicResource SurfaceElevatedBrush}" Padding="8,3">
                                <TextBlock Text="{Binding ReplayExeCrc, StringFormat='EXE CRC: {0}'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Border CornerRadius="4" Background="{DynamicResource SurfaceElevatedBrush}" Padding="8,3">
                                <TextBlock Text="{Binding ReplayIniCrc, StringFormat='INI CRC: {0}'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Toggle Filter on Right -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !IsLoading}">
                        <Button Command="{Binding ToggleShowAllCommand}"
                                Padding="12,6"
                                CornerRadius="6"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ShowAllClients, Converter={x:Static ObjectConverters.IsNull}}" IsVisible="False" />
                                <TextBlock Text="Show All Clients" IsVisible="{Binding !ShowAllClients}" FontSize="11" FontWeight="Medium" />
                                <TextBlock Text="Show CRC Compatible Only" IsVisible="{Binding ShowAllClients}" FontSize="11" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding CompatibleCount, StringFormat='{}{0} compatible client(s) found'}"
                                   FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                                   IsVisible="{Binding HasCompatibleCrcClients}" />
                        <TextBlock Text="0 compatible clients found"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"
                                   IsVisible="{Binding !HasCompatibleCrcClients}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search Filter Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,12">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Filter game clients by name, publisher, or version..."
                         FontSize="13"
                         Padding="10,8"
                         CornerRadius="6" />
            </Border>

            <!-- Clients List / Loading Area -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,16,36,24" Spacing="12">
                    <!-- Loading Indicator -->
                    <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" Margin="0,64" Spacing="10">
                        <ProgressBar IsIndeterminate="True" Width="220" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Discovering compatible game clients&#x2026;" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel IsVisible="{Binding !IsLoading}" Spacing="10">
                        <Border IsVisible="{Binding !FilteredClients.Count}"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24,32">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="No compatible game clients found" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ReplayExeCrc, StringFormat='No game client matches the replay executable CRC ({0}).'}"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"
                                           IsVisible="{Binding HasCrcInfo}" />
                                <TextBlock Text="No game clients match the current filter criteria."
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"
                                           IsVisible="{Binding !HasCrcInfo}" />
                                <Button Command="{Binding ToggleShowAllCommand}"
                                        Content="Show All Game Clients Anyway"
                                        HorizontalAlignment="Center"
                                        Padding="14,6"
                                        CornerRadius="6"
                                        IsVisible="{Binding !ShowAllClients}" />
                            </StackPanel>
                        </Border>

                        <!-- Client Cards -->
                        <ItemsControl ItemsSource="{Binding FilteredClients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GameClientCardViewModel">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,14"
                                            Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                            <!-- Top Row: Name and Category Badge -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,4">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <Border CornerRadius="10" Background="{DynamicResource SurfaceElevatedBrush}" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding IsCrcMatch}">
                                                    <TextBlock Text="CRC Compatible" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <Border CornerRadius="10" Background="{DynamicResource SurfaceElevatedBrush}" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding !IsCrcMatch}">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Middle Row: Publisher, Version -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="16" Margin="0,0,16,4">
                                                <TextBlock Text="{Binding Publisher, StringFormat='Publisher: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>

                                            <!-- Bottom Row: Description -->
                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="{Binding Description}"
                                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,16,0" />

                                            <!-- Action Button -->
                                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                                    Classes="Primary"
                                                    Command="{Binding SelectCommand}"
                                                    VerticalAlignment="Center"
                                                    Padding="16,9"
                                                    CornerRadius="6">
                                                <TextBlock Text="Select &amp; Create Profile" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

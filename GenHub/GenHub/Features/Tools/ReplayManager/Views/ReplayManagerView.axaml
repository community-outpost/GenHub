<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ReplayManager.ViewModels"
             xmlns:vm_tools="using:GenHub.Features.Tools.ViewModels"
             xmlns:models="using:GenHub.Core.Models.Tools.ReplayManager"
             xmlns:enums="using:GenHub.Core.Models.Enums"
             xmlns:converters="using:GenHub.Infrastructure.Converters"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GenHub.Features.Tools.ReplayManager.Views.ReplayManagerView"
             x:DataType="vm:ReplayManagerViewModel"
             x:Name="Root"
             DragDrop.AllowDrop="True">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GenHub/Features/Tools/Views/ToolIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:EqualityConverter x:Key="EqualityConverter" />
      <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto" MinWidth="600"
        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <!-- Header/Tabs & Toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="0,0,0,16" Padding="6" BoxShadow="{DynamicResource CardBoxShadow}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Game Tabs -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <RadioButton Content="{localization:Localize Common.Game.Generals}"
                       IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:GameType.Generals}}"
                       GroupName="GameTabs"
                       Classes="TabButton"/>
          <RadioButton Content="{localization:Localize Common.Game.ZeroHour}"
                       IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:GameType.ZeroHour}}"
                       GroupName="GameTabs"
                       Classes="TabButton"/>
        </StackPanel>

        <!-- Import Bar Integrated -->
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="16,0">
          <TextBox Grid.Column="0" Watermark="{localization:Localize Tools.ReplayManager.Watermark.ImportUrl}"
                   Text="{Binding ImportUrl}" Margin="0,0,8,0" VerticalContentAlignment="Center"
                   HorizontalAlignment="Stretch"
                   ToolTip.Tip="{localization:Localize Replays.Tooltip.ImportUrlFormats}"/>
          <Button Grid.Column="1" Command="{Binding ImportFromUrlCommand}"
                  Classes="Primary" Margin="0,0,4,0" IsEnabled="{Binding !IsBusy}"
                  Padding="10,6"
                  ToolTip.Tip="{localization:Localize Replays.Tooltip.ImportFromUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.TrayArrowDown}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Tools.ReplayManager.Button.Import}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding BrowseAndImportCommand}"
                  Classes="Secondary" IsEnabled="{Binding !IsBusy}"
                  Padding="10,6"
                  ToolTip.Tip="{localization:Localize Replays.Tooltip.BrowseFiles}">
            <PathIcon Data="{StaticResource ToolIcon.Paperclip}" Width="16" Height="16"/>
          </Button>
        </Grid>

        <!-- Search Bar -->
        <TextBox Grid.Column="2" Watermark="{localization:Localize Tools.ReplayManager.Watermark.SearchReplays}"
                 Text="{Binding SearchText}"
                 Width="170"
                 VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource ToolIcon.Magnify}" Width="16" Height="16"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
          </TextBox.InnerLeftContent>
        </TextBox>

        <!-- Utilities -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Command="{Binding LoadReplaysCommand}" Classes="Secondary" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{localization:Localize Replays.Tooltip.RefreshList}" Padding="8">
            <PathIcon Data="{StaticResource ToolIcon.Refresh}" Width="16" Height="16"/>
          </Button>
          <Button Command="{Binding OpenFolderCommand}" Classes="Secondary" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{localization:Localize Replays.Tooltip.OpenFolder}" Padding="8">
            <PathIcon Data="{StaticResource ToolIcon.FolderOpenOutline}" Width="16" Height="16"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Replay List & Overlays -->
    <Panel Grid.Row="1">
      <Border Background="{DynamicResource CardBackground}" CornerRadius="12" ClipToBounds="True" BoxShadow="{DynamicResource CardBoxShadow}">
        <DataGrid Name="ReplaysGrid"
                  ItemsSource="{Binding CurrentReplays}"
                  SelectionMode="Extended"
                  CellEditEnded="OnCellEditEnded"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  RowHeight="42">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{localization:Localize Tools.ReplayManager.Column.Filename}" Width="180" MaxWidth="210">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding FileName}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding FileName}"
                             Margin="8,0,4,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding FileName}"
                           VerticalAlignment="Center"
                           Margin="4,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{localization:Localize Tools.ReplayManager.Column.Map}" Width="120" MaxWidth="160">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Metadata.MapName}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Metadata.MapName}"
                             Margin="4,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{localization:Localize Tools.ReplayManager.Column.ClientBuild}" Width="*" MinWidth="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ClientAndPatchDisplay, Converter={x:Static converters:LocalizedReplayBuildConverter.Instance}}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ClientAndPatchDisplay, Converter={x:Static converters:LocalizedReplayBuildConverter.Instance}}"
                             Margin="4,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{localization:Localize Tools.ReplayManager.Column.ExeCrc}" Binding="{Binding Metadata.FormattedExeCrc}" Width="Auto" MinWidth="85" IsReadOnly="True" />
            <DataGridTextColumn Header="{localization:Localize Tools.ReplayManager.Column.IniCrc}" Binding="{Binding Metadata.FormattedIniCrc}" Width="Auto" MinWidth="85" IsReadOnly="True" />
            <DataGridTemplateColumn Header="{localization:Localize Tools.ReplayManager.Column.Compatibility}" Width="Auto" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0"
                          ToolTip.Tip="{Binding Converter={x:Static converters:LocalizedReplayTooltipConverter.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"
                                 IsVisible="{Binding CompatibilityStatus, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static enums:ReplayCompatibilityStatus.Compatible}}"/>
                      <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                 IsVisible="{Binding CompatibilityStatus, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static enums:ReplayCompatibilityStatus.RequiresProfile}}"/>
                      <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"
                                 IsVisible="{Binding CompatibilityStatus, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static enums:ReplayCompatibilityStatus.Downloadable}}"/>
                      <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"
                                 IsVisible="{Binding CompatibilityStatus, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static enums:ReplayCompatibilityStatus.Orphaned}}"/>
                      <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding CompatibilityStatus, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static enums:ReplayCompatibilityStatus.Unknown}}"/>
                      <TextBlock Text="{Binding CompatibilityBadgeText, Converter={x:Static converters:LocalizedReplayBadgeConverter.Instance}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{localization:Localize Tools.ReplayManager.Column.Size}" Binding="{Binding FormattedSize}" Width="Auto" MinWidth="65" IsReadOnly="True" />
            <DataGridTextColumn Header="{localization:Localize Tools.ReplayManager.Column.Modified}" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="Auto" MinWidth="115" IsReadOnly="True" />
            <DataGridTemplateColumn Width="Auto" MinWidth="165" CanUserResize="False" Header="{localization:Localize Tools.ReplayManager.Column.Actions}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Launch Button: Visible ONLY when CanPlay (profile is configured and ready) -->
                    <Button Classes="Primary" Padding="8,4"
                            Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).LaunchReplayCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !$parent[UserControl].((vm:ReplayManagerViewModel)DataContext).IsBusy}"
                            IsVisible="{Binding CanPlay}"
                            ToolTip.Tip="{Binding Converter={x:Static converters:LocalizedReplayTooltipConverter.Instance}, ConverterParameter='Play'}">
                      <Button.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="{localization:Localize Tools.ReplayManager.Action.SelectProfile}"
                                    Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).SelectProfileAndLaunchReplayCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="{localization:Localize Tools.ReplayManager.Action.SelectClient}"
                                    Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).SelectClientAndCreateProfileCommand}"
                                    CommandParameter="{Binding}" />
                        </MenuFlyout>
                      </Button.ContextFlyout>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource ToolIcon.Play}" Width="11" Height="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize Tools.ReplayManager.Action.Launch}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <!-- Checkpoint Recovery Button (When client supports checkpoints) -->
                    <Button Classes="Secondary" Padding="8,4"
                            Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).OpenCheckpointDrawerCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding SupportsCheckpoints}"
                            ToolTip.Tip="{Binding Converter={x:Static converters:LocalizedReplayTooltipConverter.Instance}, ConverterParameter='Takeover'}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource ToolIcon.Restore}" Width="11" Height="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize Tools.ReplayManager.Action.Recovery}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <!-- Setup Button: Primary action when client/patch download is required (Launch is hidden) -->
                    <Button Classes="Primary" Padding="8,4"
                            Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).ExecuteDirectProfileCreationCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !$parent[UserControl].((vm:ReplayManagerViewModel)DataContext).IsBusy}"
                            IsVisible="{Binding IsDownloadRequired}"
                            ToolTip.Tip="{localization:Localize Tools.ReplayManager.Tooltip.DownloadAndSetup}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource ToolIcon.Download}" Width="11" Height="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize Tools.ReplayManager.Action.Setup}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <!-- Profile Button: Primary when a profile is needed/missing, or secondary when replay can already launch -->
                    <Button Classes="Secondary" Padding="8,4"
                            Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).SelectClientAndCreateProfileCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !$parent[UserControl].((vm:ReplayManagerViewModel)DataContext).IsBusy}"
                            IsVisible="{Binding !IsDownloadRequired}"
                            ToolTip.Tip="{localization:Localize Tools.ReplayManager.Tooltip.ViewClientsAndCreate}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource ToolIcon.Plus}" Width="11" Height="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize Tools.ReplayManager.Action.Profile}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Empty State -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                  IsVisible="{Binding !CurrentReplays.Count}"
                  IsHitTestVisible="False">
        <PathIcon Data="{StaticResource ToolIcon.MoviePlayOutline}" Width="52" Height="52" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
        <TextBlock Text="{localization:Localize Tools.ReplayManager.Empty.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
        <TextBlock Text="{localization:Localize Tools.ReplayManager.Empty.Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Drag & Drop Overlay -->
      <Border Name="DragDropOverlay"
              Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="2"
              IsVisible="False"
              IsHitTestVisible="False"
              CornerRadius="12"
              Opacity="0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
          </Transitions>
        </Border.Transitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
          <PathIcon Data="{StaticResource ToolIcon.TrayArrowDown}" Width="64" Height="64" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="{localization:Localize Tools.ReplayManager.DragDrop.Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
          <TextBlock Text="{localization:Localize Tools.ReplayManager.DragDrop.Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Loading Overlay -->
      <Border Background="{DynamicResource OverlayScrimBrush}" IsVisible="{Binding IsBusy}" CornerRadius="12">
        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="24,20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                BoxShadow="{DynamicResource DialogBoxShadow}" MinWidth="300" MaxWidth="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontWeight="SemiBold"
                       FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
            <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100"
                         Height="6" CornerRadius="3"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource SurfaceHoverBrush}" />
            <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}"
                       HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       IsVisible="{Binding !IsIndeterminate}"/>
          </StackPanel>
        </Border>
      </Border>
    </Panel>

    <!-- Action Bar -->
    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="0,16,0,0" Padding="12" BoxShadow="{DynamicResource CardBoxShadow}">
      <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="400">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{localization:Localize Tools.ReplayManager.Label.Selected}" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedReplays.Count}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          </StackPanel>
          <Button Command="{Binding DeleteSelectedCommand}"
                  Classes="Danger ActionBarBtn" IsEnabled="{Binding SelectedReplays.Count}"
                  ToolTip.Tip="{localization:Localize Replays.Tooltip.DeleteSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Common.Button.Delete}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="12,0"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding UncompressSelectedCommand}"
                  Classes="Secondary ActionBarBtn" IsEnabled="{Binding HasSelectedZips}"
                  ToolTip.Tip="{localization:Localize Replays.Tooltip.UncompressSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.PackageVariantClosed}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Tools.ReplayManager.Button.Uncompress}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBox MinWidth="110" MaxWidth="160" Watermark="{localization:Localize Tools.ReplayManager.Watermark.ZipName}" Text="{Binding ZipName}" Height="32" VerticalAlignment="Center" ToolTip.Tip="{localization:Localize Replays.Tooltip.ZipName}"/>
          <Button Command="{Binding ExportToZipCommand}"
                  Classes="Secondary ActionBarBtn" IsEnabled="{Binding SelectedReplays.Count}"
                  ToolTip.Tip="{localization:Localize Replays.Tooltip.ZipSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource ToolIcon.ArchiveOutline}" Width="16" Height="16"/>
              <TextBlock Text="{localization:Localize Tools.ReplayManager.Button.Zip}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Command="{Binding UploadAndShareCommand}"
                    Classes="Primary SplitLeft ActionBarBtn"
                    ToolTip.Tip="{localization:Localize Replays.Tooltip.UploadAndShare}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.CloudUploadOutline}" Width="16" Height="16"/>
                <TextBlock Text="{localization:Localize Tools.ReplayManager.Button.Upload}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <ToggleButton
                    IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                    Classes="Primary SplitRight ActionBarBtn"
                    ToolTip.Tip="{localization:Localize Tools.ReplayManager.Tooltip.UploadHistory}">
              <PathIcon Data="{StaticResource ToolIcon.ChevronRight}" Width="14" Height="14" VerticalAlignment="Center"/>
            </ToggleButton>
            <Popup IsOpen="{Binding IsHistoryOpen}"
                   Placement="Bottom" PlacementTarget="{Binding $parent[StackPanel]}"
                   IsLightDismissEnabled="False">
              <Border Background="{DynamicResource DetailsBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                      Padding="14" MinWidth="340" MaxHeight="400" BoxShadow="{DynamicResource FlyoutBoxShadow}">
                <Grid RowDefinitions="Auto,*">
                  <Grid Grid.Row="1">
                    <ScrollViewer IsVisible="{Binding UploadHistory.Count}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding UploadHistory}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm_tools:UploadHistoryItemViewModel">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <Border Background="Transparent" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="4,0,0,0">
                                      <Panel>
                                        <TextBlock Text="{localization:Localize Replays.Label.Active}" FontSize="10" Foreground="{Binding StatusColor}"
                                                   IsVisible="{Binding IsActive}"/>
                                        <TextBlock Text="{localization:Localize Replays.Label.Expired}" FontSize="10" Foreground="{Binding StatusColor}"
                                                   IsVisible="{Binding !IsActive}"/>
                                      </Panel>
                                    </Border>
                                  </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Classes="Secondary"
                                        Command="{Binding #Root.((vm:ReplayManagerViewModel)DataContext).CopyUrlCommand}"
                                        CommandParameter="{Binding Url}"
                                        Padding="6,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Localize Replays.Tooltip.CopyLink}">
                                  <PathIcon Data="{StaticResource ToolIcon.ContentCopy}" Width="14" Height="14"/>
                                </Button>

                                <Button Grid.Column="2" Classes="Secondary"
                                        Command="{Binding #Root.((vm:ReplayManagerViewModel)DataContext).CopyGenHubLinkCommand}"
                                        CommandParameter="{Binding Url}"
                                        Padding="6,4" Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Localize Replays.Tooltip.CopyGenHubLink}">
                                  <PathIcon Data="{StaticResource ToolIcon.ShareOutline}" Width="14" Height="14"/>
                                </Button>

                                <Button Grid.Column="3" Classes="Danger"
                                        Command="{Binding #Root.((vm:ReplayManagerViewModel)DataContext).RemoveHistoryItemCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,4" Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Localize Replays.Tooltip.DeleteHistoryItem}">
                                  <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="14" Height="14"/>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{localization:Localize Replays.Empty.NoHistory}" IsVisible="{Binding !UploadHistory.Count}"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,20"/>
                  </Grid>

                  <!-- Clear All Button -->
                  <Button Command="{Binding ClearHistoryCommand}"
                          Classes="Danger"
                          HorizontalAlignment="Stretch"
                          Margin="0,10,0,0"
                          IsVisible="{Binding UploadHistory.Count}"
                          ToolTip.Tip="{localization:Localize Replays.Tooltip.ClearHistory}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource ToolIcon.DeleteSweepOutline}" Width="16" Height="16"/>
                      <TextBlock Text="{localization:Localize Replays.Button.ClearAllHistory}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Popup>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>


    <!-- Checkpoint Recovery Modal Dialog Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="{DynamicResource OverlayScrimBrush}"
            IsVisible="{Binding IsCheckpointDrawerOpen}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            KeyboardNavigation.TabNavigation="Cycle"
            ZIndex="100">
      <Border.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCheckpointDrawerCommand}" />
      </Border.KeyBindings>
      <Border Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="24"
              BoxShadow="{DynamicResource DialogBoxShadow}"
              Width="580"
              MaxHeight="680"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <!-- Header -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{localization:Localize Tools.ReplayManager.Checkpoint.Title}"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="{Binding ActiveCheckpointReplay.FileName}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="icon-subtle"
                    Command="{Binding CloseCheckpointDrawerCommand}"
                    Padding="6"
                    VerticalAlignment="Top">
              <PathIcon Data="{StaticResource ToolIcon.Close}" Width="16" Height="16"/>
            </Button>
          </Grid>

          <!-- Compatible Profile Selector -->
          <Border Grid.Row="1" Margin="0,0,0,16"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="14,10">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{localization:Localize Tools.ReplayManager.Checkpoint.TargetProfile}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondary}"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"/>
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding CompatibleProfiles}"
                        SelectedItem="{Binding SelectedCompatibleProfile}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Text="{localization:Localize Tools.ReplayManager.Checkpoint.TargetProfileSubtitle}"
                         FontSize="11"
                         Foreground="{DynamicResource TextMuted}"
                         Margin="0,4,0,0"/>
            </Grid>
          </Border>

          <!-- Section: Create Checkpoint Save -->
          <Border Grid.Row="2" Margin="0,0,0,16"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="14,12">
            <StackPanel Spacing="10">
              <TextBlock Text="{localization:Localize Tools.ReplayManager.Checkpoint.CreateSaveTitle}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="{localization:Localize Tools.ReplayManager.Checkpoint.CreateSaveSubtitle}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"/>

              <!-- Time / Frame Scrubber Slider -->
              <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0"
                             Text="{localization:Localize Tools.ReplayManager.Checkpoint.TargetPoint}"
                             FontSize="12"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextSecondary}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding CheckpointTimeDisplay}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"/>
                </Grid>

                <Slider Grid.Row="1"
                        Minimum="1"
                        Maximum="{Binding MaxCheckpointSeconds}"
                        Value="{Binding TargetCheckpointTimeSeconds}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="False"
                        IsEnabled="{Binding CanMintCheckpoint}"
                        Margin="0,2,0,2"/>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{localization:Localize Tools.ReplayManager.Checkpoint.MinTime}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMuted}"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding MaxCheckpointTimeDisplay}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMuted}"/>
                </Grid>
              </Grid>

              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <Button Grid.Column="1"
                        Classes="Secondary"
                        Command="{Binding CreateCheckpointCommand}"
                        IsEnabled="{Binding CanMintCheckpoint}"
                        IsVisible="{Binding !IsMintingCheckpoint}"
                        Padding="14,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource ToolIcon.Restore}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{localization:Localize Tools.ReplayManager.Checkpoint.CreateButton}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Classes="Secondary"
                        Command="{Binding CancelMintCheckpointCommand}"
                        IsVisible="{Binding IsMintingCheckpoint}"
                        Padding="14,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource ToolIcon.Close}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{localization:Localize Common.Button.Cancel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Section: Available Checkpoints & Slot Selection -->
          <Border Grid.Row="3" Margin="0,0,0,16"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="14,12">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0"
                           Text="{localization:Localize Tools.ReplayManager.Checkpoint.ExistingTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding AvailableCheckpoints.Count, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='Tools.ReplayManager.Checkpoint.SavesCountFormat'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"/>
              </Grid>

              <!-- Checkpoints List -->
              <Border Grid.Row="1" Margin="0,0,0,8"
                      Background="{DynamicResource CardBackground}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      MinHeight="100"
                      MaxHeight="150">
                <ListBox ItemsSource="{Binding AvailableCheckpoints}"
                         SelectedItem="{Binding SelectedCheckpoint}"
                         Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TargetFrame, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='Tools.ReplayManager.Checkpoint.FrameFormat'}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding FormattedSize}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>
                        <Button Grid.Column="3"
                                Classes="icon-subtle"
                                Command="{Binding $parent[UserControl].((vm:ReplayManagerViewModel)DataContext).DeleteCheckpointCommand}"
                                CommandParameter="{Binding}"
                                Padding="4"
                                ToolTip.Tip="{localization:Localize Tools.ReplayManager.Checkpoint.Tooltip.DeleteSave}">
                          <PathIcon Data="{StaticResource ToolIcon.DeleteOutline}" Width="13" Height="13"/>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <!-- Takeover Slot Picker -->
              <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0"
                           Text="{localization:Localize Tools.ReplayManager.Checkpoint.TakeoverPlayer}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableSlots}"
                          SelectedItem="{Binding SelectedSlot}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={x:Static converters:LocalizedReplaySlotConverter.Instance}}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Grid>
          </Border>

          <!-- Footer Actions -->
          <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="0"
                    Classes="Secondary"
                    Command="{Binding CloseCheckpointDrawerCommand}"
                    HorizontalAlignment="Left"
                    Padding="14,8">
              <TextBlock Text="{localization:Localize Common.Button.Cancel}"/>
            </Button>
            <Button Grid.Column="1"
                    Classes="Secondary"
                    Command="{Binding ResumeReplayFromCheckpointCommand}"
                    IsEnabled="{Binding CanResumeFromCheckpoint}"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    ToolTip.Tip="{localization:Localize Tools.ReplayManager.Checkpoint.Tooltip.Resume}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.Play}" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{localization:Localize Tools.ReplayManager.Checkpoint.Button.Resume}" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Classes="Primary"
                    Command="{Binding TakeoverMatchFromCheckpointCommand}"
                    IsEnabled="{Binding CanTakeoverFromCheckpoint}"
                    Padding="14,8"
                    ToolTip.Tip="{localization:Localize Tools.ReplayManager.Checkpoint.Tooltip.Takeover}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ToolIcon.Gamepad}" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{localization:Localize Tools.ReplayManager.Checkpoint.Button.Takeover}" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- Footer Storage Notice -->
    <TextBlock Grid.Row="3" Text="{localization:Localize Replays.Notice.StorageQuota}"
               FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="600"/>
  </Grid>

  <UserControl.Styles>
    <Style Selector="RadioButton.TabButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" CornerRadius="8" Padding="16,8" Background="Transparent">
            <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold"
                       Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.TabButton:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.TabButton:checked /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.TabButton:checked">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Button styles -->
    <Style Selector="Button.Primary, ToggleButton.Primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.Primary:pointerover, ToggleButton.Primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>

    <!-- Action Bar button height consistency -->
    <Style Selector="Button.ActionBarBtn, ToggleButton.ActionBarBtn">
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Flush split button styles for Upload + Chevron Toggle -->
    <Style Selector="Button.SplitLeft">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.SplitRight">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.SplitRight:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="ToggleButton.SplitRight:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="ToggleButton.SplitRight:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="ToggleButton.SplitRight:checked">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="ToggleButton.SplitRight:checked PathIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="ToggleButton.SplitRight PathIcon">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.Secondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.Secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
    </Style>

    <Style Selector="Button.Danger">
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.Danger:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="ToggleButton.Primary:checked">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
    </Style>

    <Style Selector="Button.icon-subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.icon-subtle:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>

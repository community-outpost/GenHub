<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ViewModels.Dialogs"
             xmlns:converters="using:GenHub.Infrastructure.Converters"
             xmlns:controls="using:GenHub.Infrastructure.Controls"
             xmlns:commonControls="clr-namespace:GenHub.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="720"
             x:Class="GenHub.Features.Tools.Views.Dialogs.AddContentDialogView"
             x:DataType="vm:AddContentDialogViewModel"
             DragDrop.AllowDrop="True"
             x:Name="RootView">

    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="AccentColorBrushConverter"/>
        <converters:StringToImageConverter x:Key="StringToImageConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource GlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="{DynamicResource GlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderStrongBrush}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource GlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20,14,20,14">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Button Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="0"
                    VerticalAlignment="Top">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="12" Height="12"
                          Foreground="{DynamicResource TextMuted}"/>
            </Button>
        </Grid>

        <!-- Form -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14" Margin="0,0,0,80">
                <!-- Name -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.Name}" Classes="label"/>
                        <TextBlock Text="*" Foreground="{DynamicResource StatusErrorBrush}"/>
                    </StackPanel>
                    <TextBox Text="{Binding ContentName}" Watermark="{localization:Localize Tools.PublisherStudio.Content.NamePlaceholder}"/>
                    <Button Content="{localization:Localize Tools.PublisherStudio.Content.UseSuggestedId}"
                            Command="{Binding ApplySuggestedIdCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentColorBrush}"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Cursor="Hand"
                            IsVisible="{Binding !!ContentName.Length}"/>
                </StackPanel>

                <!-- ID -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.Id}" Classes="label"/>
                        <TextBlock Text="*" Foreground="{DynamicResource StatusErrorBrush}"/>
                    </StackPanel>
                    <TextBox Text="{Binding ContentId}" Watermark="{localization:Localize Tools.PublisherStudio.Content.IdPlaceholder}"
                             IsReadOnly="{Binding IsEditMode}"/>
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.IdHint}"
                               Classes="hint"/>
                </StackPanel>

                <!-- Type & Target -->
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.Type}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding AvailableContentTypes}"
                                  SelectedItem="{Binding SelectedContentType}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.TargetGame}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding AvailableTargetGames}"
                                  SelectedItem="{Binding SelectedTargetGame}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Addon Parent Selection (only visible when ContentType is Addon) -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowAddonParentSelection}">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ExtendsContent}" Classes="label"/>
                    <TextBox Text="{Binding ExtendsContentId}"
                             Watermark="{localization:Localize Tools.PublisherStudio.Content.ExtendsPlaceholder}"/>
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ExtendsHint}"
                               Classes="hint"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.Description}" Classes="label"/>
                        <TextBlock Text="*" Foreground="{DynamicResource StatusErrorBrush}"/>
                    </StackPanel>
                    <TextBox Text="{Binding Description}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="110"
                             Height="110"
                             Watermark="{localization:Localize Tools.PublisherStudio.Content.DescriptionPlaceholder}"/>
                </StackPanel>

                <!-- Tags -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.Tags}" Classes="label"/>
                    <TextBox Text="{Binding TagsInput}" Watermark="{localization:Localize Tools.PublisherStudio.Content.TagsPlaceholder}"/>
                </StackPanel>

                <!-- ==================== ARTWORK (Browser cards & detail headers) ==================== -->
                <Expander Background="{DynamicResource GlassFillSubtleBrush}"
                          BorderBrush="{DynamicResource GlassStrongBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="16"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ArtworkTitle}" Classes="label"/>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ArtworkHint}" Classes="hint" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12">

                        <!-- Icon -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.IconArtwork}" Classes="label"/>
                            <commonControls:ImageInputBox Text="{Binding IconArtwork, Mode=TwoWay}"
                                                         Watermark="{localization:Localize Tools.PublisherStudio.Content.ArtworkUrlPlaceholder}"
                                                         FallbackIconData="{StaticResource ContentIcon}"
                                                         PreviewCornerRadius="6"
                                                         PreviewToolTip="{localization:Localize Tools.PublisherStudio.Content.ArtworkDropHint}"/>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ArtworkDropHint}" Classes="hint"/>
                        </StackPanel>

                        <!-- Banner -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.BannerArtwork}" Classes="label"/>
                            <commonControls:ImageInputBox Text="{Binding BannerArtwork, Mode=TwoWay}"
                                                         Watermark="{localization:Localize Tools.PublisherStudio.Content.ArtworkUrlPlaceholder}"
                                                         FallbackIconData="{StaticResource ContentIcon}"
                                                         PreviewCornerRadius="6"
                                                         PreviewToolTip="{localization:Localize Tools.PublisherStudio.Content.ArtworkDropHint}"/>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ArtworkDropHint}" Classes="hint"/>
                        </StackPanel>

                        <!-- Backdrop cover -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.BackdropArtwork}" Classes="label"/>
                            <commonControls:ImageInputBox Text="{Binding BackdropArtwork, Mode=TwoWay}"
                                                         Watermark="{localization:Localize Tools.PublisherStudio.Content.ArtworkUrlPlaceholder}"
                                                         FallbackIconData="{StaticResource ContentIcon}"
                                                         PreviewCornerRadius="6"
                                                         PreviewToolTip="{localization:Localize Tools.PublisherStudio.Content.ArtworkDropHint}"/>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ArtworkDropHint}" Classes="hint"/>
                        </StackPanel>

                        <!-- Accent color -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.AccentColor}" Classes="label"/>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.AccentColorPresetsHint}" Classes="hint" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding AccentColor}"/>
                                <TextBox Text="{Binding AccentColor, Mode=TwoWay}"
                                         Watermark="{localization:Localize Tools.PublisherStudio.Content.AccentColorPlaceholder}"
                                         MaxWidth="200"
                                         VerticalAlignment="Center"/>
                                <Border Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding AccentColor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.PreviewBadge}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Static vm:AddContentDialogViewModel.AccentColorPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding #RootView.((vm:AddContentDialogViewModel)DataContext).SelectAccentColorCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding}"
                                                Width="30" Height="30"
                                                Padding="0"
                                                CornerRadius="15"
                                                Margin="0,0,6,6"
                                                Background="{Binding Converter={StaticResource AccentColorBrushConverter}}"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Screenshots Section -->
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.Screenshots}" Classes="label"/>
                            <Border x:Name="ContentMediaDropZone"
                                    IsVisible="{Binding !Screenshots.Count}"
                                    DragDrop.AllowDrop="True"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{DynamicResource GlassFillSubtleBrush}"
                                    Padding="12"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <PathIcon Data="{StaticResource DocumentIcon}" Width="14" Height="14" Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.DragDropImagesHint}" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Screenshots List -->
                            <ItemsControl ItemsSource="{Binding Screenshots}" IsVisible="{Binding Screenshots.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassFillSubtleBrush}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding #RootView.((vm:AddContentDialogViewModel)DataContext).RemoveScreenshotCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Cursor="Hand">
                                                    <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="{DynamicResource StatusErrorBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Screenshot URL Input -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <TextBox Text="{Binding NewScreenshotUrl, Mode=TwoWay}"
                                         Watermark="https://example.com/screenshot.png"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Content="{localization:Localize Common.Button.Add}"
                                        Command="{Binding AddScreenshotCommand}"
                                        Background="{DynamicResource GlassStrongBrush}"
                                        Padding="12,6"
                                        CornerRadius="6"/>
                            </Grid>

                            <!-- Bulk Screenshot URLs Input -->
                            <TextBox Text="{Binding ScreenshotUrlsInput, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     Height="60"
                                     Watermark="{localization:Localize Tools.PublisherStudio.Content.BulkScreenshotsPlaceholder}"/>
                        </StackPanel>

                        <!-- Videos Section -->
                        <StackPanel x:Name="VideoDropTarget" Spacing="6" Margin="0,4,0,0" DragDrop.AllowDrop="True">
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.VideoUrl}" Classes="label"/>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.VideoDropHint}" Classes="hint"/>
                            <!-- Videos List -->
                            <ItemsControl ItemsSource="{Binding Videos}" IsVisible="{Binding Videos.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassFillSubtleBrush}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding #RootView.((vm:AddContentDialogViewModel)DataContext).RemoveVideoCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Cursor="Hand">
                                                    <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="{DynamicResource StatusErrorBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Video URL Input -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <TextBox Text="{Binding NewVideoUrl, Mode=TwoWay}"
                                         Watermark="https://www.youtube.com/watch?v=..."
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Content="{localization:Localize Common.Button.Add}"
                                        Command="{Binding AddVideoCommand}"
                                        Background="{DynamicResource GlassStrongBrush}"
                                        Padding="12,6"
                                        CornerRadius="6"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- ==================== INITIAL RELEASE & ARTIFACT (Create Mode Only) ==================== -->
                <Expander x:Name="InitialReleaseSection"
                          Background="{DynamicResource GlassFillSubtleBrush}"
                          BorderBrush="{DynamicResource GlassStrongBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="16"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsVisible="{Binding !IsEditMode}">
                    <Expander.Header>
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.InitialRelease}" Classes="label"/>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="12">
                            <!-- Version and Filename -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.ReleaseVersion}" Classes="label"/>
                                    <TextBox Text="{Binding InitialVersion}" Watermark="1.0.0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" IsVisible="{Binding !IsMultiFileStaging}">
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.PackageFilename}" Classes="label"/>
                                    <TextBox Text="{Binding PackageFilename}" Watermark="{localization:Localize Tools.PublisherStudio.Content.PackageFilenamePlaceholder}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Changelog -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Release.Changelog}" Classes="label"/>
                                <TextBox Text="{Binding ReleaseChangelog, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         Height="60"
                                         Watermark="{localization:Localize Tools.PublisherStudio.Content.ReleaseChangelogPlaceholder}"/>
                            </StackPanel>

                            <!-- Delivery Mode -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Release.ArtifactDeliveryMode}" Classes="label"/>
                                <StackPanel Orientation="Horizontal" Spacing="24">
                                    <RadioButton Content="{localization:Localize Tools.PublisherStudio.Content.SingleBundleOption}"
                                                 IsChecked="{Binding BundleArtifacts, Mode=TwoWay}"
                                                 Foreground="{DynamicResource TextPrimary}"/>
                                    <RadioButton Content="{localization:Localize Tools.PublisherStudio.Content.VariantsOption}"
                                                 IsChecked="{Binding IsVariantsMode, Mode=TwoWay}"
                                                 Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Release.DeliveryModeHint}" Classes="hint" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Drop Zone for Initial Release -->
                            <Border x:Name="InitialReleaseDropZone"
                                    IsVisible="{Binding !HasInitialReleaseFiles}"
                                    DragDrop.AllowDrop="True"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{DynamicResource GlassFillSubtleBrush}"
                                    Padding="12"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <PathIcon Data="{StaticResource AddIcon}" Width="14" Height="14" Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.DragDropFilesHint}" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Explicit Artifacts Section -->
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Release.Artifacts}" Classes="label" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{localization:Localize Tools.PublisherStudio.Release.AddArtifact}"
                                            Command="{Binding AddArtifactCommand}"
                                            Background="{DynamicResource GlassFillBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            FontSize="12"/>
                                </Grid>
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Release.ExplicitArtifactsHint}" Classes="hint" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding ReleaseArtifacts}" IsVisible="{Binding ReleaseArtifacts.Count}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource GlassFillSubtleBrush}"
                                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,6"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="{Binding DownloadUrl}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding #RootView.((vm:AddContentDialogViewModel)DataContext).RemoveArtifactCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4"
                                                            Cursor="Hand">
                                                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="{DynamicResource StatusErrorBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Hosting Mode Radio Buttons -->
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.DownloadSource}" Classes="label" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton Content="{localization:Localize Tools.PublisherStudio.Content.DirectUrlOption}"
                                             IsChecked="{Binding UseDirectUrl, Mode=TwoWay}"
                                             Foreground="{DynamicResource TextPrimary}"/>
                                <RadioButton Content="{localization:Localize Tools.PublisherStudio.Content.LocalFileOption}"
                                             IsChecked="{Binding !UseDirectUrl, Mode=TwoWay}"
                                             Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.DownloadSourceHint}" Classes="hint" TextWrapping="Wrap"/>

                            <!-- Direct URL Mode -->
                            <StackPanel Spacing="4" IsVisible="{Binding UseDirectUrl}">
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.DownloadUrl}" Classes="label"/>
                                <TextBox Text="{Binding DownloadUrl, Mode=TwoWay}"
                                         AutomationProperties.Name="{localization:Localize Tools.PublisherStudio.Content.DownloadUrl}"
                                         Watermark="https://cdn.playgenerals.online/GeneralsOnline_portable_082826_QFE1.zip"/>
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.DownloadUrlHint}" Classes="hint"/>
                            </StackPanel>

                            <!-- Local File Mode -->
                            <StackPanel Spacing="8" IsVisible="{Binding !UseDirectUrl}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.LocalFileOrFolder}" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{localization:Localize Tools.PublisherStudio.Content.DragDropHint}" Classes="hint" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding StagedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource GlassFillSubtleBrush}"
                                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <PathIcon Data="{StaticResource ContentIcon}"
                                                              Width="16" Height="16"
                                                              Foreground="{DynamicResource AccentColorBrush}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FileSizeDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentColorBrush}"
                                                                   IsVisible="{Binding FileSizeDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding ArchiveNoteText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding ArchiveNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding Sha256Hash, StringFormat='SHA256: {0}'}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding Sha256Hash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding #RootView.((vm:AddContentDialogViewModel)DataContext).RemoveStagedFileCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{localization:Localize Tools.PublisherStudio.Content.RemoveStagedFileTooltip}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand">
                                                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="{DynamicResource StatusErrorBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.NoFileSelected}"
                                           Classes="hint"
                                           IsVisible="{Binding !HasStagedFiles}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{localization:Localize Tools.PublisherStudio.Content.BrowseFiles}"
                                            Command="{Binding BrowseLocalFileCommand}"
                                            Padding="12,8"
                                            Background="{DynamicResource GlassStrongBrush}"
                                            CornerRadius="6"
                                            Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Content="{localization:Localize Tools.PublisherStudio.Content.BrowseFolder}"
                                            Command="{Binding BrowseLocalFolderCommand}"
                                            Padding="12,8"
                                            Background="{DynamicResource GlassStrongBrush}"
                                            CornerRadius="6"
                                            Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MultiFileBundleNote}"
                                           Classes="hint"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding IsMultiFileStaging}"/>
                                <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsComputingHash}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Release Dependencies -->
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Release.Dependencies}" Classes="label" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{localization:Localize Tools.PublisherStudio.Release.AddDependency}"
                                            Command="{Binding AddReleaseDependencyCommand}"
                                            Background="{DynamicResource GlassFillBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            FontSize="12"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ReleaseDependencies}" IsVisible="{Binding ReleaseDependencies.Count}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource GlassFillSubtleBrush}"
                                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding ContentId}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="{Binding VersionConstraint}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding #RootView.((vm:AddContentDialogViewModel)DataContext).RemoveReleaseDependencyCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4"
                                                            Cursor="Hand">
                                                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="{DynamicResource StatusErrorBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating Validation Error Badge (Bottom Left) -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="0,0,0,8"
                Padding="12,6"
                Background="{DynamicResource StatusErrorBadgeBackgroundBrush}"
                BorderBrush="{DynamicResource StatusErrorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MaxWidth="320"
                IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                BoxShadow="{DynamicResource FlyoutElevationShadow}">
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="{DynamicResource StatusErrorBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="11"/>
        </Border>

        <!-- Floating Action Button Bar (Bottom Right) -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,0,8"
                Padding="4"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="{DynamicResource FlyoutElevationShadow}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Delete Button (Only in Edit Mode) -->
                <Button Command="{Binding DeleteContentCommand}"
                        IsVisible="{Binding IsEditMode}"
                        Background="{DynamicResource StatusErrorBadgeBackgroundBrush}"
                        BorderBrush="{DynamicResource StatusErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="14,7"
                        Cursor="Hand"
                        ToolTip.Tip="{localization:Localize Tools.PublisherStudio.Library.DeleteContentTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource DeleteIcon}" Width="13" Height="13" Foreground="{DynamicResource StatusErrorBrush}"/>
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Studio.DeleteConfirm}"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Save / Create Button -->
                <Button Content="{Binding SubmitButtonText}"
                        Command="{Binding CreateContentCommand}"
                        Background="{DynamicResource PrimaryGradientBrush}"
                        Foreground="{DynamicResource PrimaryButtonForeground}"
                        CornerRadius="7"
                        Padding="20,7"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Cursor="Hand"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

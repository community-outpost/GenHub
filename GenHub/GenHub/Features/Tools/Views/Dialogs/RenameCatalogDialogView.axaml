<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Tools.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
             x:Class="GenHub.Features.Tools.Views.Dialogs.RenameCatalogDialogView"
             x:DataType="vm:RenameCatalogDialogViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Text="{localization:Localize Tools.PublisherStudio.RenameCatalog.Title}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Button Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="0"
                    VerticalAlignment="Top">
                <PathIcon Data="{StaticResource CloseIcon}"
                          Width="12" Height="12"
                          Foreground="{DynamicResource TextMuted}"/>
            </Button>
        </Grid>

        <!-- Form Body -->
        <StackPanel Grid.Row="1" Spacing="12">
            <TextBlock Text="{localization:Localize Tools.PublisherStudio.RenameCatalog.Name}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="13"/>
            <TextBox Text="{Binding CatalogName, Mode=TwoWay}"
                     Watermark="{localization:Localize Tools.PublisherStudio.RenameCatalog.NamePlaceholder}"
                     FontSize="14"
                     Padding="12,10"/>
            <TextBlock Text="{localization:Localize Tools.PublisherStudio.RenameCatalog.Description}"
                       FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="{DynamicResource StatusErrorBrush}"
                       FontSize="12"
                       IsVisible="{Binding !IsValid}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{localization:Localize Tools.PublisherStudio.RenameCatalog.Cancel}"
                    Command="{Binding CancelCommand}"
                    Classes="glass-btn"
                    Padding="20,10"/>
            <Button Content="{localization:Localize Tools.PublisherStudio.RenameCatalog.RenameButton}"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource PrimaryGradientBrush}"
                    Foreground="{DynamicResource TextPrimary}"
                    CornerRadius="8"
                    Padding="24,10"
                    FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Tools.ViewModels.Dialogs"
             xmlns:conv="using:GenHub.Infrastructure.Converters"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="550"
             x:Class="GenHub.Features.Tools.Views.Dialogs.AddReferralDialogView"
             x:DataType="vm:AddReferralDialogViewModel"
             x:Name="RootView">

    <UserControl.Resources>
        <conv:StringEqualityMultiConverter x:Key="StringEqualityMultiConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.AddTitle}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Button Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="0"
                    VerticalAlignment="Top">
                <PathIcon Data="{StaticResource CloseIcon}"
                          Width="12" Height="12"
                          Foreground="{DynamicResource TextSecondary}"/>
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource GlassFillBrush}"/>
                    </Style>
                    <Style Selector="Button:pointerover PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>

        <!-- Form -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Quick Select from Subscribed Publishers -->
                <Border IsVisible="{Binding AvailablePublishers.Count}"
                        Background="{DynamicResource GlassFillBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource GlassStrongBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.QuickSelect}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"/>
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.QuickSelectPrompt}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ItemsControl ItemsSource="{Binding AvailablePublishers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding #RootView.((vm:AddReferralDialogViewModel)DataContext).SelectPublisherCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Padding="12,8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="32" Height="32"
                                                    CornerRadius="16"
                                                    Background="{DynamicResource PrimaryGradientBrush}"
                                                    Margin="0,0,12,0">
                                                <PathIcon Data="{StaticResource PackageIcon}"
                                                          Width="16" Height="16"
                                                          Foreground="{DynamicResource TextPrimary}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding PublisherName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="13"/>
                                                <TextBlock Text="{Binding PublisherId}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <PathIcon Grid.Column="2"
                                                      Data="{StaticResource CheckmarkIcon}"
                                                      Width="18" Height="18"
                                                      Foreground="{DynamicResource SuccessBrush}">
                                                <PathIcon.IsVisible>
                                                    <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                                                        <Binding Path="#RootView.((vm:AddReferralDialogViewModel)DataContext).SelectedPublisher.PublisherId"/>
                                                        <Binding Path="PublisherId"/>
                                                    </MultiBinding>
                                                </PathIcon.IsVisible>
                                            </PathIcon>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Separator Background="{DynamicResource GlassStrongBrush}" Height="1"/>

                <!-- Manual Entry -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.OrEnterManually}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="14"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.CatalogUrl}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBox Grid.Column="0" Grid.Row="0"
                                     Text="{Binding CatalogUrl}"
                                     Watermark="https://example.com/publisher.json"
                                     IsEnabled="{Binding SelectedPublisher, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Button Grid.Column="1" Grid.Row="0"
                                    Command="{Binding DiscoverPublisherCommand}"
                                    Content="{localization:Localize Tools.PublisherStudio.Referral.Discover}"
                                    Margin="8,0,0,0"
                                    Classes="glass-btn"
                                    Padding="12,8"
                                    IsEnabled="{Binding !IsBusy}"/>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}"
                                         Height="2"
                                         Margin="0,4,0,0"/>
                        </Grid>
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.DiscoverHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <!-- Discovered Publisher Info -->
                    <Border IsVisible="{Binding DiscoveredPublisher, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{DynamicResource StatusSuccessBadgeBackgroundBrush}"
                            CornerRadius="8"
                            Padding="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SuccessBrush}">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="{StaticResource CheckmarkIcon}"
                                      Width="20" Height="20"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.PublisherFound}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding DiscoveredPublisher.Name}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding DiscoveredPublisher.Id}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.PublisherId}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                        <TextBox Text="{Binding PublisherId}"
                                 Watermark="{localization:Localize Tools.PublisherStudio.Referral.PublisherIdPlaceholder}"
                                 IsReadOnly="{Binding DiscoveredPublisher, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Referral.Note}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                        <TextBox Text="{Binding Note}"
                                 Watermark="{localization:Localize Tools.PublisherStudio.Referral.NotePlaceholder}"
                                 AcceptsReturn="True"
                                 Height="80"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                               IsVisible="{Binding !IsValid}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
             <TextBlock Text="{Binding ValidationError}"
                        Foreground="{DynamicResource ErrorBrush}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="300"
                        IsVisible="{Binding !IsValid}"/>

             <Button Content="{localization:Localize Downloads.ImportSubscription.Cancel}"
                     Command="{Binding CloseCommand}"
                     Classes="glass-btn"
                     Padding="24,12"/>
             <Button Content="{localization:Localize Tools.PublisherStudio.Referral.AddButton}"
                     Command="{Binding CreateReferralCommand}"
                     Background="{DynamicResource PrimaryGradientBrush}"
                     Foreground="{DynamicResource TextPrimary}"
                     CornerRadius="8"
                     Padding="32,12"
                     FontWeight="Bold"
                     BorderThickness="0">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                        <Setter Property="Opacity" Value="0.85"/>
                    </Style>
                    <Style Selector="Button:disabled">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

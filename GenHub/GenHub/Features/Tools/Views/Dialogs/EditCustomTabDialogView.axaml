<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ViewModels.Dialogs"
             xmlns:downloadViews="using:GenHub.Features.Downloads.Views"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="720"
             x:Class="GenHub.Features.Tools.Views.Dialogs.EditCustomTabDialogView"
             x:DataType="vm:EditCustomTabDialogViewModel"
             Width="760"
             x:Name="RootView">

    <UserControl.Styles>
        <StyleInclude Source="avares://GenHub/Features/Tools/Views/Dialogs/StudioDialogFormStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,14,20,14">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Button Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="0"
                    VerticalAlignment="Top">
                <PathIcon Data="{StaticResource CloseIcon}"
                          Width="12" Height="12"
                          Foreground="{DynamicResource TextMuted}"/>
            </Button>
        </Grid>

        <!-- Form -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,8,*,8,140">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.TabId}" Classes="label"/>
                        <TextBox Text="{Binding Tab.TabId}" Watermark="{Binding TabIdWatermark}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Header}" Classes="label"/>
                        <TextBox Text="{Binding Tab.Header}" Watermark="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.HeaderPlaceholder}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Order}" Classes="label"/>
                        <NumericUpDown Value="{Binding Tab.Order}" Minimum="0" Maximum="10000" Increment="10" FormatString="F0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Intro}" Classes="label"/>
                    <TextBox Text="{Binding Tab.Intro}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Body}" Classes="label"/>
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.BodyHint}" Classes="hint" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Tab.Body}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" FontFamily="Consolas,Menlo,monospace"/>
                </StackPanel>

                <CheckBox IsChecked="{Binding Tab.IsVisible}" Content="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Visible}"/>

                <!-- Cards -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Cards}" Classes="label"/>
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.ExpiringImageLinks}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Tab.HasExpiringImageLinks}"/>
                    <ItemsControl ItemsSource="{Binding Tab.Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomTabCardEditorItem">
                                <Border Background="{DynamicResource GlassFillSubtleBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.CardTitle}" Classes="label"/>
                                                    <TextBox Text="{Binding Title}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.CardLabel}" Classes="label"/>
                                                    <TextBox Text="{Binding Label}"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.CardDescription}" Classes="label"/>
                                                <TextBox Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"/>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.CardImageUrl}" Classes="label"/>
                                                <TextBox Text="{Binding ImageUrl}" Watermark="https://"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Margin="8,0,0,0"
                                                Command="{Binding #RootView.((vm:EditCustomTabDialogViewModel)DataContext).RemoveCardCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.RemoveCard}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                Cursor="Hand">
                                            <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="{DynamicResource StatusErrorBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.AddCard}"
                            Command="{Binding AddCardCommand}"
                            Background="{DynamicResource GlassStrongBrush}"
                            Padding="12,6"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- Live preview with the same renderer players see -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{localization:Localize Tools.PublisherStudio.Content.CustomTabs.Preview}" Classes="label"/>
                    <Border BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <downloadViews:CustomTabContentView DataContext="{Binding Tab.Preview}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: validation message and actions, docked below the form so they never cover it -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <Border Padding="12,6"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource StatusErrorBadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource StatusErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ValidationError}"
                           Foreground="{DynamicResource StatusErrorBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="11"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{localization:Localize Common.Button.Cancel}"
                        Command="{Binding CloseCommand}"
                        Background="{DynamicResource GlassStrongBrush}"
                        CornerRadius="7"
                        Padding="16,7"
                        FontSize="12"
                        Cursor="Hand"
                        BorderThickness="0"/>
                <Button Content="{localization:Localize Common.Button.Save}"
                        Command="{Binding SaveCommand}"
                        Background="{DynamicResource PrimaryGradientBrush}"
                        Foreground="{DynamicResource PrimaryButtonForeground}"
                        CornerRadius="7"
                        Padding="20,7"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Cursor="Hand"
                        BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

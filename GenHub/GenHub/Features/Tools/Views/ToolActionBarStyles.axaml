<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared action bar styles for the map and replay managers. -->

  <!-- Action Bar button height consistency -->
  <Style Selector="Button.ActionBarBtn, ToggleButton.ActionBarBtn">
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Flush split button styles for Upload + Chevron Toggle -->
  <Style Selector="Button.SplitLeft">
    <Setter Property="CornerRadius" Value="6,0,0,6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.SplitRight">
    <Setter Property="CornerRadius" Value="0,6,6,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.SplitRight:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
  </Style>
  <Style Selector="ToggleButton.SplitRight:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
  </Style>
  <Style Selector="ToggleButton.SplitRight:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
  </Style>
  <Style Selector="ToggleButton.SplitRight:checked">
    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
  </Style>
  <Style Selector="ToggleButton.SplitRight:checked PathIcon">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="ToggleButton.SplitRight PathIcon">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GenHub.Features.Tools.ViewModels"
        xmlns:localization="clr-namespace:GenHub.Common.Markup"
        mc:Ignorable="d"
        d:DesignWidth="580" d:DesignHeight="520"
        x:Class="GenHub.Features.Tools.Views.ShareLinksDialog"
        x:DataType="vm:ShareLinksViewModel"
        Title="{localization:Localize Tools.Share.Title}"
        Icon="avares://GenHub/Assets/Icons/generalshub-icon.png"
        Width="580" Height="520"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Panel>
            <!-- Acrylic Backdrop -->
            <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="16">
                <ExperimentalAcrylicBorder.Material>
                    <ExperimentalAcrylicMaterial
                        BackgroundSource="Digger"
                        TintColor="{DynamicResource SurfaceBackgroundDark}"
                        TintOpacity="0.94"
                        MaterialOpacity="0.88" />
                </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <!-- Window Content -->
            <Grid Margin="28,22,28,22" RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,18"
                      Background="Transparent"
                      PointerPressed="OnTitleBarPointerPressed">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource ToolIcon.ShareOutline}"
                                      Width="18" Height="18"
                                      Foreground="{DynamicResource AccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{localization:Localize Tools.Share.Title}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{localization:Localize Tools.Share.Subtitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="26,0,0,0" />
                    </StackPanel>

                    <!-- Close (X) button -->
                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand}"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="16"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{localization:Localize Common.Close}"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                </Grid>

                <!-- Body -->
                <StackPanel Grid.Row="1" Spacing="14">

                    <!-- Plain download link card -->
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{localization:Localize Tools.Share.NormalLink.Label}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{localization:Localize Tools.Share.NormalLink.Hint}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding NormalUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Height="38"
                                         Background="{DynamicResource CardBackground}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         CornerRadius="8,0,0,8"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="11"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding CopyLinkCommand}"
                                        CommandParameter="{Binding NormalUrl}"
                                        Height="38"
                                        Padding="16,0"
                                        Background="{DynamicResource PrimaryGradientBrush}"
                                        Foreground="{DynamicResource PrimaryButtonForeground}"
                                        FontWeight="SemiBold"
                                        CornerRadius="0,8,8,0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource ToolIcon.ContentCopy}"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource PrimaryButtonForeground}" />
                                        <TextBlock Text="{localization:Localize Common.Action.Copy}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GenHub protocol link card -->
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{localization:Localize Tools.Share.GenHubLink.Label}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{localization:Localize Tools.Share.GenHubLink.Hint}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding GenHubUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Height="38"
                                         Background="{DynamicResource CardBackground}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         CornerRadius="8,0,0,8"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="11"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding CopyLinkCommand}"
                                        CommandParameter="{Binding GenHubUrl}"
                                        Height="38"
                                        Padding="16,0"
                                        Background="{DynamicResource PrimaryGradientBrush}"
                                        Foreground="{DynamicResource PrimaryButtonForeground}"
                                        FontWeight="SemiBold"
                                        CornerRadius="0,8,8,0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource ToolIcon.ContentCopy}"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource PrimaryButtonForeground}" />
                                        <TextBlock Text="{localization:Localize Common.Action.Copy}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button Command="{Binding CloseCommand}"
                            Content="{localization:Localize Common.Close}"
                            Padding="24,8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Panel>
    </Border>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ViewModels"
             xmlns:models="using:GenHub.Core.Models.Providers"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="GenHub.Features.Tools.Views.PublisherStudio.ReferralsView"
             x:DataType="vm:ReferralsViewModel"
             x:Name="RootView">

    <UserControl.Styles>
        <Style Selector="Border.glass-sidebar">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style Selector="Border.glass-card">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- List Item Styles -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- TextBox Styles -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        </Style>

        <!-- Button Styles -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.danger-btn">
            <Setter Property="Background" Value="#20EF4444"/>
            <Setter Property="BorderBrush" Value="#40EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.danger-btn:pointerover">
            <Setter Property="Background" Value="#30EF4444"/>
        </Style>

        <!-- Label Styles -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="320,*">
        <!-- Left Sidebar -->
        <Border Grid.Column="0" Classes="glass-sidebar">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Border Grid.Row="0"
                        Padding="16"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#15FFFFFF">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="32" Height="32"
                                    CornerRadius="8"
                                    Background="{DynamicResource PrimaryGradientBrush}">
                                <PathIcon Data="{StaticResource LinkIcon}"
                                          Width="16" Height="16"
                                          Foreground="White"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Referrals"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Recommend publishers"
                                           FontSize="11"
                                           Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="primary-btn"
                                Command="{Binding AddReferralCommand}"
                                ToolTip.Tip="Add New Referral"
                                Padding="8">
                            <PathIcon Data="{StaticResource AddIcon}" Width="14" Height="14" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Referrals List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Referrals}"
                         SelectedItem="{Binding SelectedReferral}"
                         Background="Transparent"
                         Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:PublisherReferral">
                            <Border Padding="10,8"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="Transparent">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="#15FFFFFF"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding PublisherId, Converter={StaticResource FirstCharConverter}}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentColorBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PublisherId}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding CatalogUrl}"
                                                   FontSize="11"
                                                   Foreground="#6B7280"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel Grid.Row="1"
                            IsVisible="{Binding !Referrals.Count}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <Border Width="52" Height="52"
                            CornerRadius="14"
                            Background="#0AFFFFFF"
                            HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource LinkIcon}"
                                  Width="24" Height="24"
                                  Foreground="#4B5563"/>
                    </Border>
                    <TextBlock Text="No referrals yet"
                               FontSize="13"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Border Grid.Row="2"
                        Padding="12"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#15FFFFFF">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Classes="primary-btn"
                                Command="{Binding AddReferralCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource AddIcon}"
                                          Width="12" Height="12"
                                          Foreground="White"/>
                                <TextBlock Text="Add Referral" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="danger-btn"
                                Command="{Binding DeleteReferralCommand}"
                                IsEnabled="{Binding SelectedReferral, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="Remove selected referral">
                            <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Detail Panel -->
        <ScrollViewer Grid.Column="1" Padding="24">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <!-- Explanatory Banner -->
                <Border Background="{DynamicResource AccentBadgeBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="{StaticResource InfoIcon}" Width="16" Height="16" Foreground="{DynamicResource AccentColorBrush}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="How Referrals Work" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                            <TextBlock Text="Referrals allow your catalog to cross-promote other trusted publishers (such as Community-Outpost or GeneralsOnline). When players subscribe to your catalog, they can easily discover and install content from your referred publishers."
                                       FontSize="11" Foreground="#BBBBCC" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Edit Form (when referral selected) -->
                <Border Classes="glass-card"
                        Padding="24"
                        IsVisible="{Binding IsEditing}">
                    <StackPanel Spacing="16">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Edit Referral"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Update publisher recommendation details"
                                           FontSize="12"
                                           Foreground="#9CA3AF"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="primary-btn"
                                    Command="{Binding SaveEditCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource SaveIcon}"
                                              Width="13" Height="13"
                                              Foreground="White"/>
                                    <TextBlock Text="Save Changes" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Rectangle Height="1" Fill="#15FFFFFF"/>

                        <!-- Publisher ID -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Publisher ID" Classes="field-label"/>
                            <TextBox Text="{Binding EditPublisherId}"
                                     Watermark="e.g. generals-online"/>
                        </StackPanel>

                        <!-- Catalog URL -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Catalog URL" Classes="field-label"/>
                            <TextBox Text="{Binding EditCatalogUrl}"
                                     Watermark="https://cdn.playgenerals.online/catalog.json"/>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Recommendation Note (optional)" Classes="field-label"/>
                            <TextBox Text="{Binding EditNote}"
                                     AcceptsReturn="True"
                                     Height="70"
                                     TextWrapping="Wrap"
                                     Watermark="Why do you recommend this publisher to your players?"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Empty Selection State -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Margin="0,60,0,0"
                            IsVisible="{Binding !IsEditing}">
                    <Border Width="64" Height="64"
                            CornerRadius="16"
                            Background="#08FFFFFF"
                            BorderBrush="#15FFFFFF"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource LinkIcon}"
                                  Width="28" Height="28"
                                  Foreground="#374151"/>
                    </Border>
                    <TextBlock Text="Select a referral to view details, or click 'Add Referral' to recommend a publisher"
                               FontSize="13"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="360"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

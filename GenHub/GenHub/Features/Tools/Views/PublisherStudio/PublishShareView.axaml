<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Features.Tools.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="920" d:DesignHeight="1200"
             x:Class="GenHub.Features.Tools.Views.PublisherStudio.PublishShareView"
             x:DataType="vm:PublishShareViewModel"
             x:Name="RootView">

    <UserControl.Styles>
        <Style Selector="Button.glass-btn">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.glass-btn:pointerover">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-btn:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.primary-btn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="SelectionBrush" Value="#D56AFF"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="TextBox.readonly">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>
        <Style Selector="Border.step-card">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="TextBlock.step-header">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.step-subtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="TextBlock.step-label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#D0D0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.status-valid">
            <Setter Property="Background" Value="#2040FF40"/>
            <Setter Property="BorderBrush" Value="#4040FF40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Border.status-invalid">
            <Setter Property="Background" Value="#20FF5555"/>
            <Setter Property="BorderBrush" Value="#40FF5555"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryGradientBrush}"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Border.tier-badge">
            <Setter Property="Background" Value="#20D56AFF"/>
            <Setter Property="BorderBrush" Value="#50D56AFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style Selector="Border.status-badge-active">
            <Setter Property="Background" Value="#2040FF40"/>
            <Setter Property="BorderBrush" Value="#5040FF40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style Selector="Border.status-badge-pending">
            <Setter Property="Background" Value="#20FFBB00"/>
            <Setter Property="BorderBrush" Value="#50FFBB00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="860" HorizontalAlignment="Left">

            <!-- Main Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Publish and Share"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Host your provider definition and catalogs online, and distribute them via GenHub protocol."
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>

            <!-- Card 1: Hosting Provider & Connection -->
            <Border Classes="step-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="step-header" Text="Hosting Provider" Margin="0,0,0,4"/>
                            <TextBlock Classes="step-subtitle" Text="Choose where to host your provider definition, catalog manifests, and download artifacts." Margin="0"/>
                        </StackPanel>
                        <!-- Connection Status Pill -->
                        <Border Grid.Column="1"
                                IsVisible="{Binding IsProviderAuthenticated}"
                                Classes="status-badge-active"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource CheckmarkIcon}" Width="12" Height="12" Foreground="#40FF40"/>
                                <TextBlock Text="Connected" FontSize="12" Foreground="#40FF40" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                IsVisible="{Binding NeedsAuthentication}"
                                Classes="status-badge-pending"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource ErrorIcon}" Width="12" Height="12" Foreground="#FFBB00"/>
                                <TextBlock Text="Authentication Required" FontSize="12" Foreground="#FFBB00" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Provider Selector -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <ComboBox ItemsSource="{Binding HostingProviders}"
                                  SelectedItem="{Binding SelectedHostingProvider}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#888888" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Google Drive OAuth Section -->
                    <StackPanel IsVisible="{Binding ShowGoogleOAuthButton}" Spacing="12">
                        <TextBlock Text="Uploads will generate direct download streams for client subscriptions and catalog discovery."
                                   FontSize="12" Foreground="#8888AA" TextWrapping="Wrap"/>

                        <Expander Header="Custom Google OAuth Credentials (Optional)"
                                  Background="#0AFFFFFF"
                                  CornerRadius="6">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="Custom Client ID (optional if using environment variable):" FontSize="11" Foreground="#888888"/>
                                <TextBox Text="{Binding GoogleClientId}" Watermark="xxxxxx.apps.googleusercontent.com" FontSize="12"/>
                                <TextBlock Text="Custom Client Secret (optional):" FontSize="11" Foreground="#888888"/>
                                <TextBox Text="{Binding GoogleClientSecret}" Watermark="GOCSPX-xxxxxx" PasswordChar="●" RevealPassword="True" FontSize="12"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- GitHub PAT Input -->
                    <StackPanel IsVisible="{Binding ShowGitHubPatInput}" Spacing="8">
                        <TextBlock Text="Enter your GitHub Personal Access Token:" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding GitHubPersonalAccessToken}" Watermark="ghp_xxxxxxxxxxxx" PasswordChar="●" RevealPassword="True"/>
                    </StackPanel>

                    <!-- Dropbox Token Input -->
                    <StackPanel IsVisible="{Binding ShowDropboxTokenInput}" Spacing="8">
                        <TextBlock Text="Enter your Dropbox Access Token:" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding DropboxAccessToken}" Watermark="sl.xxxxxxxx..." PasswordChar="●" RevealPassword="True"/>
                    </StackPanel>

                    <!-- Authentication Status Message -->
                    <TextBlock Text="{Binding AuthenticationStatusMessage}"
                               FontSize="12" Foreground="#AAAAAA"
                               IsVisible="{Binding AuthenticationStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Auth Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding AuthenticateCommand}"
                                IsVisible="{Binding NeedsAuthentication}"
                                Classes="glass-btn"
                                IsEnabled="{Binding !IsAuthenticating}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource LinkIcon}" Width="14" Height="14" Foreground="White"/>
                                <TextBlock Text="Connect Provider" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SignOutCommand}"
                                IsVisible="{Binding IsProviderAuthenticated}"
                                Classes="glass-btn">
                            <TextBlock Text="Disconnect" Foreground="#AAAAAA"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Uploads & Distribution Hierarchy (1. Definition / 2. Catalogs / 3. Content Items & Releases) -->
            <Border Classes="step-card">
                <StackPanel Spacing="20">
                    <StackPanel>
                        <TextBlock Classes="step-header" Text="Uploads &amp; Distribution Hierarchy" Margin="0,0,0,4"/>
                        <TextBlock Classes="step-subtitle" Text="Overview of your uploaded assets: 1. Provider Definition  ->  2. Catalogs  ->  3. Content Items &amp; Releases" Margin="0"/>
                    </StackPanel>

                    <!-- TIER 1: PROVIDER DEFINITION -->
                    <Border Background="#12FFFFFF"
                            BorderBrush="#40D56AFF"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Tier 1 Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="tier-badge">
                                        <TextBlock Text="1. Definition" FontSize="11" FontWeight="Bold" Foreground="#D56AFF"/>
                                    </Border>
                                    <TextBlock Text="{Binding UploadHierarchy.PublisherName}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UploadHierarchy.PublisherId, StringFormat='(@{0})'}" FontSize="13" Foreground="#888899" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2"
                                        Classes="status-badge-active"
                                        IsVisible="{Binding UploadHierarchy.IsUploaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource CheckmarkIcon}" Width="10" Height="10" Foreground="#40FF40"/>
                                        <TextBlock Text="Live Online" FontSize="11" Foreground="#40FF40" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2"
                                        Classes="status-badge-pending"
                                        IsVisible="{Binding !UploadHierarchy.IsUploaded}">
                                    <TextBlock Text="Not Uploaded Yet" FontSize="11" Foreground="#FFBB00" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- GenHub Protocol Share Link (Prominent) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="GenHub Protocol Share Link" Classes="step-label"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding SubscriptionUrl}"
                                             IsReadOnly="True"
                                             Classes="readonly"
                                             FontFamily="Consolas, Courier New, monospace"
                                             FontSize="13"
                                             Background="#15D56AFF"
                                             BorderBrush="#50D56AFF"
                                             Watermark="Publish definition to generate link..."/>
                                    <Button Grid.Column="1"
                                            Command="{Binding CopySubscriptionUrlCommand}"
                                            Margin="10,0,0,0"
                                            Classes="glass-btn"
                                            Padding="12,10"
                                            ToolTip.Tip="Copy Protocol Link">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14" Foreground="White"/>
                                            <TextBlock Text="Copy Link" FontSize="12" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Users can click or paste this genhub:// link into GenHub to view and subscribe to your content."
                                           FontSize="11" Foreground="#8888AA"/>
                            </StackPanel>

                            <!-- Direct Definition URL -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Online Definition Direct Download URL (publisher.json)" Classes="step-label"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding ProviderDefinitionUrl}"
                                             IsReadOnly="True"
                                             Classes="readonly"
                                             FontFamily="Consolas, Courier New, monospace"
                                             FontSize="12"
                                             Watermark="Not uploaded yet..."/>
                                    <Button Grid.Column="1"
                                            Command="{Binding CopyProviderDefinitionUrlCommand}"
                                            Margin="10,0,0,0"
                                            Classes="glass-btn"
                                            Padding="12,10"
                                            ToolTip.Tip="Copy Definition URL">
                                        <PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Upload Definition Action Button -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Command="{Binding UploadProviderDefinitionCommand}"
                                        Classes="glass-btn"
                                        IsEnabled="{Binding !IsUploading}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource PublishIcon}" Width="14" Height="14" Foreground="White"/>
                                        <TextBlock Text="Upload / Update Provider Definition" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TIER 2: CATALOGS -->
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="tier-badge">
                                <TextBlock Text="2. Catalogs" FontSize="11" FontWeight="Bold" Foreground="#D56AFF"/>
                            </Border>
                            <TextBlock Text="Published Catalogs &amp; Manifests" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Catalogs ItemsControl -->
                        <ItemsControl ItemsSource="{Binding UploadHierarchy.Catalogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:UploadCatalogNodeViewModel">
                                    <Border Background="#0AFFFFFF"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,14">
                                        <StackPanel Spacing="14">
                                            <!-- Catalog Header Row -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <PathIcon Data="{StaticResource ContentIcon}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8888AA" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="2"
                                                        Classes="status-badge-active"
                                                        IsVisible="{Binding IsPublished}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Published" FontSize="11" Foreground="#40FF40" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Classes="status-badge-pending"
                                                        IsVisible="{Binding !IsPublished}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Not Published" FontSize="11" Foreground="#FFBB00" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Publish Catalog Button -->
                                                <Button Grid.Column="3"
                                                        Command="{Binding #RootView.((vm:PublishShareViewModel)DataContext).PublishCatalogByIdCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="glass-btn"
                                                        Padding="12,6"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource PublishIcon}" Width="12" Height="12" Foreground="White"/>
                                                        <TextBlock Text="Publish Catalog" FontSize="12" Foreground="White"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Direct Download URL -->
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPublished}">
                                                <TextBox Text="{Binding DirectDownloadUrl}"
                                                         IsReadOnly="True"
                                                         Classes="readonly"
                                                         FontSize="11"
                                                         FontFamily="Consolas, Courier New, monospace"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding #RootView.((vm:PublishShareViewModel)DataContext).CopyCustomUrlCommand}"
                                                        CommandParameter="{Binding DirectDownloadUrl}"
                                                        Margin="8,0,0,0"
                                                        Classes="glass-btn"
                                                        Padding="10,6">
                                                    <PathIcon Data="{StaticResource CopyIcon}" Width="12" Height="12" Foreground="White"/>
                                                </Button>
                                            </Grid>

                                            <!-- TIER 3: CONTENT ITEMS & RELEASES (Nested inside Catalog) -->
                                            <Border Background="#0D000000"
                                                    BorderBrush="#15FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="tier-badge" Background="#1800AAFF" BorderBrush="#3500AAFF">
                                                            <TextBlock Text="3. Content Items &amp; Releases" FontSize="10" FontWeight="Bold" Foreground="#00AAFF"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding ContentItemCount, StringFormat='{}{0} items'}" FontSize="12" Foreground="#888899" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Content Items List -->
                                                    <ItemsControl ItemsSource="{Binding ContentItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:UploadContentNodeViewModel">
                                                                <Border Background="#08FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                                    <StackPanel Spacing="8">
                                                                        <!-- Item Header -->
                                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#777788" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <Border Grid.Column="1" Background="#2000AAFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                                <TextBlock Text="{Binding ContentType}" FontSize="10" Foreground="#00AAFF"/>
                                                                            </Border>
                                                                            <Border Grid.Column="2" Background="#20AAAAAA" CornerRadius="4" Padding="6,2">
                                                                                <TextBlock Text="{Binding TargetGame}" FontSize="10" Foreground="#CCCCCC"/>
                                                                            </Border>
                                                                        </Grid>

                                                                        <!-- Releases List -->
                                                                        <ItemsControl ItemsSource="{Binding Releases}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="vm:UploadReleaseNodeViewModel">
                                                                                    <StackPanel Spacing="6" Margin="12,0,0,4">
                                                                                        <!-- Version Header -->
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <Border Background="#2040FF40" CornerRadius="3" Padding="5,1">
                                                                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10" Foreground="#40FF40" FontWeight="Bold"/>
                                                                                            </Border>
                                                                                            <TextBlock Text="{Binding ReleaseDate}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                                                                        </StackPanel>

                                                                                        <!-- Artifacts Breakdown -->
                                                                                        <ItemsControl ItemsSource="{Binding Artifacts}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate DataType="vm:UploadArtifactNodeViewModel">
                                                                                                    <Border Background="#0AFFFFFF" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                                                                            <PathIcon Data="{StaticResource PackageIcon}" Width="12" Height="12" Foreground="#8888AA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                                                                            <TextBlock Grid.Column="2" Text="{Binding FileSizeFormatted}" FontSize="10" Foreground="#8888AA" Margin="10,0" VerticalAlignment="Center"/>

                                                                                                            <!-- Direct Download URL or local indicator -->
                                                                                                            <TextBlock Grid.Column="3"
                                                                                                                       Text="{Binding DownloadUrl}"
                                                                                                                       FontSize="10"
                                                                                                                       Foreground="#666688"
                                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                                       MaxWidth="200"
                                                                                                                       VerticalAlignment="Center"
                                                                                                                       IsVisible="{Binding HasUrl}"/>
                                                                                                            <TextBlock Grid.Column="3"
                                                                                                                       Text="Local file pending upload"
                                                                                                                       FontSize="10"
                                                                                                                       Foreground="#FFBB00"
                                                                                                                       VerticalAlignment="Center"
                                                                                                                       IsVisible="{Binding !HasUrl}"/>

                                                                                                            <!-- Copy Link Button -->
                                                                                                            <Button Grid.Column="4"
                                                                                                                    Command="{Binding #RootView.((vm:PublishShareViewModel)DataContext).CopyCustomUrlCommand}"
                                                                                                                    CommandParameter="{Binding DownloadUrl}"
                                                                                                                    IsVisible="{Binding HasUrl}"
                                                                                                                    Background="Transparent"
                                                                                                                    Padding="6,4"
                                                                                                                    Margin="6,0,0,0"
                                                                                                                    ToolTip.Tip="Copy Artifact URL">
                                                                                                                <PathIcon Data="{StaticResource CopyIcon}" Width="10" Height="10" Foreground="White"/>
                                                                                                            </Button>
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Validation & Publish All Catalogs Actions -->
                    <Border Background="#10FFFFFF" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="14">
                            <!-- Validation status -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Data="{StaticResource CheckmarkIcon}" Width="16" Height="16" Foreground="#40FF40" IsVisible="{Binding IsValid}" Margin="0,0,10,0"/>
                                <PathIcon Data="{StaticResource ErrorIcon}" Width="16" Height="16" Foreground="#FF5555" IsVisible="{Binding !IsValid}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ValidationMessage}" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                                <Button Grid.Column="2" Command="{Binding ValidateCatalogCommand}" Content="Revalidate" Classes="glass-btn" Padding="10,6" FontSize="11"/>
                            </Grid>

                            <!-- Progress Bar -->
                            <ProgressBar Value="{Binding UploadProgress}"
                                         Maximum="100"
                                         IsVisible="{Binding IsUploading}"/>

                            <TextBlock Text="{Binding UploadStatusMessage}"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       IsVisible="{Binding UploadStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Publish All Catalogs and Definition Button -->
                            <Button Command="{Binding PublishAllCatalogsCommand}"
                                    Classes="primary-btn"
                                    IsEnabled="{Binding !IsUploading}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource PublishIcon}" Width="16" Height="16" Foreground="White"/>
                                    <TextBlock Text="Publish All Catalogs &amp; Update Definition" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

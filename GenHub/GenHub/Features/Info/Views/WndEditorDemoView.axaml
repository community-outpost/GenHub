<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Info.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="560"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             x:Class="GenHub.Features.Info.Views.WndEditorDemoView"
             x:DataType="vm:WndEditorDemoViewModel">

    <UserControl.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" ClipToBounds="True" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Mock menu bar -->
            <Menu Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" Padding="8,2">
                <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.File}">
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.New}" Command="{Binding NewDocumentCommand}"/>
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.Save}" Command="{Binding SaveDocumentCommand}"/>
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.Validate}" Command="{Binding ValidateDocumentCommand}"/>
                </MenuItem>
                <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.Edit}">
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.AddChild}" Command="{Binding AddChildWindowCommand}"/>
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.Delete}" Command="{Binding DeleteSelectedWindowCommand}"/>
                </MenuItem>
                <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.View}">
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.ZoomIn}" Command="{Binding ZoomInCommand}"/>
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.ZoomOut}" Command="{Binding ZoomOutCommand}"/>
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.ResetZoom}" Command="{Binding ResetZoomCommand}"/>
                </MenuItem>
                <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.Assets}">
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.LinkFolder}" Command="{Binding LinkModFolderCommand}"/>
                    <MenuItem Header="{localization:Localize Info.Demo.Tools.WndEditor.Menu.ImportTexture}" Command="{Binding ImportTextureCommand}"/>
                </MenuItem>
            </Menu>

            <Grid Grid.Row="1" ColumnDefinitions="210,*,230">
                <!-- Files + window tree -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,1,1" Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.WndEditor.Files.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.WndEditor.Tree.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        <TreeView ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" MinHeight="220">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="vm:WndDemoNode" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </Border>

                <!-- Canvas preview -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,1" Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.WndEditor.Canvas.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch">
                            <Border Width="800" Height="600" Background="#0F0F0F" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                <Canvas Width="800" Height="600" RenderTransformOrigin="0,0">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                    </Canvas.RenderTransform>
                                    <ItemsControl ItemsSource="{Binding CanvasNodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="800" Height="600"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:WndDemoNode">
                                                <Border Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}"
                                                        Background="#2A3F5F" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="2"
                                                        ToolTip.Tip="{Binding DisplayLabel}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Canvas.Left="{Binding SelectedNode.X}" Canvas.Top="{Binding SelectedNode.Y}" Width="{Binding SelectedNode.Width}" Height="{Binding SelectedNode.Height}"
                                            BorderBrush="#FFC107" BorderThickness="2" CornerRadius="2"
                                            IsVisible="{Binding SelectedNode, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                                </Canvas>
                            </Border>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- Properties -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,1,0,1" Padding="10">
                    <StackPanel Spacing="8" IsEnabled="{Binding SelectedNode, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.WndEditor.Properties.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedNode.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedNode.ControlType}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{localization:Localize Info.Demo.Tools.WndEditor.Properties.X}" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedNode.X, Mode=TwoWay}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{localization:Localize Info.Demo.Tools.WndEditor.Properties.Y}" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNode.Y, Mode=TwoWay}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{localization:Localize Info.Demo.Tools.WndEditor.Properties.Width}" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNode.Width, Mode=TwoWay}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{localization:Localize Info.Demo.Tools.WndEditor.Properties.Height}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNode.Height, Mode=TwoWay}"/>
                        </Grid>
                        <Button Command="{Binding ValidateDocumentCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <material:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Localize Info.Demo.Tools.WndEditor.Properties.Validate}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ValidationMessage}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" Padding="12,6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                        <Button Command="{Binding ZoomOutCommand}" Padding="6,2" ToolTip.Tip="{localization:Localize Info.Demo.Tools.WndEditor.Menu.ZoomOut}">
                            <material:MaterialIcon Kind="MagnifyMinusOutline" Width="14" Height="14"/>
                        </Button>
                        <TextBlock Text="{Binding ZoomDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                        <Button Command="{Binding ZoomInCommand}" Padding="6,2" ToolTip.Tip="{localization:Localize Info.Demo.Tools.WndEditor.Menu.ZoomIn}">
                            <material:MaterialIcon Kind="MagnifyPlusOutline" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.WndEditor.Status.Windows}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding NodeCount}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

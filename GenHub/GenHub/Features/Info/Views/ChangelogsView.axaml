<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Info.ViewModels"
             xmlns:models="clr-namespace:GenHub.Core.Models.GitHub;assembly=GenHub.Core"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:GenHub.Infrastructure.Controls"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GenHub.Features.Info.Views.ChangelogsView"
             x:DataType="vm:ChangelogsViewModel"
             x:Name="Root">

  <StackPanel>
    <!-- Header / Refresh -->
    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
       <StackPanel>
         <TextBlock Text="{localization:Localize Info.Changelog.ReleaseHistory}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
         <TextBlock Text="{localization:Localize Info.Changelog.LatestUpdatesFromGitHub}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
       </StackPanel>
       <Button Grid.Column="1" Command="{Binding LoadChangelogsCommand}"
               IsEnabled="{Binding !IsLoading}"
               Padding="8,4" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4">
           <StackPanel Orientation="Horizontal" Spacing="6">
               <material:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
               <TextBlock Text="{localization:Localize Info.Changelog.Refresh}"/>
           </StackPanel>
       </Button>
    </Grid>

    <!-- Loading State -->
    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Margin="0,20"/>

    <!-- Error State -->
    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ErrorBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,20">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <material:MaterialIcon Kind="AlertCircle" Foreground="{DynamicResource ErrorBrush}" Width="24" Height="24"/>
            <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}"/>
        </StackPanel>
    </Border>

    <!-- List -->
    <ItemsControl ItemsSource="{Binding Releases}">
       <ItemsControl.ItemTemplate>
          <DataTemplate>
             <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TagName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SystemAccentColorBrush}"/>
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsPrerelease}">
                                <TextBlock Text="{localization:Localize Info.Changelog.PreRelease}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                             <TextBlock Text="{Binding PublishedAt, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Command="{Binding ((vm:ChangelogsViewModel)DataContext).OpenReleaseUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding HtmlUrl}"
                                Background="Transparent" Padding="4" ToolTip.Tip="{localization:Localize Info.Changelog.ViewOnGitHub}">
                            <material:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>

                    <!-- Separator -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                    <!-- Body -->
                    <ScrollViewer Height="300" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:MarkdownTextBlock Markdown="{Binding Body}" />
                    </ScrollViewer>
                </StackPanel>
             </Border>
          </DataTemplate>
       </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

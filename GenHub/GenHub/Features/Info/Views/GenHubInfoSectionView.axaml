<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Info.ViewModels"
             xmlns:models="clr-namespace:GenHub.Core.Models.Info;assembly=GenHub.Core"
             xmlns:local="clr-namespace:GenHub.Features.GameProfiles.Views"
             xmlns:update="clr-namespace:GenHub.Features.AppUpdate.Views"
             xmlns:views="clr-namespace:GenHub.Features.Info.Views"
             xmlns:toolsRep="clr-namespace:GenHub.Features.Tools.ReplayManager.Views"
             xmlns:toolsMap="clr-namespace:GenHub.Features.Tools.MapManager.Views"
             xmlns:infra="clr-namespace:GenHub.Infrastructure.Controls;assembly=GenHub"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:notifications="clr-namespace:GenHub.Features.Notifications.Views"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             xmlns:controls="clr-namespace:GenHub.Common.Controls;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="GenHub.Features.Info.Views.GenHubInfoSectionView"
             x:DataType="vm:GenHubInfoSectionViewModel">

  <UserControl.Styles>
    <!-- Section Header Style -->
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize" Value="36"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="white"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Info Card Styles - Modern Premium Glassmorphic Look -->
    <Style Selector="Border.info-card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="BoxShadow" Value="0 4 16 0 #30000000"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.info-card-btn">
       <Setter Property="FocusAdorner" Value="{x:Null}"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="ClipToBounds" Value="False"/>
       <Setter Property="Margin" Value="0,0,0,24"/>
       <Setter Property="Template">
         <ControlTemplate>
           <ContentPresenter Content="{TemplateBinding Content}"
                             Padding="{TemplateBinding Padding}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
         </ControlTemplate>
       </Setter>
       <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CircularEaseOut" />
          </Transitions>
       </Setter>
    </Style>

    <Style Selector="Button.info-card-btn:pointerover">
       <Setter Property="RenderTransform" Value="scale(1.015)" />
       <Setter Property="ZIndex" Value="10"/>
    </Style>

    <Style Selector="Button.info-card-btn:pointerover Border.info-card">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BoxShadow" Value="0 15 45 0 #80000000"/>
    </Style>

    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Header for demos "Interactive Element" -->
    <Style Selector="TextBlock.demo-title">
       <Setter Property="FontSize" Value="24"/>
       <Setter Property="FontWeight" Value="Bold"/>
       <Setter Property="Foreground" Value="White"/>
       <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

     <Style Selector="TextBlock.demo-subtitle">
       <Setter Property="FontSize" Value="15"/>
       <Setter Property="Foreground" Value="#AAAAAA"/>
       <Setter Property="Margin" Value="0,6,0,0"/>
       <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Border.demo-container">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
        <Setter Property="BoxShadow" Value="0 10 40 0 #80000000"/>
    </Style>

    <!-- Shortcut Icon Mock Style -->
     <Style Selector="Border.shortcut-mock">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Background" Value="Transparent"/>
     </Style>

    <!-- Card Action Button Styles -->
    <Style Selector="Button.action-btn">
       <Setter Property="FocusAdorner" Value="{x:Null}"/>
       <Setter Property="Template">
         <ControlTemplate>
           <ContentPresenter Content="{TemplateBinding Content}"
                             Padding="{TemplateBinding Padding}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
         </ControlTemplate>
       </Setter>
       <Setter Property="Opacity" Value="0.8"/>
       <Setter Property="Transitions">
         <Transitions>
           <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
         </Transitions>
       </Setter>
    </Style>

    <Style Selector="Button.action-btn:pointerover">
       <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.action-btn.primary">
       <Setter Property="Opacity" Value="1.0"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Demo Preset Switcher Button Styles -->
    <Style Selector="Button.preset-btn">
       <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
       <Setter Property="FontSize" Value="11.5"/>
       <Setter Property="Padding" Value="12,7"/>
       <Setter Property="CornerRadius" Value="6"/>
       <Setter Property="Cursor" Value="Hand"/>
       <Setter Property="Transitions">
         <Transitions>
           <BrushTransition Property="Background" Duration="0:0:0.15"/>
           <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
           <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
         </Transitions>
       </Setter>
    </Style>

    <Style Selector="Button.preset-btn:pointerover">
       <Setter Property="Background" Value="{DynamicResource SurfaceHoverDarkBrush}"/>
       <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}"/>
    </Style>

    <Style Selector="Button.preset-btn.preset-active">
       <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
       <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
    </Style>

    <!-- Markdown Card Content Style -->
    <Style Selector="infra|MarkdownTextBlock.card-content">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

  </UserControl.Styles>

  <controls:SidebarLayout x:Name="CardsSidebarLayout"
                          PanePlacement="Right"
                          PaneTitle="{localization:Localize Info.Sidebar.CardsTitle}"
                          ItemsSource="{Binding SelectedSection.Cards}"
                          SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                          IsPaneOpen="{Binding IsCardsPaneOpen, Mode=TwoWay}"
                          OpenPaneLength="{Binding CardsOpenPaneLength, Mode=TwoWay}"
                          MinPaneLength="180"
                          MaxPaneLength="380">
    <controls:SidebarLayout.ItemTemplate>
      <DataTemplate x:DataType="vm:InfoCardViewModel">
        <DockPanel LastChildFill="True">
          <material:MaterialIcon DockPanel.Dock="Left"
                                 Kind="{Binding IconKind}"
                                 Width="14" Height="14"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Title}"
                     FontSize="12"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </DataTemplate>
    </controls:SidebarLayout.ItemTemplate>

    <ScrollViewer x:Name="InfoContentScrollViewer"
                  Padding="0,16,0,0"
                  ClipToBounds="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,0,32,48" Spacing="10" MaxWidth="1000" HorizontalAlignment="Stretch" ClipToBounds="False">

        <!-- Main Section Header -->
        <StackPanel Margin="0,0,0,50">
          <TextBlock Text="{Binding SelectedSection.Title}" Classes="section-header" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedSection.Description}"
                     FontSize="18"
                     Foreground="#999999"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ============================================== -->
        <!-- DEMO: GAME PROFILES                            -->
        <!-- ============================================== -->
        <Border x:Name="ProfilesDemoContainer" IsVisible="{Binding IsGameProfilesSelected}" Margin="0,0,0,50">
          <StackPanel>
             <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{localization:Localize Info.Demo.ProfileCard.Title}" Classes="demo-title"/>
                <TextBlock Text="{localization:Localize Info.Demo.ProfileCard.Subtitle}" Classes="demo-subtitle"/>
            </StackPanel>

            <Border Classes="demo-container">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="800">
                <StackPanel HorizontalAlignment="Center" Spacing="20">
                    <!-- Scaled down profile card for better fit -->
                    <Viewbox Stretch="Uniform" MaxHeight="400">
                        <local:GameProfileCardView DataContext="{Binding DemoProfileCard}" Width="300" Height="400"/>
                    </Viewbox>

                  <TextBlock Text="{localization:Localize Info.Demo.ProfileCard.Hint}"
                             FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                </StackPanel>
              </Viewbox>
            </Border>
          </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: SHORTCUTS                                -->
        <!-- ============================================== -->
        <Border x:Name="ShortcutsDemoContainer" Margin="0,0,0,50">
             <Border.IsVisible>
                <Binding Path="SelectedSection.Id" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="shortcuts"/>
             </Border.IsVisible>
             <StackPanel>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{localization:Localize Info.Demo.Shortcuts.Title}" Classes="demo-title"/>
                    <TextBlock Text="{localization:Localize Info.Demo.Shortcuts.Subtitle}" Classes="demo-subtitle"/>
                </StackPanel>

                <Border Classes="demo-container">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="800">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40" VerticalAlignment="Center">

                         <!-- 1. The Source: Profile Card -->
                         <StackPanel Spacing="10">
                             <TextBlock Text="{localization:Localize Info.Demo.Shortcuts.Step1}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" FontWeight="Bold"/>
                             <Viewbox Stretch="Uniform" Width="240">
                                <!-- Using actual component for fidelity -->
                                <local:GameProfileCardView DataContext="{Binding DemoShortcutProfile}" Width="300" Height="400"/>
                             </Viewbox>
                             <TextBlock Text="{localization:Localize Info.Demo.Shortcuts.Step1Hint}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" FontStyle="Italic"/>
                         </StackPanel>

                        <!-- Arrow -->
                        <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="32" Height="32" Foreground="#444" VerticalAlignment="Center" Margin="0,25,0,0"/>

                        <!-- 2. The Result: Desktop Icon -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{localization:Localize Info.Demo.Shortcuts.Step2}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="8" Width="120" Margin="0,50,0,0">
                                 <!-- Windows Desktop Icon Look-alike -->
                                 <Border Background="Transparent" Padding="8">
                                     <StackPanel Spacing="2">
                                         <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                            <Image Source="avares://GenHub/Assets/Icons/generalshub-icon.png" Width="48" Height="48"/>
                                            <!-- Shortcut Overlay Arrow -->
                                            <Border Background="White" Width="16" Height="16" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,0" BorderBrush="#888" BorderThickness="1">
                                                <PathIcon Data="M10,2H19V11M19,2L6,15" Width="12" Height="12" Foreground="Black" RenderTransform="rotate(-45deg)" RenderTransformOrigin="50%,50%"/>
                                            </Border>
                                         </Grid>
                                         <TextBlock Text="{localization:Localize Info.Demo.ZeroHourDemo}" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                                    Effect="drop-shadow(1 1 2 black)"/>
                                     </StackPanel>
                                 </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                  </Viewbox>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: STEAM INTEGRATION                        -->
        <!-- ============================================== -->
         <Border x:Name="SteamDemoContainer" Margin="0,0,0,50">
             <Border.IsVisible>
                <Binding Path="SelectedSection.Id" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="steam-integration"/>
             </Border.IsVisible>
             <StackPanel>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{localization:Localize Info.Demo.Steam.Title}" Classes="demo-title"/>
                    <TextBlock Text="{localization:Localize Info.Demo.Steam.Subtitle}" Classes="demo-subtitle"/>
                </StackPanel>

                <Border Classes="demo-container">
                    <StackPanel HorizontalAlignment="Center" Spacing="20">
                        <TextBlock Text="{localization:Localize Info.Demo.Steam.Hint}"
                                   FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                        <Viewbox Stretch="Uniform" MaxHeight="400">
                             <local:GameProfileCardView DataContext="{Binding DemoSteamProfile}" Width="300" Height="400"/>
                        </Viewbox>

                         <TextBlock Text="{localization:Localize Info.Demo.Steam.ActiveHint}" Foreground="{DynamicResource SystemAccentColorBrush}" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: APP UPDATE                               -->
        <!-- ============================================== -->
        <Border x:Name="AppUpdatesDemoContainer" IsVisible="{Binding IsAppUpdatesSelected}" Margin="0,15,0,0">
          <StackPanel Spacing="40">
            <!-- 1. Standard Update Mechanism -->
            <StackPanel Spacing="20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Grid.Column="0" Kind="CloudDownload" Width="24" Height="24" Foreground="{StaticResource SystemAccentColorBrush}"/>
                        <TextBlock Grid.Column="1" Text="{localization:Localize Info.Demo.AppUpdates.AutoUpdatesTitle}" Classes="demo-title" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.AutoUpdatesSubtitle}"
                               Classes="demo-subtitle"/>
                </StackPanel>

                <Border Classes="demo-container">
                  <StackPanel HorizontalAlignment="Center" Spacing="20">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackground}" ClipToBounds="True" MaxWidth="600">
                        <update:UpdateNotificationView DataContext="{Binding DemoUpdateNotification}"/>
                    </Border>
                    <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.BrowseBuildsHint}"
                               FontSize="12" Foreground="#666" HorizontalAlignment="Center" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. GitHub Auth & CI Artifacts -->
            <StackPanel Spacing="20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Grid.Column="0" Kind="Github" Width="24" Height="24" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                        <TextBlock Grid.Column="1" Text="{localization:Localize Info.Demo.AppUpdates.CiArtifactsTitle}" Classes="demo-title" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.CiArtifactsSubtitle}"
                               Classes="demo-subtitle"/>

                    <!-- Detailed explanations (GitHub Auth & CI) -->
                    <StackPanel Margin="0,12,0,0" Spacing="15">
                        <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.CiDescription}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="1000"/>

                        <Border Classes="demo-container" Margin="0,10,0,0">
                          <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxWidth="600" HorizontalAlignment="Center">
                                <StackPanel Spacing="20">
                                     <StackPanel Orientation="Horizontal" Spacing="12">
                                        <material:MaterialIcon Kind="Github" Width="24" Height="24" Foreground="{DynamicResource SystemAccentColorBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.AuthTitle}"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                     </StackPanel>

                                     <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.AuthDescription}"
                                                FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

                                     <!-- Sample device code (static demo illustration) -->
                                     <Border Background="{DynamicResource AccentTintBackgroundBrush}" CornerRadius="6" Padding="16,12" HorizontalAlignment="Left">
                                         <TextBlock Text="{localization:Localize Info.Demo.AppUpdates.AuthSampleCode}"
                                                    Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" LetterSpacing="4" />
                                     </Border>
                                </StackPanel>
                            </Border>
                          </Viewbox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: GAME SETTINGS                            -->
        <!-- ============================================== -->
        <Border x:Name="GameSettingsDemoContainer" IsVisible="{Binding IsGameSettingsSelected}" Margin="0,0,0,50">
          <StackPanel Spacing="16">
             <StackPanel HorizontalAlignment="Left" Spacing="8">
                <TextBlock Text="{localization:Localize Info.Demo.GameSettings.Title}" Classes="demo-title"/>
                <TextBlock Text="{localization:Localize Info.Demo.GameSettings.Subtitle}" Classes="demo-subtitle"/>
            </StackPanel>

            <Border Classes="demo-container">
               <StackPanel Spacing="16">
                  <!-- Demo Size Preset Bar -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                     <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Window Size:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Classes="preset-btn" Classes.preset-active="{Binding IsDemoSizeCompact}" Command="{Binding SetDemoCompactCommand}" Content="Compact (720x480)" Padding="10,4" FontSize="11" CornerRadius="6"/>
                        <Button Classes="preset-btn" Classes.preset-active="{Binding IsDemoSizeStandard}" Command="{Binding SetDemoStandardCommand}" Content="Standard (840x580)" Padding="10,4" FontSize="11" CornerRadius="6"/>
                        <Button Classes="preset-btn" Classes.preset-active="{Binding IsDemoSizeExpanded}" Command="{Binding SetDemoExpandedCommand}" Content="Expanded (980x680)" Padding="10,4" FontSize="11" CornerRadius="6"/>
                     </StackPanel>
                     <TextBlock Grid.Column="1" Text="{localization:Localize Info.Demo.GameSettings.Hint}" FontSize="11" Foreground="{DynamicResource TextMuted}" FontStyle="Italic" VerticalAlignment="Center"/>
                  </Grid>

                  <!-- The Resizable Mock Window Content (Direct rendering without Viewbox distortion) -->
                  <Border Width="{Binding DemoSettingsWidth}"
                          Height="{Binding DemoSettingsHeight}"
                          MinWidth="640"
                          MaxWidth="1040"
                          MinHeight="440"
                          MaxHeight="750"
                          HorizontalAlignment="Center"
                          Background="#0F0F0F"
                          BorderBrush="#333"
                          BorderThickness="1"
                          CornerRadius="8"
                          ClipToBounds="True">
                      <local:DemoGameProfileSettingsWindowMock DataContext="{Binding DemoGameSettings_SettingsTab}"/>
                  </Border>
               </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: CONTENT SELECTION                        -->
        <!-- ============================================== -->
        <Border x:Name="GameProfileContentDemoContainer" IsVisible="{Binding IsGameProfileContentSelected}" Margin="0,0,0,50">
          <StackPanel Spacing="16">
             <StackPanel HorizontalAlignment="Left" Spacing="8">
                <TextBlock Text="{localization:Localize Info.Demo.ContentSelection.Title}" Classes="demo-title"/>
                <TextBlock Text="{localization:Localize Info.Demo.ContentSelection.Subtitle}" Classes="demo-subtitle"/>

                <!-- Detailed explanations -->
                <StackPanel Margin="0,12,0,0" Spacing="6">
                    <TextBlock Text="{localization:Localize Info.Demo.ContentSelection.Description}"
                               FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap" MaxWidth="900"/>
                </StackPanel>
            </StackPanel>

            <Border Classes="demo-container">
               <StackPanel Spacing="16">
                  <!-- Demo Size Preset Bar -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                     <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Window Size:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Classes="preset-btn" Classes.preset-active="{Binding IsDemoSizeCompact}" Command="{Binding SetDemoCompactCommand}" Content="Compact (720x480)" Padding="10,4" FontSize="11" CornerRadius="6"/>
                        <Button Classes="preset-btn" Classes.preset-active="{Binding IsDemoSizeStandard}" Command="{Binding SetDemoStandardCommand}" Content="Standard (840x580)" Padding="10,4" FontSize="11" CornerRadius="6"/>
                        <Button Classes="preset-btn" Classes.preset-active="{Binding IsDemoSizeExpanded}" Command="{Binding SetDemoExpandedCommand}" Content="Expanded (980x680)" Padding="10,4" FontSize="11" CornerRadius="6"/>
                     </StackPanel>
                     <TextBlock Grid.Column="1" Text="{localization:Localize Info.Demo.ContentSelection.Hint}" FontSize="11" Foreground="{DynamicResource TextMuted}" FontStyle="Italic" VerticalAlignment="Center"/>
                  </Grid>

                  <!-- The Resizable Mock Window Content (Direct rendering without Viewbox distortion) -->
                  <Border Width="{Binding DemoSettingsWidth}"
                          Height="{Binding DemoSettingsHeight}"
                          MinWidth="640"
                          MaxWidth="1040"
                          MinHeight="440"
                          MaxHeight="750"
                          HorizontalAlignment="Center"
                          Background="#0F0F0F"
                          BorderBrush="#333"
                          BorderThickness="1"
                          CornerRadius="8"
                          ClipToBounds="True">
                      <local:DemoGameProfileSettingsWindowMock DataContext="{Binding DemoGameSettings_ContentTab}"/>
                  </Border>
               </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: TOOLS                                    -->
        <!-- ============================================== -->
        <Border x:Name="ToolsDemoContainer" IsVisible="{Binding IsToolsSelected}" Margin="0,0,0,50">
            <StackPanel Spacing="60">

                <!-- 1. REPLAY MANAGER -->
                <StackPanel Spacing="40">
                    <!-- Header -->
                    <StackPanel HorizontalAlignment="Left" Spacing="8">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.ReplayManagerTitle}" Classes="demo-title"/>
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.ReplayManagerSubtitle}" Classes="demo-subtitle"/>
                    </StackPanel>

                    <!-- Interactive Demo -->
                    <Border Classes="demo-container">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="800">
                            <Grid Width="800" Height="550" HorizontalAlignment="Center">
                                <Border Background="#0F0F0F" BorderBrush="#333" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <toolsRep:ReplayManagerView DataContext="{Binding DemoReplayManager}"/>
                                </Border>
                            </Grid>
                        </Viewbox>
                    </Border>
                </StackPanel>

                <!-- 2. MAP MANAGER -->
                <StackPanel Spacing="40">
                    <!-- Header -->
                    <StackPanel HorizontalAlignment="Left" Spacing="8">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.MapManagerTitle}" Classes="demo-title"/>
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.MapManagerSubtitle}" Classes="demo-subtitle"/>
                    </StackPanel>

                    <!-- Interactive Demo -->
                    <Border Classes="demo-container">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="800">
                            <Grid Width="800" Height="550" HorizontalAlignment="Center">
                                <Border Background="#0F0F0F" BorderBrush="#333" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <toolsMap:MapManagerView DataContext="{Binding DemoMapManager}"/>
                                </Border>
                            </Grid>
                        </Viewbox>
                    </Border>
                </StackPanel>

                <!-- 3. PUBLISHER STUDIO -->
                <StackPanel Spacing="24">
                    <!-- Header -->
                    <StackPanel HorizontalAlignment="Left" Spacing="8">
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioTitle}" Classes="demo-title"/>
                        <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioSubtitle}" Classes="demo-subtitle"/>
                    </StackPanel>

                    <!-- Showcase Card -->
                    <Border Classes="demo-container">
                        <Border Background="{DynamicResource SurfaceElevatedDarkBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="28,24">
                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Publish" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioShowcaseHeading}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioShowcaseSubheading}"
                                                   FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioShowcaseDesc}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"
                                           LineHeight="20"/>

                                <Grid ColumnDefinitions="*,*,*" Margin="0,6,0,6">
                                    <!-- Step 1 -->
                                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="14,12" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon Kind="PackageVariantClosed" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioStep1Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioStep1Desc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Step 2 -->
                                    <Border Grid.Column="1" Margin="3,0,3,0" Padding="14,12" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon Kind="CloudUploadOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioStep2Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioStep2Desc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Step 3 -->
                                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="14,12" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon Kind="BellRingOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioStep3Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{localization:Localize Info.Demo.Tools.PublisherStudioStep3Desc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <DockPanel LastChildFill="False">
                                    <Button DockPanel.Dock="Left"
                                            Classes="preset-btn preset-active"
                                            Command="{Binding OpenToolsTabCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <material:MaterialIcon Kind="RocketLaunch" Width="16" Height="16"/>
                                            <TextBlock Text="{localization:Localize Info.Demo.Tools.LaunchPublisherStudio}"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: SCAN FOR GAMES                           -->
        <!-- ============================================== -->
        <Border x:Name="ScanDemoContainer" IsVisible="{Binding IsScanForGamesSelected}" Margin="0,0,0,50">
          <StackPanel>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{localization:Localize Info.Demo.ScanWizard.Title}" Classes="demo-title"/>
                <TextBlock Text="{localization:Localize Info.Demo.ScanWizard.Subtitle}" Classes="demo-subtitle"/>
            </StackPanel>

            <Border Classes="demo-container">
               <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="700">
                  <views:ScanWizardDemoView DataContext="{Binding DemoScanWizard}" Width="700" Height="450"/>
               </Viewbox>
            </Border>
          </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: LOCAL CONTENT                            -->
        <!-- ============================================== -->
        <Border x:Name="LocalContentDemoContainer" IsVisible="{Binding IsLocalContentSelected}" Margin="0,0,0,50">
             <StackPanel Spacing="18">
                <StackPanel HorizontalAlignment="Left" Spacing="6">
                    <TextBlock Text="{localization:Localize Info.Demo.LocalContent.Title}" Classes="demo-title"/>
                    <TextBlock Text="{localization:Localize Info.Demo.LocalContent.Subtitle}" Classes="demo-subtitle"/>
                </StackPanel>

                <!-- Demo Presets Switcher Bar -->
                <Border Background="{DynamicResource SurfaceElevatedDarkBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
                            <material:MaterialIcon Kind="TuneVariant" Width="18" Height="18" Foreground="{DynamicResource AccentLightBrush}"/>
                            <TextBlock Text="{localization:Localize Info.Demo.LocalContent.RealUseCases}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="{localization:Localize Info.Demo.LocalContent.PresetMod}"
                                    Command="{Binding DemoAddLocalContent.LoadModPresetCommand}"
                                    Classes.preset-active="{Binding DemoAddLocalContent.IsModPresetActive}"
                                    Classes="preset-btn"
                                    Margin="0,0,8,0"
                                    ToolTip.Tip="{localization:Localize Info.Demo.LocalContent.PresetModTooltip}"/>
                            <Button Content="{localization:Localize Info.Demo.LocalContent.PresetClient}"
                                    Command="{Binding DemoAddLocalContent.LoadGameClientPresetCommand}"
                                    Classes.preset-active="{Binding DemoAddLocalContent.IsGameClientPresetActive}"
                                    Classes="preset-btn"
                                    Margin="0,0,8,0"
                                    ToolTip.Tip="{localization:Localize Info.Demo.LocalContent.PresetClientTooltip}"/>
                            <Button Content="{localization:Localize Info.Demo.LocalContent.PresetTool}"
                                    Command="{Binding DemoAddLocalContent.LoadModdingToolPresetCommand}"
                                    Classes.preset-active="{Binding DemoAddLocalContent.IsModdingToolPresetActive}"
                                    Classes="preset-btn"
                                    Margin="0,0,8,0"
                                    ToolTip.Tip="{localization:Localize Info.Demo.LocalContent.PresetToolTooltip}"/>
                            <Button Content="{localization:Localize Info.Demo.LocalContent.PresetExe}"
                                    Command="{Binding DemoAddLocalContent.LoadExecutablePresetCommand}"
                                    Classes.preset-active="{Binding DemoAddLocalContent.IsExecutablePresetActive}"
                                    Classes="preset-btn"
                                    ToolTip.Tip="{localization:Localize Info.Demo.LocalContent.PresetExeTooltip}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Interactive Window Frame Mockup with Pure Native Theme Colors -->
                <Border Classes="demo-container" Padding="0">
                   <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="840">
                       <Border Width="820"
                               Height="580"
                               Background="{DynamicResource SurfaceElevatedDarkBrush}"
                               BorderBrush="{DynamicResource BorderSubtleBrush}"
                               BorderThickness="1"
                               CornerRadius="10"
                               ClipToBounds="True">
                            <Grid RowDefinitions="36,*">
                                <!-- Simulated Title Bar with Native Palette -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Window control dots -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ErrorBrush}" Opacity="0.85"/>
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource WarningBrush}" Opacity="0.85"/>
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Opacity="0.85"/>
                                        </StackPanel>

                                        <!-- Window Title -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <material:MaterialIcon Kind="PlusCircleOutline" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{localization:Localize Info.Demo.LocalContent.AddLocalContentTitle}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Subtitle Hint -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{localization:Localize Info.Demo.LocalContent.InteractivePreview}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Extracted Content View with pure native colors and padding -->
                                <Border Grid.Row="1" Padding="16,14">
                                    <local:AddLocalContentView DataContext="{Binding DemoAddLocalContent}"/>
                                </Border>
                            </Grid>
                       </Border>
                   </Viewbox>
                </Border>
             </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: CHANGELOGS                               -->
        <!-- ============================================== -->
        <Border IsVisible="{Binding IsChangelogsSelected}" Margin="0,0,0,50">
            <views:ChangelogsView x:Name="GenHubChangelogsView" DataContext="{Binding Changelogs}"/>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: GO CHANGELOG                             -->
        <!-- ============================================== -->
        <Border IsVisible="{Binding IsGoChangelogSelected}" Margin="0,0,0,50">
            <views:GeneralsOnlineChangelogView x:Name="GenHubGoChangelogView" DataContext="{Binding GoChangelog}"/>
        </Border>

        <!-- ============================================== -->
        <!-- DEMO: WORKSPACE (FILESYSTEM MAGIC)             -->
        <!-- ============================================== -->
        <Border x:Name="WorkspacesDemoContainer" IsVisible="{Binding IsWorkspaceSelected}" Margin="0,0,0,50">
          <StackPanel>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{localization:Localize Info.Demo.Workspace.Title}" Classes="demo-title"/>
                <TextBlock Text="{localization:Localize Info.Demo.Workspace.Subtitle}" Classes="demo-subtitle"/>
            </StackPanel>

            <Border Classes="demo-container">
               <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxWidth="800">
                  <views:WorkspaceDemoView DataContext="{Binding DemoWorkspace}" Width="800" Height="500"/>
               </Viewbox>
            </Border>
          </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- INFO CARDS (Dynamic Content)                   -->
        <!-- ============================================== -->

        <!-- Standard Layout (Single Column) -->
        <ItemsControl x:Name="CardsItemsControl"
                      ItemsSource="{Binding SelectedSection.Cards}"
                      IsVisible="{Binding !IsFaqSelected}"
                      Margin="0,0,0,32"
                      ClipToBounds="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="0" ClipToBounds="False"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InfoCardViewModel">
              <!-- Outermost Button to make entire card clickable -->
              <Button Command="{Binding ToggleExpansionCommand}"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      Margin="0,0,0,24"
                      ClipToBounds="False"
                      Classes="info-card-btn">
                <Border Classes="info-card">
                  <Grid RowDefinitions="Auto, Auto">
                    <Grid RowDefinitions="Auto, Auto, Auto" Grid.Row="0">
                      <!-- Card Header -->
                      <Grid ColumnDefinitions="*, Auto" Grid.Row="0" Margin="0,0,0,16">
                        <!-- Title -->
                        <TextBlock Text="{Binding Title}" Grid.Column="0" Classes="card-title" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <!-- Expand Icon -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceHoverBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6"
                                Margin="12,0,0,0"
                                IsVisible="{Binding IsExpandable}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandTextConverter}, FallbackValue='Read More'}"
                                         FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                              <material:MaterialIcon Kind="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                     Width="16" Height="16" Foreground="{DynamicResource TextMuted}"/>
                          </StackPanel>
                        </Border>
                      </Grid>

                      <!-- Main Content -->
                      <infra:MarkdownTextBlock Grid.Row="1" Markdown="{Binding Content}" Classes="card-content" Margin="0,0,0,24" FontSize="15" Foreground="#CCC"/>

                      <!-- Expanded Content -->
                      <Border Grid.Row="2"
                              IsVisible="{Binding IsExpanded}"
                              Background="#CC111111"
                              BorderBrush="#333"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="20"
                              Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="{localization:Localize Info.Guide.DetailedGuide}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
                            <infra:MarkdownTextBlock Markdown="{Binding DetailedContent}" Classes="card-content" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Actions Footer -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Actions}" IsVisible="{Binding Actions.Count}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:InfoAction">
                          <Button Classes="action-btn"
                                  Margin="0,0,10,8"
                                  Classes.primary="{Binding IsPrimary}"
                                  Command="{Binding ((vm:GenHubInfoSectionViewModel)DataContext).HandleActionCommand, RelativeSource={RelativeSource AncestorType=views:GenHubInfoSectionView}}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <material:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{StaticResource SystemAccentColorBrush}"/>
                              <TextBlock Text="{Binding Label}"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- FAQ Layout (Independent Columns for Staggered/Masonry Look) -->
        <Grid IsVisible="{Binding IsFaqSelected}" ColumnDefinitions="*, *" Margin="0,0,0,32" ClipToBounds="False">
            <!-- Left Column -->
            <ItemsControl x:Name="FaqLeftItemsControl" Grid.Column="0" ItemsSource="{Binding FaqCardsLeft}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="0" VerticalAlignment="Top" ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InfoCardViewModel">
                      <Button Command="{Binding ToggleExpansionCommand}"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              Classes="info-card-btn"
                              Margin="0,0,8,24"
                              ClipToBounds="False">
                        <Border Classes="info-card">
                            <StackPanel>
                                <!-- Header (Unified structure) -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding Title}" Grid.Column="0"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>

                                    <!-- Expand Icon (Matches main layout) -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceHoverBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsExpandable}">
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandTextConverter}, FallbackValue='Read More'}"
                                                     FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                          <material:MaterialIcon Kind="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                                 Width="16" Height="16" Foreground="{DynamicResource TextMuted}"/>
                                      </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Expanded Content (Unified with standard cards) -->
                                <StackPanel IsVisible="{Binding IsExpanded}" Margin="0,16,0,0">
                                    <infra:MarkdownTextBlock Markdown="{Binding Content}" FontSize="14" Foreground="#CCC" Margin="0,0,0,8"/>
                                    <infra:MarkdownTextBlock Markdown="{Binding DetailedContent}"
                                                           IsVisible="{Binding DetailedContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           FontSize="13" Foreground="#999"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Right Column -->
            <ItemsControl x:Name="FaqRightItemsControl" Grid.Column="1" ItemsSource="{Binding FaqCardsRight}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="0" VerticalAlignment="Top" ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InfoCardViewModel">
                      <Button Command="{Binding ToggleExpansionCommand}"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              Classes="info-card-btn"
                              Margin="8,0,0,24"
                              ClipToBounds="False">
                        <Border Classes="info-card">
                            <StackPanel>
                                <!-- Header (Unified structure) -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding Title}" Grid.Column="0"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>

                                    <!-- Expand Icon (Matches main layout) -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceHoverBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsExpandable}">
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandTextConverter}, FallbackValue='Read More'}"
                                                     FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                          <material:MaterialIcon Kind="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                                 Width="16" Height="16" Foreground="{DynamicResource TextMuted}"/>
                                      </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Content -->
                                <StackPanel IsVisible="{Binding IsExpanded}" Margin="0,16,0,0">
                                    <infra:MarkdownTextBlock Markdown="{Binding Content}" FontSize="14" Foreground="#CCC" Margin="0,0,0,8"/>
                                    <infra:MarkdownTextBlock Markdown="{Binding DetailedContent}"
                                                           IsVisible="{Binding DetailedContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           FontSize="13" Foreground="#999"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Height="120"/> <!-- Bottom padding to prevent clipping of card drop-shadows and hover scaling -->
      </StackPanel>
    </ScrollViewer>
  </controls:SidebarLayout>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Info.ViewModels"
             xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="GenHub.Features.Info.Views.ScanWizardDemoView"
             x:DataType="vm:ScanWizardDemoViewModel">

    <UserControl.Resources>
      <conv:StringToImageConverter x:Key="StringToImageConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="5">
                        <Grid ColumnDefinitions="30,*">
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    CornerRadius="4"
                                    BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="1"
                                    Background="{TemplateBinding Background}">
                                <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                          Width="12" Height="12"
                                          Foreground="White"
                                          IsVisible="{TemplateBinding IsChecked}"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="12" Background="#1E1E1E" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" Padding="30,24,30,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Found Game Installations" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#888888" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding RescanCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            VerticalAlignment="Center"
                            Background="#2A2A2A"
                            Foreground="#CCC"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="12,0,0,0"
                            ToolTip.Tip="Simulate scanning for installed games">
                        <TextBlock Text="Rescan" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Items -->
            <ScrollViewer Grid.Row="1" Padding="30,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanWizardDemoItemViewModel">
                            <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="#15FFFFFF">
                                <Grid ColumnDefinitions="48,*,Auto">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#2A2A2A" VerticalAlignment="Center">
                                        <Image Source="{Binding IconPath, Converter={StaticResource StringToImageConverter}}" Width="32" Height="32"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="#888888" TextWrapping="Wrap" MaxLines="2" Margin="0,2,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
                                            <Border Background="#252525" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#AAAAAA"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="30,20" Background="#252525">
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Foreground="#888888"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Grid.Column="1"
                            Content="{Binding ConfirmLabel}"
                            Command="{Binding ImportCommand}"
                            IsEnabled="{Binding HasSelectedItems}"
                            Background="White"
                            Foreground="Black"
                            CornerRadius="6"
                            FontWeight="Medium"
                            Padding="20,8"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

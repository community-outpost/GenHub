<controls:GenHubWindow xmlns="https://github.com/avaloniaui"
        xmlns:localization="clr-namespace:GenHub.Common.Markup"
        xmlns:controls="clr-namespace:GenHub.Common.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GenHub.Features.Downloads.ViewModels"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="360"
        x:Class="GenHub.Features.Downloads.Views.ImportSubscriptionDialog"
        x:DataType="vm:ImportSubscriptionViewModel"
        Title="{localization:Localize Downloads.ImportSubscription.Title}"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="BorderOnly"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent">

    <Window.Styles>

    </Window.Styles>

    <Border Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource GlassBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="16"
            BoxShadow="0 16 48 0 #80000000"
            Padding="{DynamicResource DialogPadding}">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                <Border Width="40" Height="40"
                        CornerRadius="10"
                        Background="{DynamicResource PrimaryGradientBrush}"
                        Margin="0,0,14,0">
                    <PathIcon Data="{StaticResource DownloadIcon}"
                              Width="20" Height="20"
                              Foreground="{DynamicResource TextPrimary}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="dialog-title" Text="{localization:Localize Downloads.ImportSubscription.Title}"/>
                    <TextBlock Text="{localization:Localize Downloads.ImportSubscription.Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding CancelCommand}"
                        Classes="icon-action"
                        AutomationProperties.Name="{localization:Localize Common.Button.Close}"
                        ToolTip.Tip="{localization:Localize Common.Button.Close}">
                    <PathIcon Data="{StaticResource CloseIcon}"/>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Spacing="14">
                <TextBlock Text="{localization:Localize Downloads.ImportSubscription.Prompt}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <TextBox Classes="form-field" Text="{Binding InputUrl}"
                         Watermark="{localization:Localize Downloads.ImportSubscription.UrlWatermark}"
                         FontFamily="Consolas, Courier New, monospace"/>

                <!-- Error Message Banner -->
                <Border Background="{DynamicResource StatusErrorBadgeBackgroundBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource ErrorIcon}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource StatusErrorBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{localization:Localize Downloads.ImportSubscription.SupportedSources}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                <Button Command="{Binding CancelCommand}"
                        Content="{localization:Localize Downloads.ImportSubscription.Cancel}"
                        Classes="action-secondary"/>
                <Button Command="{Binding SubmitCommand}"
                        Classes="action-primary"
                        IsEnabled="{Binding !IsValidating}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource LinkIcon}"
                                  Width="16" Height="16"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize Downloads.ImportSubscription.LoadAndSubscribe}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</controls:GenHubWindow>

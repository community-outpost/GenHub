<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Downloads.ViewModels"
             xmlns:models="clr-namespace:GenHub.Core.Models.GameProfile;assembly=GenHub.Core"
             xmlns:converters="clr-namespace:GenHub.Infrastructure.Converters;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="320"
             x:Class="GenHub.Features.Downloads.Views.ContentCardView"
             x:DataType="vm:ContentGridItemViewModel"
             x:Name="Root">

    <UserControl.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:StringToImageConverter x:Key="StringToImageConverter" />
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <converters:ContentStateToTextConverter x:Key="ContentStateToTextConverter" />
        <converters:ContentStateToPathDataConverter x:Key="ContentStateToPathDataConverter" />
        <converters:ContentStateToBrushConverter x:Key="ContentStateToBrushConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Glass card shell — acrylic + gradient live in the visual tree; this Border is the frame. -->
        <Style Selector="Border.content-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="340" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4A2E80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.content-card.bundle-card">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="340" />
            <Setter Property="MaxHeight" Value="560" />
        </Style>

        <Style Selector="Border.content-card:pointerover">
            <Setter Property="BorderBrush" Value="#AB47BC" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- Glass CTAs — translucent wash over acrylic; BoxShadow stays on Border only (AVLN). -->
        <Style Selector="Button.card-button">
            <Setter Property="Background" Value="#C94527A0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#664527A0" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.card-button:pointerover">
            <Setter Property="Background" Value="#E04527A0" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.card-button:pressed">
            <Setter Property="Background" Value="#A0311B92" />
        </Style>

        <Style Selector="Button.card-button:disabled">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="Border.type-badge">
            <Setter Property="Background" Value="#66404040" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style Selector="Border.player-count-badge">
            <Setter Property="Background" Value="#99174D64" />
            <Setter Property="BorderBrush" Value="#2B7A9B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.category-badge">
            <Setter Property="Background" Value="#993A2F1A" />
            <Setter Property="BorderBrush" Value="#8A6A2F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.variant-count-badge">
            <Setter Property="Background" Value="#992A1F3D" />
            <Setter Property="BorderBrush" Value="#7E57C2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.update-button">
            <Setter Property="Background" Value="#99E65100" />
            <Setter Property="BorderBrush" Value="#33FF9800" />
        </Style>

        <Style Selector="Button.update-button:pointerover">
            <Setter Property="Background" Value="#B3F57C00" />
        </Style>

        <Style Selector="Button.add-profile-button">
            <Setter Property="Background" Value="#992E7D32" />
            <Setter Property="BorderBrush" Value="#334CAF50" />
        </Style>

        <Style Selector="Button.add-profile-button:pointerover">
            <Setter Property="Background" Value="#B3368E3C" />
        </Style>

        <Style Selector="ComboBox.card-variant-combo">
            <Setter Property="Background" Value="#661A1228" />
            <Setter Property="BorderBrush" Value="#4A2E80" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="600" />
            <Setter Property="MaxHeight" Value="500" />
        </Style>

        <Style Selector="ToolTip TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </UserControl.Styles>

    <Border Classes="content-card" Classes.bundle-card="{Binding HasBundleComponents}">
        <Panel>
            <!-- 1. Acrylic blur (SidebarLayout / SubscriptionConfirmation pattern) -->
            <ExperimentalAcrylicBorder CornerRadius="12" IsHitTestVisible="False">
                <ExperimentalAcrylicBorder.Material>
                    <ExperimentalAcrylicMaterial
                        BackgroundSource="Digger"
                        TintColor="#0B0814"
                        TintOpacity="0.85"
                        MaterialOpacity="0.55" />
                </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <!-- 2. Gradient tint -->
            <Border CornerRadius="12" IsHitTestVisible="False" Opacity="0.55">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#CC020024" />
                        <GradientStop Offset="0.55" Color="#993D004D" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 3. Content -->
            <Button Command="{Binding ViewCommand}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>

                <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True" Background="Transparent">
                    <!-- Thumbnail / Icon Area -->
                    <Border Grid.Row="0"
                            Height="100"
                            CornerRadius="12,12,0,0"
                            Background="#22000000"
                            ClipToBounds="True">
                        <Panel>
                            <!-- Thumbnail image (banner / screenshot preferred over publisher avatar) -->
                            <Image Source="{Binding IconBitmap}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <!-- Publisher logo badge (top-left overlay) - only shown when thumbnail banner is present -->
                            <Border IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6"
                                    Padding="3"
                                    Width="30" Height="30"
                                    CornerRadius="8"
                                    Background="#B00B0814"
                                    BorderBrush="#50FFFFFF"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    ToolTip.Tip="{Binding ProviderName}">
                                <Image Source="{Binding PublisherLogoBitmap}" Stretch="Uniform"
                                       IsVisible="{Binding PublisherLogoBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Border>

                            <!-- Placeholder when no icon -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                <Border IsVisible="{Binding PublisherLogoBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Width="48" Height="48" CornerRadius="10" Background="#A00B0814" Padding="4">
                                    <Image Source="{Binding PublisherLogoBitmap}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="📦"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding PublisherLogoBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                            </StackPanel>

                            <!-- Content metadata badges -->
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="6"
                                       MaxWidth="228">
                                <Border Classes="type-badge" Margin="0,0,4,4"
                                        ToolTip.Tip="{Binding ContentTypeDisplay}">
                                    <TextBlock Text="{Binding ContentTypeDisplay}"
                                               FontSize="10"
                                               Foreground="#CCCCCC" />
                                </Border>
                                <Border Classes="type-badge variant-count-badge"
                                        IsVisible="{Binding HasVariantCountBadge}"
                                        Margin="0,0,4,4"
                                        ToolTip.Tip="{Binding VariantCountBadge}">
                                    <TextBlock Text="{Binding VariantCountBadge}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#E1D5F5" />
                                </Border>
                                <Border Classes="type-badge player-count-badge"
                                        IsVisible="{Binding HasPlayerCountBadge}"
                                        Margin="0,0,4,4"
                                        ToolTip.Tip="{Binding PlayerCountBadge}">
                                    <TextBlock Text="{Binding PlayerCountBadge}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#D7F4FF" />
                                </Border>
                                <Border Classes="type-badge category-badge"
                                        IsVisible="{Binding HasCategoryBadge}"
                                        Margin="0,0,0,4"
                                        ToolTip.Tip="{Binding CategoryBadge}">
                                    <TextBlock Text="{Binding CategoryBadge}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#FFE7B0" />
                                </Border>
                            </WrapPanel>
                        </Panel>
                    </Border>

                    <!-- Content Info -->
                    <Grid Grid.Row="1" Margin="12,8" Background="Transparent">
                        <StackPanel Spacing="4">
                            <!-- Title -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       ToolTip.Tip="{Binding Name}" />

                        <!-- Author & Date -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding AuthorName}"
                                       FontSize="11"
                                       Foreground="#888888"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasAuthor}"
                                       ToolTip.Tip="{Binding AuthorName}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastUpdatedDisplay}"
                                       FontSize="11"
                                       Foreground="#888888"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       IsVisible="{Binding IsLastUpdatedVisible}"
                                       ToolTip.Tip="{Binding LastUpdatedDisplay}" />
                        </Grid>

                        <!-- Variant pickers (one ComboBox per axis; single-axis looks identical to before). -->
                        <ItemsControl ItemsSource="{Binding VariantAxes}"
                                      IsVisible="{Binding HasVariants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VariantAxisGroup">
                                    <StackPanel Spacing="2" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding AxisLabel}"
                                                   FontSize="10"
                                                   Foreground="#888888"
                                                   IsVisible="{Binding ShowAxisLabel}" />
                                        <ComboBox Classes="card-variant-combo"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedOption}"
                                                  FontSize="11"
                                                  HorizontalAlignment="Stretch"
                                                  MinHeight="24"
                                                  Padding="6,2">
                                            <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate x:DataType="vm:InstallableVariant">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <PathIcon Grid.Column="0"
                                                                  Data="{Binding CurrentState, Converter={StaticResource ContentStateToPathDataConverter}}"
                                                                  Foreground="{Binding CurrentState, Converter={StaticResource ContentStateToBrushConverter}}"
                                                                  Width="12" Height="12"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,6,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="White"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="1"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding Name}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.SelectionBoxItemTemplate>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InstallableVariant">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <PathIcon Grid.Column="0"
                                                                  Data="{Binding CurrentState, Converter={StaticResource ContentStateToPathDataConverter}}"
                                                                  Foreground="{Binding CurrentState, Converter={StaticResource ContentStateToBrushConverter}}"
                                                                  Width="12" Height="12"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,6,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="White"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding Name}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bundle members: identity + per-item variant dropdowns -->
                        <ItemsControl ItemsSource="{Binding BundleComponents}"
                                      IsVisible="{Binding HasBundleComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BundleComponentViewModel">
                                    <StackPanel Spacing="2" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="*,Auto"
                                              Background="Transparent"
                                              ToolTip.Tip="{Binding SelectedDisplayName}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SelectedDisplayName}"
                                                       FontSize="11"
                                                       Foreground="#C5CAE9"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="1"
                                                      Data="{Binding EffectiveState, Converter={StaticResource ContentStateToPathDataConverter}}"
                                                      Foreground="{Binding EffectiveState, Converter={StaticResource ContentStateToBrushConverter}}"
                                                      Width="12" Height="12"
                                                      VerticalAlignment="Center"
                                                      Margin="6,0,0,0" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding VariantAxes}"
                                                      IsVisible="{Binding HasVariants}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VariantAxisGroup">
                                                    <StackPanel Spacing="1" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding AxisLabel}"
                                                                   FontSize="9"
                                                                   Foreground="#888888"
                                                                   IsVisible="{Binding ShowAxisLabel}" />
                                                        <ComboBox Classes="card-variant-combo"
                                                                  ItemsSource="{Binding Options}"
                                                                  SelectedItem="{Binding SelectedOption}"
                                                                  FontSize="11"
                                                                  HorizontalAlignment="Stretch"
                                                                  MinHeight="22"
                                                                  Padding="6,1">
                                                            <ComboBox.SelectionBoxItemTemplate>
                                                                <DataTemplate x:DataType="vm:InstallableVariant">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <PathIcon Grid.Column="0"
                                                                                  Data="{Binding CurrentState, Converter={StaticResource ContentStateToPathDataConverter}}"
                                                                                  Foreground="{Binding CurrentState, Converter={StaticResource ContentStateToBrushConverter}}"
                                                                                  Width="12" Height="12"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,6,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Name}"
                                                                                   FontSize="11"
                                                                                   Foreground="White"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding Name}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ComboBox.SelectionBoxItemTemplate>
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:InstallableVariant">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <PathIcon Grid.Column="0"
                                                                                  Data="{Binding CurrentState, Converter={StaticResource ContentStateToPathDataConverter}}"
                                                                                  Foreground="{Binding CurrentState, Converter={StaticResource ContentStateToBrushConverter}}"
                                                                                  Width="12" Height="12"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,6,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Name}"
                                                                                   FontSize="11"
                                                                                   Foreground="White"
                                                                                   TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding Name}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Includes preview for non-bundle multi-content packages -->
                        <StackPanel Spacing="2" IsVisible="{Binding HasIncludesSummary}">
                            <TextBlock Text="Includes"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#B39DDB" />
                            <TextBlock Text="{Binding IncludesSummary}"
                                       FontSize="11"
                                       Foreground="#C5CAE9"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       LineHeight="15"
                                       ToolTip.Tip="{Binding IncludesSummary}" />
                        </StackPanel>

                        <!-- Version badge -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding HasDisplayVersion}">
                            <Border Background="#66333333" CornerRadius="4" Padding="5,1"
                                    ToolTip.Tip="{Binding Version}">
                                <TextBlock Text="{Binding VersionBadge}"
                                           FontSize="10"
                                           Foreground="#CCCCCC" />
                            </Border>

                            <Border Background="#66333333"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    IsVisible="{Binding IsDownloadSizeVisible}"
                                    ToolTip.Tip="{Binding DownloadSize, Converter={StaticResource FileSizeConverter}}">
                                <TextBlock Text="{Binding DownloadSize, Converter={StaticResource FileSizeConverter}}"
                                           FontSize="10"
                                           Foreground="#CCCCCC" />
                            </Border>
                        </StackPanel>

                        <!-- Tag chips (capped for glanceability) -->
                        <ItemsControl ItemsSource="{Binding DisplayCardTags}"
                                      IsVisible="{Binding HasCardTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#802C3E50"
                                            BorderBrush="#3D566E"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            Margin="0,0,4,2"
                                            ToolTip.Tip="{Binding}">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="10"
                                                   Foreground="#A9C7E5" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Short description (full text lives in details) -->
                        <TextBlock Text="{Binding ShortDescription}"
                                   FontSize="11"
                                   Foreground="#AAAAAA"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   LineHeight="15"
                                   ToolTip.Tip="{Binding Description}"
                                   IsVisible="{Binding HasShortDescription}" />
                    </StackPanel>
                </Grid>

                <!-- Action Area -->
                <StackPanel Grid.Row="2" Margin="12,0,12,12" Spacing="6">
                    <!-- Download Progress -->
                    <ProgressBar Value="{Binding DownloadProgress}"
                                 Maximum="100"
                                 Height="3"
                                 IsVisible="{Binding IsDownloading}"
                                 Foreground="#4CAF50"
                                 Background="#333333" />

                    <!-- Status Text -->
                    <TextBlock Text="{Binding DownloadStatus}"
                               FontSize="10"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DownloadStatus}"
                               IsVisible="{Binding DownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Download Button (visible when not downloaded) -->
                    <Button Classes="card-button"
                            Content="Download"
                            Command="{Binding DownloadCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding ShowDownloadButton}"
                            IsEnabled="{Binding !IsDownloading}">
                        <ToolTip.Tip>Download this content to your library</ToolTip.Tip>
                    </Button>

                    <!-- Update Button (visible when update is available) -->
                    <Button Classes="card-button update-button"
                            Content="Update Available"
                            Command="{Binding UpdateCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding ShowUpdateButton}"
                            IsEnabled="{Binding !IsDownloading}">
                        <ToolTip.Tip>A newer version is available. Click to update.</ToolTip.Tip>
                    </Button>

                    <!-- Add to Profile Button (visible when downloaded) -->
                    <Button Classes="card-button add-profile-button"
                            Content="Add to Profile"
                            Command="{Binding AddToProfileCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding ShowAddToProfileButton}">
                        <ToolTip.Tip>Add this content to a game profile</ToolTip.Tip>
                    </Button>
                </StackPanel>
            </Grid>
            </Button>
        </Panel>
    </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GenHub.Features.Downloads.ViewModels"
        xmlns:profileViews="clr-namespace:GenHub.Features.GameProfiles.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="GenHub.Features.Downloads.Views.ProfileSelectionView"
        x:DataType="vm:ProfileSelectionViewModel"
        Title="Add to Profile"
        Width="1200" Height="780"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="820" MinHeight="600"
        Icon="avares://GenHub/Assets/Icons/generalshub-icon.png"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WindowBackground}">

    <Window.Styles>
        <Style Selector="Grid.TitleBarArea">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="Button.card-select">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Button.card-select:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.card-select /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.card-select:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.card-select:pointerover Border.profile-card">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
            <Setter Property="BoxShadow" Value="0 16 32 4 #80000000" />
            <Setter Property="ZIndex" Value="10" />
        </Style>
        <Style Selector="Button.card-select:pointerover Grid.hover-overlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.card-select:pointerover Border.hover-glow">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Hide the launcher's LAUNCH/tools overlay in this context; the Add badge is the action. -->
        <Style Selector="Button.card-select:pointerover Grid.hover-overlay Button.launch-button,
                         Button.card-select:pointerover Grid.hover-overlay StackPanel">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Action badge (Add / Different game): hidden until hover, fades in nicely. -->
        <Style Selector="Border.action-badge">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card-select:pointerover Border.action-badge">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>

        <Style Selector="Border.add-profile-card">
            <Setter Property="Width" Value="340" />
            <Setter Property="Height" Value="220" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Margin" Value="6,6,22,22" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.new-profile:pointerover Border.add-profile-card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="40,*">
        <!-- Title Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              Classes="TitleBarArea"
              x:Name="TitleBarGrid"
              PointerPressed="OnTitleBarPointerPressed">

            <!-- App icon and title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="avares://GenHub/Assets/Icons/generalshub-icon.png"
                       Width="24" Height="24" />
                <TextBlock Text="Add to Profile"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <!-- Minimize Button -->
            <Button Grid.Column="2"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Padding="0"
                    Width="46" Height="40"
                    Click="MinimizeButton_Click">
                <Path Data="M4,11H20V13H4Z"
                      Fill="{Binding $parent[Button].Foreground}"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,0" />
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </Button.Styles>
            </Button>

            <!-- Maximize/Restore Button -->
            <Button Grid.Column="3"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Padding="0"
                    Width="46" Height="40"
                    Click="MaximizeButton_Click">
                <Path x:Name="MaximizeIcon"
                      Data="M4,4H20V20H4V4M6,8V18H18V8H6Z"
                      Fill="{Binding $parent[Button].Foreground}"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </Button.Styles>
            </Button>

            <!-- Close Button -->
            <Button Grid.Column="4"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Padding="0"
                    Width="46" Height="40"
                    Click="CloseButton_Click">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Fill="{Binding $parent[Button].Foreground}"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- Small, direct context only: the card grid is the main event. -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Add to profile" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding ContentName}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding ContentName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Click a profile to add it" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="20">
                    <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" Margin="0,64" Spacing="10">
                        <ProgressBar IsIndeterminate="True" Width="220" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Loading profiles…" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Could not load profiles" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding !IsLoading}" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCompatibleProfiles}">
                            <TextBlock Text="Compatible profiles" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileSummary}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CompatibleProfileCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:ProfileOptionViewModel">
                                    <Button Classes="card-select"
                                            Command="{Binding $parent[Window].((vm:ProfileSelectionViewModel)DataContext).SelectProfileCommand}"
                                            CommandParameter="{Binding}"
                                            Width="360" Height="236"
                                            Margin="0,0,16,10"
                                            ToolTip.Tip="Add this content to this profile">
                                        <Grid>
                                            <profileViews:GameProfileCardView DataContext="{Binding ProfileCard}" IsHitTestVisible="False" />
                                            <Border Classes="action-badge" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" CornerRadius="14" Background="{DynamicResource AccentBrush}" Padding="10,5">
                                                <TextBlock Text="Add" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="vm:CreateProfileOptionViewModel">
                                    <Button Classes="card-select new-profile"
                                            Command="{Binding $parent[Window].((vm:ProfileSelectionViewModel)DataContext).CreateNewProfileCommand}"
                                            Width="360" Height="236"
                                            Margin="0,0,16,10"
                                            ToolTip.Tip="Create a new profile with this content">
                                        <Border Classes="add-profile-card" Margin="6">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                <TextBlock Text="+" FontSize="42" FontWeight="Light" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Create new profile" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Add this content to a fresh profile" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasOtherProfiles}" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Other profiles" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GeneralsAccentBrush}" />
                            <TextBlock Text="These use another game, so the content may not work." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OtherProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ProfileOptionViewModel">
                                    <Button Classes="card-select"
                                            Command="{Binding $parent[Window].((vm:ProfileSelectionViewModel)DataContext).SelectProfileCommand}"
                                            CommandParameter="{Binding}"
                                            Width="360" Height="236"
                                            Margin="0,0,16,10"
                                            ToolTip.Tip="Add this content to this profile">
                                        <Grid>
                                            <profileViews:GameProfileCardView DataContext="{Binding ProfileCard}" IsHitTestVisible="False" />
                                            <Border Classes="action-badge" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" CornerRadius="12" Background="{DynamicResource WarningBrush}" Padding="9,5">
                                                <TextBlock Text="Different game" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border IsVisible="{Binding !HasAnyProfiles}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="32" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="No profiles yet" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Create a profile and this content will be included automatically." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

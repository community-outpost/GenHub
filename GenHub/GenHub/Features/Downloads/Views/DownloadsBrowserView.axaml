<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.Downloads.ViewModels"
             xmlns:catalogVm="clr-namespace:GenHub.Features.Content.ViewModels.Catalog"
             xmlns:views="clr-namespace:GenHub.Features.Downloads.Views"
             xmlns:converters="clr-namespace:GenHub.Infrastructure.Converters;assembly=GenHub"
             xmlns:constants="clr-namespace:GenHub.Core.Constants;assembly=GenHub.Core"
             xmlns:providers="clr-namespace:GenHub.Core.Models.Providers;assembly=GenHub.Core"
             xmlns:controls="clr-namespace:GenHub.Common.Controls"
             xmlns:infraControls="clr-namespace:GenHub.Infrastructure.Controls;assembly=GenHub"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="GenHub.Features.Downloads.Views.DownloadsBrowserView"
             x:DataType="vm:DownloadsBrowserViewModel"
             Background="Transparent"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <!-- Header style -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Search box style -->
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="TextBox.search-box:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Filter Toggle -->
        <Style Selector="ToggleButton.filter-toggle-btn">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.filter-toggle-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="ToggleButton.filter-toggle-btn:checked">
            <Setter Property="Background" Value="{DynamicResource AccentTintBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="ToggleButton.filter-toggle-btn:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTintBackgroundBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.catalog-reload-btn.spinning PathIcon">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:ContentDetailViewModel">
            <views:ContentDetailView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <controls:SidebarLayout PaneTitle="{localization:Localize Downloads.Browser.Publishers}"
                            ItemsSource="{Binding Publishers}"
                            SelectedItem="{Binding SelectedPublisher, Mode=TwoWay}"
                            IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                            OpenPaneLength="{Binding OpenPaneLength, Mode=TwoWay}"
                            ItemTemplate="{StaticResource PublisherItemTemplate}">

        <controls:SidebarLayout.Resources>
            <converters:StringToImageConverter x:Key="StringToImageConverter" />
            <DataTemplate x:Key="PublisherItemTemplate" DataType="vm:PublisherItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,4">
                    <!-- Publisher Logo -->
                    <Panel Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" Margin="4,0,12,0">
                        <Image infraControls:ImageLoader.Source="{Binding LogoSource}"
                               Width="24" Height="24"
                               Stretch="UniformToFill"
                               IsVisible="{Binding LogoSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Image.Clip>
                                <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                            </Image.Clip>
                        </Image>
                        <!-- Fallback icon -->
                        <Border Width="24" Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding LogoSource, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <!-- Publisher Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Content count badge -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource AccentBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBadgeForegroundBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="7,2"
                            Margin="8,0,4,0"
                            IsVisible="{Binding ContentCount, Converter={x:Static converters:ComparisonConverters.IsPositive}}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ContentCount}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </controls:SidebarLayout.Resources>

        <controls:SidebarLayout.PaneFooter>
            <Button Command="{Binding ImportSubscriptionCommand}"
                    Classes="action-secondary"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,8,12"
                    ToolTip.Tip="{localization:Localize Downloads.Browser.ImportSubscriptionTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <PathIcon Data="{DynamicResource CloudStorageIcon}" Width="{DynamicResource ActionIconSize}" Height="{DynamicResource ActionIconSize}"/>
                    <TextBlock Text="{localization:Localize Downloads.Browser.ImportSubscription}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </controls:SidebarLayout.PaneFooter>

        <!-- Main Content Area -->
        <Grid Margin="16,8,16,16">
            <!-- Browser View: dock the toolbar so the card grid cannot scroll underneath it. -->
            <DockPanel IsVisible="{Binding !IsDetailViewVisible}">
                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,12"
                      IsVisible="{Binding CanSearchOrFilter}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Classes="search-box"
                             Text="{Binding SearchTerm}"
                             Watermark="{localization:Localize Downloads.Browser.SearchWatermark}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding CanSearch}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            <KeyBinding Gesture="Return" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Classes="action-secondary action-compact"
                            Content="{localization:Localize Downloads.Browser.Search}"
                            Command="{Binding SearchCommand}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CanSearch}" />

                    <ToggleButton Grid.Column="2"
                                  Classes="filter-toggle-btn"
                                  IsChecked="{Binding IsFilterPanelVisible}"
                                  IsVisible="{Binding CanShowFilters}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3,2H21V2H21V4H20.92L15,9.92V22.91L9,16.91V9.91L3.09,4H3V2M5.84,4L11,9.17V16.09L13,18.09V9.17L18.16,4H5.84Z"
                                      Width="13" Height="13"
                                      Foreground="{Binding $parent[ToggleButton].Foreground}" />
                            <TextBlock Text="{localization:Localize Downloads.Filters}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- Curated catalog filter: narrows the loaded cards locally without querying the provider. -->
                <StackPanel DockPanel.Dock="Top"
                            Spacing="8"
                            Margin="0,0,0,12"
                            IsVisible="{Binding CanFilterLocally}">
                    <TextBox Classes="search-box clearButton"
                             Text="{Binding LocalFilterText}"
                             Watermark="{localization:Localize Downloads.Browser.Filter.Watermark}"
                             AutomationProperties.Name="{localization:Localize Downloads.Browser.Filter.Watermark}" />

                    <ItemsControl ItemsSource="{Binding LocalCategoryFilters}"
                                  IsVisible="{Binding HasLocalCategoryFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="catalogVm:CatalogCategoryFilter">
                                <Button Command="{Binding $parent[views:DownloadsBrowserView].((vm:DownloadsBrowserViewModel)DataContext).SelectLocalCategoryCommand}"
                                        CommandParameter="{Binding Key}"
                                        Classes.filter-chip-selected="{Binding IsSelected}"
                                        Classes.filter-chip="{Binding !IsSelected}">
                                    <TextBlock Text="{Binding DisplayText}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Catalog switcher and reload bar (visible for subscribed publishers with multiple catalogs, or while loading).
                     Long catalog names trim in place; the full name stays available via tooltip. -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,0,12"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CanShowCatalogSwitcher}">
                    <TextBlock Text="{localization:Localize Downloads.Browser.Catalog}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AvailableCatalogs}"
                              SelectedItem="{Binding SelectedCatalog}"
                              MaxWidth="340"
                              MinWidth="180"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasMultipleCatalogs}"
                              ToolTip.Tip="{Binding SelectedCatalog.Name}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="providers:CatalogEntry">
                                <Grid ColumnDefinitions="Auto,*" MaxWidth="320" Margin="2,4">
                                    <Border Grid.Column="0" Margin="0,0,8,0"
                                            Width="26" Height="26"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceCardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Image infraControls:ImageLoader.Source="{Binding EffectiveIconUrl}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Description}"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate DataType="providers:CatalogEntry">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="20" Height="20"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceCardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Image infraControls:ImageLoader.Source="{Binding EffectiveIconUrl}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="260" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>

                    <!-- Single-catalog name (displayed when only one catalog exists) -->
                    <TextBlock Text="{Binding SelectedCatalog.Name}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260"
                               IsVisible="{Binding !HasMultipleCatalogs}" />

                    <!-- Reload catalog button with animated spin on loading -->
                    <Button Classes="icon-action catalog-reload-btn"
                            Classes.spinning="{Binding IsLoadingCatalogs}"
                            Command="{Binding ReloadCatalogCommand}"
                            ToolTip.Tip="{localization:Localize Downloads.Browser.ReloadCatalog}"
                            AutomationProperties.Name="{localization:Localize Downloads.Browser.ReloadCatalog}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CanShowCatalogSwitcher}">
                        <PathIcon Data="{StaticResource RefreshIcon}"
                                  RenderTransformOrigin="50%,50%" Width="{DynamicResource ActionIconSize}" Height="{DynamicResource ActionIconSize}">
                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="0" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </Button>

                    <!-- Catalog updating / loading label placed directly next to the catalog -->
                    <TextBlock Text="{Binding CatalogLoadingStatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               IsVisible="{Binding IsLoadingCatalogs}" />
                </StackPanel>

                <!-- Filter Panel (Collapsible) -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12"
                        IsVisible="{Binding IsFilterPanelVisible}">
                    <views:FilterPanelView DataContext="{Binding CurrentFilterViewModel}" />
                </Border>

                <!-- Content Grid with Load More. Clip so scrolled cards cannot paint into the toolbar. -->
                <Border ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="8"
                                    Margin="0,40,0,0"
                                    IsVisible="{Binding HasNoLocalFilterMatches}">
                            <TextBlock Text="{localization:Localize Downloads.Browser.Filter.NoMatches}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{localization:Localize Downloads.Browser.Filter.LoadedOnly}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CanLoadMore}" />
                            <Button Classes="action-secondary action-compact"
                                    Content="{localization:Localize Downloads.Browser.Filter.Clear}"
                                    Command="{Binding ClearLocalFilterCommand}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ContentItems}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ContentGridItemViewModel">
                                    <Panel Margin="6" IsVisible="{Binding !IsFilteredOut}">
                                        <views:ContentCardView DataContext="{Binding}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Load More Button -->
                        <Button Content="{localization:Localize Downloads.LoadMore}"
                                Command="{Binding LoadMoreCommand}"
                                IsEnabled="{Binding !IsLoading}"
                                IsVisible="{Binding CanLoadMore}"
                                Classes="action-secondary"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,40" />

                        <!-- Loading Indicator (Bottom) -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,40"
                                    IsVisible="{Binding IsLoading}">
                            <PathIcon Data="{StaticResource ToolIcon.Refresh}"
                                      Width="24" Height="24"
                                      Foreground="{DynamicResource AccentBrush}"
                                      Margin="0,0,10,0">
                                <PathIcon.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </PathIcon.RenderTransform>
                                <PathIcon.Styles>
                                    <Style Selector="PathIcon">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1" IterationCount="Infinite">
                                                <KeyFrame KeyTime="0:0:0">
                                                    <Setter Property="RotateTransform.Angle" Value="0"/>
                                                </KeyFrame>
                                                <KeyFrame KeyTime="0:0:1">
                                                    <Setter Property="RotateTransform.Angle" Value="360"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </PathIcon.Styles>
                            </PathIcon>
                            <TextBlock Text="{localization:Localize Common.Status.LoadingContent}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- Detail View Overlay -->
            <Grid IsVisible="{Binding IsDetailViewVisible}" Background="Transparent">
                <ContentControl Content="{Binding SelectedContent}" />
            </Grid>
        </Grid>
    </controls:SidebarLayout>
</UserControl>

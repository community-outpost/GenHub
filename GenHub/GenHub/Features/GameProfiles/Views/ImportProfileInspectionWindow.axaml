<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
        xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
        xmlns:localization="clr-namespace:GenHub.Common.Markup"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="700"
        x:Class="GenHub.Features.GameProfiles.Views.ImportProfileInspectionWindow"
        x:DataType="vm:ImportProfileInspectionViewModel"
        Title="{localization:Localize GameProfiles.ImportInspection.Title}"
        Width="740" Height="720"
        MinWidth="600" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Window.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:ThemeBackgroundConverter x:Key="ThemeBackgroundConverter" />
        <conv:StringToImageConverter x:Key="StringToImageConverter" />
        <conv:ContentTypeDisplayConverter x:Key="ContentTypeDisplayConverter" />
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <Color x:Key="OverlayWhite50Color">#80FFFFFF</Color>
        <Color x:Key="OverlayWhite12Color">#20FFFFFF</Color>
        <Color x:Key="OverlayWhite02Color">#05FFFFFF</Color>
        <SolidColorBrush x:Key="FillWhite08" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="FillWhite14" Color="#25FFFFFF" />
        <SolidColorBrush x:Key="BorderWhite19" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="FillWhite09" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="FillWhite07" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="FillWhite05" Color="#0CFFFFFF" />
        <SolidColorBrush x:Key="BorderWhite31" Color="#50FFFFFF" />
        <SolidColorBrush x:Key="BorderWhite25" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="ShadowBlack12" Color="#20000000" />
        <SolidColorBrush x:Key="ScrimBlack86" Color="#DD000000" />
    </Window.Resources>

    <Grid Margin="16">
        <!-- Physical Window Border -->
        <Border CornerRadius="16"
                BorderThickness="1"
                ClipToBounds="False"
                BoxShadow="0 16 48 0 #95000000">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="{StaticResource OverlayWhite50Color}" Offset="0" />
                    <GradientStop Color="{StaticResource OverlayWhite12Color}" Offset="0.5" />
                    <GradientStop Color="{StaticResource OverlayWhite02Color}" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Panel>
                <!-- Acrylic Backdrop -->
                <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="16">
                    <ExperimentalAcrylicBorder.Material>
                        <ExperimentalAcrylicMaterial
                            BackgroundSource="Digger"
                            TintColor="{DynamicResource SurfaceBackgroundDark}"
                            TintOpacity="0.96"
                            MaterialOpacity="0.88" />
                    </ExperimentalAcrylicBorder.Material>
                </ExperimentalAcrylicBorder>

                <!-- Tint Overlay -->
                <Border CornerRadius="16"
                        Background="{Binding ThemeColor, Converter={StaticResource ThemeBackgroundConverter}}"
                        IsHitTestVisible="False" />

                <!-- Layout -->
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

                    <!-- Header -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,16"
                          Background="Transparent"
                          PointerPressed="OnTitleBarPointerPressed">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                          Width="20" Height="20"
                                          Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Title}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           LetterSpacing="0.8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Subtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="1"
                                Command="{Binding CancelCommand}"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="{StaticResource FillWhite08}"
                                Foreground="{DynamicResource TextSecondary}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="12" Height="12" />
                        </Button>
                    </Grid>

                    <!-- Persistent Error Alert (Row 1) -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ErrorFillBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,12"
                            IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="Auto,*" Margin="0">
                            <PathIcon Grid.Column="0"
                                      Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                      Width="16" Height="16"
                                      Foreground="{DynamicResource ErrorBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Body Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Spacing="16">

                            <!-- Hero Card: Profile Summary -->
                            <Border Background="{StaticResource FillWhite07}"
                                    BorderBrush="{StaticResource FillWhite14}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Cover / Icon -->
                                    <Border Grid.Column="0"
                                            Width="80" Height="80"
                                            CornerRadius="10"
                                            Background="{StaticResource ShadowBlack12}"
                                            BorderBrush="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderThickness="1.5"
                                            ClipToBounds="True"
                                            Margin="0,0,16,0">
                                        <Panel>
                                            <PathIcon Data="M21,6H3A2,2 0 0,0 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8A2,2 0 0,0 21,6M6,15A2,2 0 1,1 8,13A2,2 0 0,1 6,15M6,11A2,2 0 1,1 8,9A2,2 0 0,1 6,11M18,15A2,2 0 1,1 20,13A2,2 0 0,1 18,15M18,11A2,2 0 1,1 20,9A2,2 0 0,1 18,11Z"
                                                      Width="36" Height="36"
                                                      Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Opacity="0.85"
                                                      IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                            <Image Source="{Binding IconPath, Converter={StaticResource StringToImageConverter}}"
                                                   Stretch="Uniform" Margin="6"
                                                   IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </Panel>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.ProfileName}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBox Text="{Binding ProfileName, Mode=TwoWay}"
                                                     Height="36"
                                                     Padding="10,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="{StaticResource FillWhite09}"
                                                     BorderBrush="{StaticResource BorderWhite25}"
                                                     CornerRadius="6"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     FontWeight="SemiBold"
                                                     FontSize="13" />
                                        </StackPanel>

                                        <WrapPanel Margin="0,4,0,0">
                                            <Border Background="{StaticResource FillWhite14}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding GameVersion}" FontSize="11" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{DynamicResource SuccessFillBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" IsVisible="{Binding HasNameConflict}">
                                                <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.NameAutoRenamed}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Security Warnings Card -->
                            <Border Background="{DynamicResource WarningFillBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    IsVisible="{Binding HasSecurityWarnings}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z"
                                                  Width="16" Height="16"
                                                  Foreground="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.SecurityGuardrails}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding SecurityWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="11" Margin="24,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Content Manifests Breakdown -->
                            <Border Background="{StaticResource FillWhite07}"
                                    BorderBrush="{StaticResource FillWhite14}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{localization:Localize GameProfiles.ImportInspection.BreakdownHeader}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   LetterSpacing="0.5" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Manifests.Count, StringFormat='{}({0} items)'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>

                                    <!-- Manifest Items -->
                                    <ItemsControl ItemsSource="{Binding Manifests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource FillWhite05}"
                                                        BorderBrush="{StaticResource FillWhite09}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel Spacing="8">
                                                        <!-- Main Row -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                                            <!-- Content Type Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource AccentBadgeBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ContentType, Converter={StaticResource ContentTypeDisplayConverter}}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentLightBrush}" />
                                                            </Border>

                                                            <!-- Name and Provenance -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimary}" />
                                                                <TextBlock Text="{Binding Provenance, StringFormat='{}Source: {0}'}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondary}" />
                                                            </StackPanel>

                                                            <!-- Security Badge -->
                                                            <Panel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                                <Border Background="{DynamicResource SuccessFillBrush}"
                                                                        BorderBrush="{DynamicResource SuccessBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="6,2"
                                                                        ToolTip.Tip="{localization:Localize GameProfiles.ImportInspection.Tooltip.SafeDataOnly}"
                                                                        IsVisible="{Binding !ContainsExecutables}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"
                                                                                  Width="10" Height="10"
                                                                                  Foreground="{DynamicResource SuccessBrush}" />
                                                                        <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Badge.DataOnly}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource SuccessBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="{DynamicResource WarningFillBrush}"
                                                                        BorderBrush="{DynamicResource WarningBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="6,2"
                                                                        ToolTip.Tip="{localization:Localize GameProfiles.ImportInspection.Tooltip.WarningExecutables}"
                                                                        IsVisible="{Binding ContainsExecutables}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <PathIcon Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z"
                                                                                  Width="10" Height="10"
                                                                                  Foreground="{DynamicResource WarningBrush}" />
                                                                        <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Badge.Executables}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Panel>

                                                            <!-- Version -->
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Version}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0" />

                                                            <!-- Status Badge -->
                                                            <Panel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Border Background="{DynamicResource SuccessFillBrush}"
                                                                        BorderBrush="{DynamicResource SuccessBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="8,3"
                                                                        IsVisible="{Binding IsCachedLocally}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                                                  Width="10" Height="10"
                                                                                  Foreground="{DynamicResource SuccessBrush}"
                                                                                  VerticalAlignment="Center" />
                                                                        <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Badge.Cached}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="{DynamicResource AccentBadgeBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource AccentLightBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="8,3"
                                                                        IsVisible="{Binding !IsCachedLocally}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                                                                  Width="10" Height="10"
                                                                                  Foreground="{DynamicResource AccentLightBrush}"
                                                                                  VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding DownloadSize, Converter={StaticResource FileSizeConverter}}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource AccentLightBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Panel>

                                                            <!-- Expand / Details Button -->
                                                            <Button Grid.Column="5"
                                                                    Command="{Binding ToggleExpandCommand}"
                                                                    Background="{StaticResource FillWhite08}"
                                                                    BorderBrush="{StaticResource BorderWhite19}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,4"
                                                                    VerticalAlignment="Center"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="{localization:Localize GameProfiles.ImportInspection.Tooltip.Details}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Button.Details}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondary}"
                                                                               VerticalAlignment="Center" />
                                                                    <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                                              Width="10" Height="10"
                                                                              Foreground="{DynamicResource TextSecondary}"
                                                                              VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>

                                                        <!-- Expandable Details Panel -->
                                                        <Border IsVisible="{Binding IsExpanded}"
                                                                Background="{StaticResource FillWhite08}"
                                                                BorderBrush="{StaticResource BorderWhite19}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10"
                                                                Margin="0,4,0,0">
                                                            <StackPanel Spacing="8">
                                                                <!-- Manifest ID -->
                                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                                                    <TextBlock Grid.Column="0" Text="{localization:Localize GameProfiles.ImportInspection.ManifestId}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Width="95" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ManifestId}" FontSize="10" FontFamily="Monospace" Foreground="{DynamicResource TextPrimary}" />
                                                                </Grid>

                                                                <!-- Hash -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Hash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Grid.Column="0" Text="{localization:Localize GameProfiles.ImportInspection.Sha256Hash}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Width="95" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Hash}" FontSize="10" FontFamily="Monospace" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2"
                                                                            Command="{Binding CopyHashCommand}"
                                                                            Padding="6,2"
                                                                            Margin="6,0,0,0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            ToolTip.Tip="{localization:Localize GameProfiles.ImportInspection.Tooltip.CopyHash}">
                                                                        <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                                                                  Width="11" Height="11"
                                                                                  Foreground="{DynamicResource TextSecondary}" />
                                                                    </Button>
                                                                </Grid>

                                                                <!-- Download Source URL -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding DownloadUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Grid.Column="0" Text="{localization:Localize GameProfiles.ImportInspection.DownloadUrl}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Width="95" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding DownloadUrl}" FontSize="10" FontFamily="Monospace" Foreground="{DynamicResource AccentLightBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2"
                                                                            Command="{Binding CopyDownloadUrlCommand}"
                                                                            Padding="6,2"
                                                                            Margin="6,0,0,0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            ToolTip.Tip="{localization:Localize GameProfiles.ImportInspection.Tooltip.CopyUrl}">
                                                                        <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                                                                  Width="11" Height="11"
                                                                                  Foreground="{DynamicResource TextSecondary}" />
                                                                    </Button>
                                                                </Grid>

                                                                <!-- Files Breakdown List -->
                                                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding FilesCount, StringFormat='{}Included Files ({0}):'}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondary}" />
                                                                    <Border Background="{StaticResource FillWhite05}"
                                                                            BorderBrush="{StaticResource FillWhite09}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="6"
                                                                            MaxHeight="140">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                            <ItemsControl ItemsSource="{Binding FileItems}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,2">
                                                                                            <!-- Icon -->
                                                                                            <PathIcon Grid.Column="0"
                                                                                                      Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                                                                                      Width="10" Height="10"
                                                                                                      Foreground="{DynamicResource TextMuted}"
                                                                                                      Margin="0,0,6,0"
                                                                                                      VerticalAlignment="Center"
                                                                                                      IsVisible="{Binding !IsExecutable}" />
                                                                                            <PathIcon Grid.Column="0"
                                                                                                      Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z"
                                                                                                      Width="10" Height="10"
                                                                                                      Foreground="{DynamicResource WarningBrush}"
                                                                                                      Margin="0,0,6,0"
                                                                                                      VerticalAlignment="Center"
                                                                                                      IsVisible="{Binding IsExecutable}" />

                                                                                            <!-- Relative Path -->
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding RelativePath}"
                                                                                                       FontSize="10"
                                                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       VerticalAlignment="Center" />

                                                                                            <!-- Executable Badge -->
                                                                                            <Border Grid.Column="2"
                                                                                                    Background="{DynamicResource ErrorFillBrush}"
                                                                                                    BorderBrush="{DynamicResource ErrorBrush}"
                                                                                                    BorderThickness="1"
                                                                                                    CornerRadius="4"
                                                                                                    Padding="4,1"
                                                                                                    Margin="6,0"
                                                                                                    VerticalAlignment="Center"
                                                                                                    IsVisible="{Binding IsExecutable}">
                                                                                                <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.Badge.Binary}"
                                                                                                           FontSize="8"
                                                                                                           FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource ErrorBrush}" />
                                                                                            </Border>

                                                                                            <!-- Size -->
                                                                                            <TextBlock Grid.Column="3"
                                                                                                       Text="{Binding FormattedSize}"
                                                                                                       FontSize="9"
                                                                                                       Foreground="{DynamicResource TextMuted}"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Settings Summary & Target Installation -->
                            <Border Background="{StaticResource FillWhite07}"
                                    BorderBrush="{StaticResource FillWhite14}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.TargetOptionsHeader}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               LetterSpacing="0.5" />

                                    <!-- Installation Selector -->
                                    <StackPanel Spacing="6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.TargetInstallation}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.TargetInstallationDescription}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding CompatibleInstallations}"
                                                  SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="36">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !HasValidGameInstallation}">
                                            <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource ErrorBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.NoCompatibleInstallation}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Launch Arguments -->
                                    <StackPanel Spacing="4" IsVisible="{Binding CommandLineArguments, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.LaunchArguments}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <Border Background="{StaticResource FillWhite08}" CornerRadius="6" Padding="10,6">
                                             <TextBlock Text="{Binding CommandLineArguments}"
                                                        FontSize="11"
                                                        FontFamily="Monospace"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Include Settings Checkbox -->
                                    <CheckBox IsChecked="{Binding IncludeGameSettings, Mode=TwoWay}"
                                              Content="{localization:Localize GameProfiles.ImportInspection.IncludeGameSettings}"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                        <!-- Summary info -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MissingManifestCount, StringFormat='{}Acquisition: {0} downloads required'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       IsVisible="{Binding HasMissingDownloads}" />
                            <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.AllCachedLocally}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       IsVisible="{Binding !HasMissingDownloads}" />
                        </StackPanel>

                        <!-- Cancel Button -->
                        <Button Grid.Column="1"
                                Command="{Binding CancelCommand}"
                                Content="{localization:Localize GameProfiles.ImportInspection.Button.Cancel}"
                                Width="90" Height="40"
                                Margin="0,0,12,0"
                                Background="{StaticResource FillWhite08}"
                                BorderBrush="{StaticResource BorderWhite19}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TextPrimary}"
                                CornerRadius="8"
                                FontWeight="Medium"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{StaticResource FillWhite14}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderWhite31}" />
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.98)" />
                                </Style>
                            </Button.Styles>
                        </Button>

                        <!-- Import Button -->
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmImportCommand}"
                                Height="40"
                                Padding="24,0"
                                Background="{DynamicResource PrimaryGradientBrush}"
                                Foreground="White"
                                CornerRadius="8"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsEnabled="{Binding HasValidGameInstallation}"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="RenderTransform" Value="translateY(-1px)" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.98)" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </Style>
                                <Style Selector="Button:disabled">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                          Width="14" Height="14"
                                          Foreground="White"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActionButtonText}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </Grid>

                <!-- Acquisition Progress Overlay (Full Window Frosted Acrylic Backdrop) -->
                <Border Background="{StaticResource ScrimBlack86}"
                        CornerRadius="16"
                        IsVisible="{Binding IsImporting}"
                        ZIndex="1000">
                    <Border Background="{DynamicResource DetailsBackground}"
                            BorderBrush="{DynamicResource BorderHighlightBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="28,24"
                            Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BoxShadow="0 16 48 0 #B0000000">
                        <StackPanel Spacing="16">
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                          Width="20" Height="20"
                                          Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{localization:Localize GameProfiles.ImportInspection.ImportingProgress}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Progress Bar -->
                            <ProgressBar Value="{Binding ImportProgressPercentage}"
                                         Minimum="0" Maximum="100"
                                         Height="8"
                                         CornerRadius="4"
                                         Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}" />

                            <!-- Progress Text -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CurrentOperationName}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ImportProgressPercentage, StringFormat='{}{0}%'}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Cancel -->
                            <Button Command="{Binding CancelCommand}"
                                    Content="{localization:Localize GameProfiles.ImportInspection.Button.CancelImport}"
                                    Height="32"
                                    Padding="16,0"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource FillWhite08}"
                                    BorderBrush="{StaticResource BorderWhite19}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Foreground="{DynamicResource TextSecondary}"
                                    FontSize="11"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Border>

            </Panel>
        </Border>
    </Grid>
</Window>
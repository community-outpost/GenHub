<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
             xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="GenHub.Features.GameProfiles.Views.GameProfileGameSelectionView"
             x:DataType="vm:GameProfileSettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.choice-row">
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="ContentPresenter:nth-last-child(1) > Border.choice-row">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.row-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,24,0,10" />
        </Style>
        <Style Selector="TextBlock.selected-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,0,32,24">
            <TextBlock Classes="row-hint" Text="{localization:Localize GameProfiles.Game.Summary}" />

            <TextBlock Classes="group-header" Text="{localization:Localize GameProfiles.Game.InstallationHeader}" />
            <Border x:Name="InstallationCard" Classes="section-card">
                <StackPanel>
                    <TextBlock Classes="row-hint" Margin="20,16"
                               Text="{localization:Localize GameProfiles.Game.NoInstallations}"
                               IsVisible="{Binding IsGameInstallationListEmpty}" />
                    <ItemsControl ItemsSource="{Binding GameInstallationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileContentRow">
                                <Border Classes="choice-row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="row-label" Text="{Binding Item.DisplayName}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="row-hint" Text="{Binding Item.GameType, Converter={x:Static conv:GameTypeDisplayConverter.Instance}}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Item.InstallationType, Converter={x:Static conv:InstallationTypeDisplayConverter.Instance}}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Item.DisplayVersion}" IsVisible="{Binding Item.HasDisplayVersion}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="selected-label"
                                                   Text="{localization:Localize GameProfiles.Game.Selected}"
                                                   IsVisible="{Binding IsIncluded}" />
                                        <Button Grid.Column="1" Classes="action-secondary"
                                                Content="{localization:Localize GameProfiles.Game.Select}"
                                                IsVisible="{Binding !IsIncluded}"
                                                Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).SelectGameInstallationCommand}"
                                                CommandParameter="{Binding Item}"
                                                AutomationProperties.Name="{Binding Item.DisplayName}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Classes="group-header" Text="{localization:Localize GameProfiles.Game.ClientHeader}" />
            <Border x:Name="ClientCard" Classes="section-card">
                <StackPanel>
                    <TextBlock Classes="row-hint" Margin="20,16"
                               Text="{localization:Localize GameProfiles.Game.NoClients}"
                               IsVisible="{Binding IsGameClientListEmpty}" />
                    <ItemsControl ItemsSource="{Binding GameClientRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileContentRow">
                                <Border Classes="choice-row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="row-label" Text="{Binding Item.DisplayName}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="row-hint" Text="{Binding Item.Publisher}" IsVisible="{Binding Item.Publisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Item.DisplayVersion}" IsVisible="{Binding Item.HasDisplayVersion}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="selected-label"
                                                   Text="{localization:Localize GameProfiles.Game.Selected}"
                                                   IsVisible="{Binding IsIncluded}" />
                                        <Button Grid.Column="1" Classes="action-secondary"
                                                Content="{localization:Localize GameProfiles.Game.Select}"
                                                IsVisible="{Binding !IsIncluded}"
                                                Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).SelectGameClientCommand}"
                                                CommandParameter="{Binding Item}"
                                                AutomationProperties.Name="{Binding Item.DisplayName}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

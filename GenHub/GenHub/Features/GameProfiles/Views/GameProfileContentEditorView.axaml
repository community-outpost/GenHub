<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
             xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
             xmlns:models="clr-namespace:GenHub.Core.Models.Enums;assembly=GenHub.Core"
             x:Class="GenHub.Features.GameProfiles.Views.GameProfileContentEditorView"
             x:DataType="vm:GameProfileSettingsViewModel">
    <UserControl.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter" />
        <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="4,4,14,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Content" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Choose the maps, mods, and add-ons this profile should use." FontSize="13" Opacity="0.72" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋  Import local folder" Classes="btn-secondary"
                        Command="{Binding AddLocalContentCommand}"
                        ToolTip.Tip="Register content from a folder on disk" />
            </Grid>

            <Border Classes="section-card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Content for selected game" Margin="0" />
                            <TextBlock Text="Check an item to include it in this profile. Unchecking it only removes it from this profile." FontSize="12" Opacity="0.72" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="↻  Refresh" Classes="btn-secondary"
                                Command="{Binding LoadAvailableContentCommand}" ToolTip.Tip="Reload the available content list" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                        <Button Content="Mods" Classes="filter-pill"
                                Classes.selected="{Binding SelectedContentType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ContentType.Mod}}"
                                Command="{Binding SelectContentTypeFilterCommand}" CommandParameter="{x:Static models:ContentType.Mod}" />
                        <Button Content="Maps" Classes="filter-pill"
                                Classes.selected="{Binding SelectedContentType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ContentType.Map}}"
                                Command="{Binding SelectContentTypeFilterCommand}" CommandParameter="{x:Static models:ContentType.Map}" />
                        <Button Content="Add-ons" Classes="filter-pill"
                                Classes.selected="{Binding SelectedContentType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ContentType.Addon}}"
                                Command="{Binding SelectContentTypeFilterCommand}" CommandParameter="{x:Static models:ContentType.Addon}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,240,Auto" Margin="8,0,12,0">
                        <TextBlock Text="ITEM" FontSize="10" FontWeight="Bold" LetterSpacing="1" Opacity="0.58" />
                        <TextBlock Grid.Column="1" Text="VERSION / SOURCE" FontSize="10" FontWeight="Bold" LetterSpacing="1" Opacity="0.58" />
                        <TextBlock Grid.Column="2" Text="IN PROFILE" FontSize="10" FontWeight="Bold" LetterSpacing="1" Opacity="0.58" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ProfileContentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentDisplayItem">
                                <Border Background="#08FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,2">
                                    <Grid ColumnDefinitions="*,240,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}" FontSize="12" Opacity="0.7" IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding Publisher}" FontSize="12" Opacity="0.7" IsVisible="{Binding Publisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="Local folder" FontSize="12" Opacity="0.7" IsVisible="{Binding IsEditable}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="Edit" Classes="btn-edit" IsVisible="{Binding IsEditable}"
                                                    Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).EditContentCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete" Classes="btn-delete" IsVisible="{Binding IsEditable}"
                                                    Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).DeleteContentCommand}"
                                                    CommandParameter="{Binding}" />
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                                      Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).ToggleProfileContentCommand}"
                                                      CommandParameter="{Binding}" AutomationProperties.Name="Include this item in the profile" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#10000000" CornerRadius="8" Padding="14"
                            IsVisible="{Binding ProfileContentItems.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                        <TextBlock Text="No matching items. Try another category or refresh the list." FontSize="12" Opacity="0.76" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

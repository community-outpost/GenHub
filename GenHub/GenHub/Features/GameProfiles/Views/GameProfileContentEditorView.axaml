<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
             xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="GenHub.Features.GameProfiles.Views.GameProfileContentEditorView"
             x:DataType="vm:GameProfileSettingsViewModel">

    <UserControl.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter" />
        <DataTemplate x:Key="ProfileContentSortOrderTemplate" x:DataType="vm:ProfileContentSortOrder">
            <Panel>
                <TextBlock Text="{localization:Localize GameProfiles.Content.SortByName}"
                           IsVisible="{Binding Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.Name}}" />
                <TextBlock Text="{localization:Localize GameProfiles.Content.SortByReleaseDate}"
                           IsVisible="{Binding Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.ReleaseDate}}" />
                <TextBlock Text="{localization:Localize GameProfiles.Content.SortByEnabled}"
                           IsVisible="{Binding Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.EnabledFirst}}" />
                <TextBlock Text="{localization:Localize GameProfiles.Content.SortByType}"
                           IsVisible="{Binding Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.Type}}" />
            </Panel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.content-row">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="ContentPresenter:nth-last-child(1) > Border.content-row">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.row-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="ContentEditorScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  BringIntoViewOnFocusChange="False">
        <StackPanel Margin="32,0,32,24" Spacing="16">
            <TextBlock Classes="row-hint" Text="{localization:Localize GameProfiles.Content.Summary}" />

            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <ComboBox x:Name="ContentTypeFilter"
                          Classes="form-field"
                          MinWidth="200"
                          ItemsSource="{x:Static vm:GameProfileSettingsViewModel.ProfileContentFilterOptions}"
                          SelectedItem="{Binding SelectedProfileContentFilter}"
                          AutomationProperties.Name="{localization:Localize GameProfiles.Content.FilterLabel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileContentFilterOption">
                            <Panel>
                                <TextBlock Text="{localization:Localize GameProfiles.Content.FilterAll}" IsVisible="{Binding IsAll}" />
                                <TextBlock Text="{localization:Localize Downloads.Filter.Mods}"
                                           IsVisible="{Binding Group, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentGroup.Mods}}" />
                                <TextBlock Text="{localization:Localize Downloads.Browser.Filter.Category.Maps}"
                                           IsVisible="{Binding Group, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentGroup.Maps}}" />
                                <TextBlock Text="{localization:Localize Downloads.Filter.Addons}"
                                           IsVisible="{Binding Group, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentGroup.Addons}}" />
                                <TextBlock Text="{localization:Localize Downloads.Browser.Filter.Category.Tools}"
                                           IsVisible="{Binding Group, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentGroup.Tools}}" />
                            </Panel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ContentSortButton"
                        Grid.Column="1"
                        Classes="action-secondary library-action"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="{localization:Localize GameProfiles.Content.SortLabel}"
                        AutomationProperties.HelpText="{Binding SelectedProfileContentSort, Converter={x:Static conv:LocalizedProfileContentSortOrderConverter.Instance}}">
                    <ToolTip.Tip>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{localization:Localize GameProfiles.Content.SortLabel}" />
                            <ContentControl Content="{Binding SelectedProfileContentSort}"
                                            ContentTemplate="{StaticResource ProfileContentSortOrderTemplate}" />
                        </StackPanel>
                    </ToolTip.Tip>
                    <material:MaterialIcon Kind="Sort" Width="16" Height="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{localization:Localize GameProfiles.Content.SortByName}"
                                      Command="{Binding SetProfileContentSortCommand}"
                                      CommandParameter="{x:Static vm:ProfileContentSortOrder.Name}"
                                      ToggleType="Radio"
                                      IsChecked="{Binding SelectedProfileContentSort, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.Name}}" />
                            <MenuItem Header="{localization:Localize GameProfiles.Content.SortByReleaseDate}"
                                      Command="{Binding SetProfileContentSortCommand}"
                                      CommandParameter="{x:Static vm:ProfileContentSortOrder.ReleaseDate}"
                                      ToggleType="Radio"
                                      IsChecked="{Binding SelectedProfileContentSort, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.ReleaseDate}}" />
                            <MenuItem Header="{localization:Localize GameProfiles.Content.SortByEnabled}"
                                      Command="{Binding SetProfileContentSortCommand}"
                                      CommandParameter="{x:Static vm:ProfileContentSortOrder.EnabledFirst}"
                                      ToggleType="Radio"
                                      IsChecked="{Binding SelectedProfileContentSort, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.EnabledFirst}}" />
                            <MenuItem Header="{localization:Localize GameProfiles.Content.SortByType}"
                                      Command="{Binding SetProfileContentSortCommand}"
                                      CommandParameter="{x:Static vm:ProfileContentSortOrder.Type}"
                                      IsVisible="{Binding IsTypeSortAvailable}"
                                      ToggleType="Radio"
                                      IsChecked="{Binding SelectedProfileContentSort, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileContentSortOrder.Type}}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2"
                        Classes="icon-action"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding RefreshProfileContentCommand}"
                        ToolTip.Tip="{localization:Localize GameProfiles.Content.RefreshInstalledTip}"
                        AutomationProperties.Name="{localization:Localize GameProfiles.Content.RefreshInstalledTip}">
                    <material:MaterialIcon Kind="Refresh" />
                </Button>
                <Button Grid.Column="3"
                        Classes="action-secondary"
                        Command="{Binding AddLocalContentCommand}"
                        ToolTip.Tip="{localization:Localize GameProfiles.Content.AddLocalTooltip}"
                        AutomationProperties.Name="{localization:Localize GameProfiles.Content.AddLocalButton}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="FolderPlusOutline" />
                        <TextBlock Text="{localization:Localize GameProfiles.Content.AddLocalButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="ContentChecklist" Classes="section-card">
                <StackPanel>
                    <TextBlock Classes="row-hint" Margin="20,16"
                               Text="{localization:Localize GameProfiles.Content.Empty}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsProfileContentEmpty" />
                                <Binding Path="SelectedProfileContentFilter.IsAll" FallbackValue="True" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock Classes="row-hint" Margin="20,16"
                               Text="{localization:Localize GameProfiles.Content.EmptyGroup}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsProfileContentEmpty" />
                                <Binding Path="!SelectedProfileContentFilter.IsAll" FallbackValue="False" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ProfileContentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileContentRow">
                                <Border Classes="content-row">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="row-label" Text="{Binding Item.DisplayName}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="row-hint" Text="{Binding Item.ContentType, Converter={x:Static conv:ContentTypeDisplayConverter.Instance}}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Item.Publisher}" IsVisible="{Binding Item.Publisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Item.DisplayVersion}" IsVisible="{Binding Item.HasDisplayVersion}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="icon-action"
                                                Margin="12,0"
                                                IsVisible="{Binding Item.IsEditable}"
                                                Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).EditContentCommand}"
                                                CommandParameter="{Binding Item}"
                                                ToolTip.Tip="{localization:Localize GameProfiles.Content.EditContentToolTip}"
                                                AutomationProperties.Name="{localization:Localize GameProfiles.Content.EditContentToolTip}">
                                            <material:MaterialIcon Kind="PencilOutline" />
                                        </Button>
                                        <CheckBox Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsIncluded, Mode=OneWay}"
                                                  IsEnabled="{Binding Item.CanToggle}"
                                                  Command="{Binding $parent[ItemsControl].((vm:GameProfileSettingsViewModel)DataContext).ToggleProfileContentCommand}"
                                                  CommandParameter="{Binding Item}"
                                                  ToolTip.Tip="{localization:Localize GameProfiles.Content.IncludeToolTip}"
                                                  AutomationProperties.Name="{Binding Item.DisplayName}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

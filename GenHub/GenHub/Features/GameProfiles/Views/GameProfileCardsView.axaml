<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
    xmlns:views="clr-namespace:GenHub.Features.GameProfiles.Views"
    xmlns:localization="clr-namespace:GenHub.Common.Markup"
    xmlns:local="clr-namespace:GenHub.Features.GameProfiles.Views"
    xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
    xmlns:enums="clr-namespace:GenHub.Core.Models.Enums;assembly=GenHub.Core"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
    x:Class="GenHub.Features.GameProfiles.Views.GameProfileCardsView"
    x:Name="ProfileCards"
    x:DataType="vm:GameProfileLauncherViewModel"
    x:CompileBindings="True">

    <UserControl.Resources>
        <x:Double x:Key="ExpandedHeight">100.0</x:Double>
        <x:Double x:Key="CollapsedHeight">0.0</x:Double>
        <x:Double x:Key="FullOpacity">1.0</x:Double>
        <x:Double x:Key="ZeroOpacity">0.0</x:Double>

        <conv:BoolToValueConverter x:Key="HeaderMaxHeightConverter"
                                   TrueValue="{StaticResource ExpandedHeight}"
                                   FalseValue="{StaticResource CollapsedHeight}" />
        <conv:BoolToValueConverter x:Key="HeaderOpacityConverter"
                                   TrueValue="{StaticResource FullOpacity}"
                                   FalseValue="{StaticResource ZeroOpacity}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Profile card styles -->
        <Style Selector="Border.profile-card">
            <Setter Property="Background" Value="#222228" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Margin" Value="0 0 20 20" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="300" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #30000000" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.profile-card:pointerover">
            <Setter Property="BoxShadow" Value="0 8 20 0 #40000000" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Button styles -->
        <Style Selector="Button.launch-button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Background" Value="#44000000" />
        </Style>

        <!-- Plus button style -->
        <Style Selector="Button.add-profile-button">
            <Setter Property="Background" Value="#10FFFFFF" /> <!-- Subtle glass -->
            <Setter Property="Width" Value="300" />
            <Setter Property="Height" Value="220" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Margin" Value="6" /> <!-- Margin matches standard cards -->
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                        <BrushTransition Property="Background" Duration="0:0:0.2" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.add-profile-button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
        </Style>

        <Style Selector="TextBlock.badge-text">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" PointerMoved="RootLayout_PointerMoved" PointerPressed="RootLayout_PointerPressed">
        <!-- Row 0: Collapsible Header Container -->
        <!-- Collapses to zero height when hidden so the profile list sits flush at the top. -->
        <!-- Hover/tap-to-expand is tracked by pointer position, which reserves no layout space. -->
        <Grid Grid.Row="0"
              Background="Transparent"
              PointerEntered="HeaderZone_PointerEntered"
              PointerExited="HeaderZone_PointerExited">
            <!-- Animated Header Content -->
            <Border Classes="header-container" ClipToBounds="True">
                <Border.Styles>
                    <Style Selector="Border.header-container">
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="MaxHeight" Duration="0:0:0.4" Easing="CubicEaseOut" />
                                <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut" />
                            </Transitions>
                        </Setter>
                    </Style>
                </Border.Styles>

                <!-- Use HeaderMaxHeightConverter and HeaderOpacityConverter -->
                <Border.MaxHeight>
                    <Binding Path="IsHeaderExpanded" Converter="{StaticResource HeaderMaxHeightConverter}" />
                </Border.MaxHeight>

                <Border.Opacity>
                    <Binding Path="IsHeaderExpanded" Converter="{StaticResource HeaderOpacityConverter}" />
                </Border.Opacity>

                <StackPanel Margin="0,0,0,10">
                    <!-- Title and Info -->
                    <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,8">
                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="{localization:Localize GameProfiles.Title.GameProfiles}" FontSize="20" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}" Margin="0 0 0 4" />
                            <TextBlock Text="{localization:Localize GameProfiles.Subtitle.GameProfiles}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Panel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Import Profile Button -->
                                    <Button Command="{Binding ImportProfileCommand}"
                                            Content="{localization:Localize GameProfiles.Launcher.Button.Import}"
                                            Classes="outline"
                                            ToolTip.Tip="{localization:Localize GameProfiles.Launcher.Tooltip.Import}"
                                            IsVisible="{Binding !IsScanning}" />

                                    <!-- Scan Button -->
                                    <Button Command="{Binding ScanForGamesCommand}"
                                            Content="{localization:Localize GameProfiles.Button.Scan}"
                                            Classes="outline"
                                            IsVisible="{Binding !IsScanning}" />

                                    <!-- Sort Dropdown -->
                                    <ComboBox x:Name="SortModeComboBox"
                                              ItemsSource="{Binding AvailableSortModes}"
                                              SelectedItem="{Binding SelectedSortModeItem}"
                                              ToolTip.Tip="{localization:Localize GameProfiles.Launcher.Tooltip.Sort}"
                                              VerticalAlignment="Center"
                                              Width="140"
                                              DropDownOpened="SortModeComboBox_DropDownOpened"
                                              DropDownClosed="SortModeComboBox_DropDownClosed"
                                              IsVisible="{Binding !IsScanning}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GameProfileLauncherViewModel+ProfileSortOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding !IsScanning}">
                                        <Button Classes="library-action layout-toggle"
                                                Classes.selected="{Binding IsLibraryLayout}"
                                                Command="{Binding SetProfileLayoutCommand}"
                                                CommandParameter="{x:Static enums:ProfileLayout.Library}"
                                                ToolTip.Tip="{localization:Localize GameProfiles.Layout.Library}"
                                                AutomationProperties.Name="{localization:Localize GameProfiles.Layout.Library}">
                                            <material:MaterialIcon Kind="ViewList" Width="16" Height="16"/>
                                        </Button>
                                        <Button Classes="library-action layout-toggle"
                                                Classes.selected="{Binding IsCardLayout}"
                                                Command="{Binding SetProfileLayoutCommand}"
                                                CommandParameter="{x:Static enums:ProfileLayout.Cards}"
                                                ToolTip.Tip="{localization:Localize GameProfiles.Layout.Cards}"
                                                AutomationProperties.Name="{localization:Localize GameProfiles.Layout.Cards}">
                                            <material:MaterialIcon Kind="ViewGrid" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Loading UI -->
                                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsScanning}">
                                    <TextBlock Text="{localization:Localize GameProfiles.Status.Scanning}"
                                               VerticalAlignment="Center"
                                               Foreground="#DDDDDD"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="120"
                                                 Height="2"
                                                 VerticalAlignment="Center"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Panel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 1: Main Content (Game Profiles List) -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- First-run prompt to scan, shown before any scan has completed -->
                <Border IsVisible="{Binding ShouldShowScanPrompt}"
                        Background="{DynamicResource SurfaceCardDarkBrush}"
                        BorderBrush="{DynamicResource BorderSubtleDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24,20"
                        Margin="20,10,20,24"
                        MaxWidth="840"
                        HorizontalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{localization:Localize GameProfiles.ScanPrompt.Title}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{localization:Localize GameProfiles.ScanPrompt.Description}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="accent"
                                Command="{Binding ScanForGamesCommand}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Margin="16,0,0,0"
                                Padding="14,8">
                            <TextBlock Text="{localization:Localize GameProfiles.ScanPrompt.Button}" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Failed scan: explains the failure and offers a manual folder choice -->
                <Border IsVisible="{Binding ShouldShowScanFailure}"
                        Background="{DynamicResource SurfaceCardDarkBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24,20"
                        Margin="20,10,20,24"
                        MaxWidth="840"
                        HorizontalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{localization:Localize GameProfiles.ScanFailure.Title}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{localization:Localize GameProfiles.ScanFailure.Description}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Expander Header="{localization:Localize GameProfiles.ScanFailure.Details}"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch">
                                <SelectableTextBlock Text="{Binding ScanFailureMessage}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap" />
                            </Expander>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Classes="accent"
                                    Command="{Binding ChooseGameFolderCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,8">
                                <TextBlock Text="{localization:Localize GameProfiles.ScanFailure.ChooseFolderButton}" VerticalAlignment="Center" />
                            </Button>

                            <Button Classes="outline"
                                    Command="{Binding ScanForGamesCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,8">
                                <TextBlock Text="{localization:Localize GameProfiles.ScanFailure.RetryButton}" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Storefront purchase banner, shown only after a completed scan found no installation -->
                <Border IsVisible="{Binding ShouldShowStorefrontBanner}"
                        Background="{DynamicResource SurfaceCardDarkBrush}"
                        BorderBrush="{DynamicResource BorderSubtleDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24,20"
                        Margin="20,10,20,24"
                        MaxWidth="840"
                        HorizontalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{localization:Localize GameProfiles.Storefront.BannerTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{localization:Localize GameProfiles.Storefront.BannerDescription}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Classes="accent"
                                    Command="{Binding ChooseGameFolderCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8">
                                <TextBlock Text="{localization:Localize GameProfiles.ScanFailure.ChooseFolderButton}" />
                            </Button>

                            <Button Classes="outline"
                                    Command="{Binding OpenSteamStoreCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,8">
                                <TextBlock Text="{localization:Localize GameProfiles.Storefront.SteamButton}" VerticalAlignment="Center" />
                            </Button>

                            <Button Classes="outline"
                                    Command="{Binding OpenEaStoreCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,8">
                                <TextBlock Text="{localization:Localize GameProfiles.Storefront.EaAppButton}" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Wrap panel for responsive layout -->
                            <WrapPanel Orientation="Horizontal"
                                      HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.DataTemplates>
                        <!-- Template for Add New Profile Item (Must be first to match subclass) -->
                        <DataTemplate DataType="vm:AddProfileItemViewModel">
                            <Button Classes="add-profile-button"
                                    Command="{Binding $parent[ItemsControl].((vm:GameProfileLauncherViewModel)DataContext).CreateNewProfileCommand}">
                                <StackPanel Spacing="12">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#1A000000" BorderBrush="#30FFFFFF" BorderThickness="1">
                                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                            Foreground="White"
                                            Opacity="0.7"
                                            Width="24"
                                            Height="24" />
                                    </Border>
                                    <TextBlock Text="{localization:Localize GameProfiles.Button.AddNewProfile}"
                                        Foreground="White"
                                        Opacity="0.7"
                                        FontWeight="SemiBold"
                                        FontSize="14" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>

                        <!-- Template for Profile Items -->
                        <DataTemplate DataType="vm:GameProfileItemViewModel">
                            <views:GameProfileCardView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

            <Grid ColumnDefinitions="*,Auto" Classes="section-header-row">
                <TextBlock Classes="section-header" Text="{localization:Localize GameSettings.Section.Camera}" />
                <Button Grid.Column="1" Classes="action-secondary" VerticalAlignment="Bottom" Margin="0,0,0,6" IsVisible="{Binding IsCustomCameraVisible}" Command="{Binding ResetCameraDefaultsCommand}"
                        ToolTip.Tip="{localization:Localize GameSettings.Camera.ResetDefaultsToolTip}" AutomationProperties.Name="{localization:Localize GameSettings.Camera.ResetDefaults}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource RefreshIcon}" VerticalAlignment="Center" />
                        <TextBlock Text="{localization:Localize GameSettings.Camera.ResetDefaults}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel IsVisible="{Binding IsCustomCameraVisible}">
                <Border Classes="settings-card setting-row" ToolTip.Tip="{localization:Localize GameSettings.Camera.HeightToolTip}">

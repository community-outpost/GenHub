                    <NumericUpDown Grid.Column="1" Classes="row-control" Value="{Binding TshSystemTimeFontSize}" Minimum="8" Maximum="32" AutomationProperties.Name="{localization:Localize GameSettings.Tsh.SystemTime}" />
                </Grid>

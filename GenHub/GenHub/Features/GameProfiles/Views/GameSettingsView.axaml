            <StackPanel IsVisible="{Binding IsTheSuperHackersVisible}">
                <TextBlock Classes="group-label" Text="{localization:Localize GameSettings.Tsh.CursorCapture}" ToolTip.Tip="{localization:Localize GameSettings.Tsh.CursorCaptureToolTip}" />
                <Border Classes="settings-card setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Tsh.FullscreenGame}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding TshCursorCaptureEnabledInFullscreenGame}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{localization:Localize GameSettings.Tsh.FullscreenGame}" />
                    </Grid>
                </Border>
                <Border Classes="settings-card setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Tsh.FullscreenMenu}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding TshCursorCaptureEnabledInFullscreenMenu}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{localization:Localize GameSettings.Tsh.FullscreenMenu}" />
                    </Grid>
                </Border>
                <Border Classes="settings-card setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Tsh.WindowedGame}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding TshCursorCaptureEnabledInWindowedGame}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{localization:Localize GameSettings.Tsh.WindowedGame}" />
                    </Grid>

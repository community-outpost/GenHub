                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="2*" MaxWidth="324" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Tsh.TransitionSpeed}" />

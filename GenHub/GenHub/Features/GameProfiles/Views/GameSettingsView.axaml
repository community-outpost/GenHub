<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
             xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
             xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="2800"
             x:Class="GenHub.Features.GameProfiles.Views.GameSettingsView"
             x:DataType="vm:GameSettingsViewModel">

    <UserControl.Resources>
        <conv:ThemeBackgroundConverter x:Key="ThemeBackgroundConverter" />
        <conv:ThemeBorderConverter x:Key="ThemeBorderConverter" />
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:EqualityConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" MinWidth="68" MaxWidth="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#10000000"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,0,1,0"
                Padding="12,24"
                ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="2">
                    <Button Classes="sidebar-btn"
                            Classes.selected="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SettingsCategory.Video}}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static vm:SettingsCategory.Video}"
                            ToolTip.Tip="{localization:Localize GameSettings.Category.Video}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16C1,17.11 1.89,18 3,18H10V20H8V22H16V20H14V18H21C22.11,18 23,17.11 23,16V4C23,2.89 22.11,2 21,2Z" />
                            <TextBlock Text="{localization:Localize GameSettings.Category.Video}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="sidebar-btn"
                            Classes.selected="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SettingsCategory.Audio}}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static vm:SettingsCategory.Audio}"
                            ToolTip.Tip="{localization:Localize GameSettings.Category.Audio}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.85 14,18.71V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16.03C15.5,15.29 16.5,13.77 16.5,12M3,9V15H7L12,20V4L7,9H3Z" />
                            <TextBlock Text="{localization:Localize GameSettings.Category.Audio}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="sidebar-btn"
                            Classes.selected="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SettingsCategory.Controls}}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static vm:SettingsCategory.Controls}"
                            ToolTip.Tip="{localization:Localize GameSettings.Category.Controls}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="M19,10H5A2,2 0 0,0 3,12V16A2,2 0 0,0 5,18H19A2,2 0 0,0 21,16V12C21,10.89 20.1,10 19,10M5,12H7V14H5V12M5,16V15H7V16H5M9,16V15H11V16H9M9,14V12H11V14H9M19,16H13V15H19V16M19,14H13V12H19V14Z" />
                            <TextBlock Text="{localization:Localize GameSettings.Category.Controls}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="sidebar-btn"
                            Classes.selected="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SettingsCategory.TheSuperHackers}}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static vm:SettingsCategory.TheSuperHackers}"
                            ToolTip.Tip="{localization:Localize GameSettings.Category.TheSuperHackers}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="avares://GenHub/Assets/Logos/thesuperhackers-logo.png" Width="18" Height="18" />
                            <TextBlock Text="{localization:Localize GameSettings.Category.TheSuperHackers}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="sidebar-btn"
                            Classes.selected="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SettingsCategory.GeneralsOnline}}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static vm:SettingsCategory.GeneralsOnline}"
                            ToolTip.Tip="{localization:Localize GameSettings.Category.GeneralsOnline}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="avares://GenHub/Assets/Logos/generalsonline-logo.png" Width="18" Height="18" />
                            <TextBlock Text="{localization:Localize GameSettings.Category.GeneralsOnline}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Resizer -->
        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

        <!-- Right Content Area -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="2" Padding="0,24,0,80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BringIntoViewOnFocusChange="False">
            <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- VIDEO SECTION -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Control x:Name="VideoSection" Height="1" Margin="0,-1,0,0" />
                <Border Classes="settings-card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="section-header" Text="{localization:Localize GameSettings.Video.Title}" />

                        <Grid ColumnDefinitions="1* ,24 ,1*" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Video.Resolution}" />
                                <ComboBox ItemsSource="{Binding ResolutionPresets}" SelectedItem="{Binding SelectedResolutionPreset}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Video.DetailLevel}" />
                                <ComboBox ItemsSource="{Binding LodOptions}" SelectedItem="{Binding StaticGameLOD}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="1* ,24 ,1*" Margin="0,0,0,12" >
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Video.TextureQuality}" />
                                <ComboBox ItemsSource="{x:Static vm:GameSettingsViewModel.TextureQualityValues}" SelectedItem="{Binding TextureQuality}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Video.Brightness}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Value="{Binding Gamma}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding Gamma}" Minimum="0" Maximum="100" Classes="slider-input" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="1* ,24 ,1*" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Video.AntiAliasing}" />
                                <ComboBox ItemsSource="{Binding AaOptions}" SelectedItem="{Binding AntiAliasing}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Video.MaxParticleCount}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Value="{Binding MaxParticleCount}" Minimum="100" Maximum="10000" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding MaxParticleCount}" Minimum="100" Maximum="10000" Increment="100" Classes="slider-input" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="1* ,24 ,1*" Margin="0,8,0,0">
                            <CheckBox Content="{localization:Localize GameSettings.Video.WindowedMode}" IsChecked="{Binding Windowed}" />
                            <CheckBox Grid.Column="2" Content="{localization:Localize GameSettings.Video.DynamicLod}" IsChecked="{Binding DynamicLOD}" />
                        </Grid>

                        <!-- Section: Advanced Display Options (Conditional) -->
                        <StackPanel Spacing="0" IsVisible="{Binding IsCustomLodSelected}">
                            <Separator Background="#20FFFFFF" Height="1" Margin="0,8" />
                            <TextBlock Text="{localization:Localize GameSettings.Video.AdvancedDisplayOptions}" FontWeight="SemiBold" FontSize="13" Opacity="0.8" Margin="0,0,0,12" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="{localization:Localize GameSettings.Video.3DShadows}" IsChecked="{Binding Shadows}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.2DShadows}" IsChecked="{Binding UseShadowDecals}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.CloudShadows}" IsChecked="{Binding UseCloudMap}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.ExtraGroundLighting}" IsChecked="{Binding UseLightMap}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.SmoothWaterBorders}" IsChecked="{Binding ShowSoftWaterEdge}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.BehindBuildings}" IsChecked="{Binding BuildingOcclusion}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.HeatEffects}" IsChecked="{Binding HeatEffects}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.BuildingAnimations}" IsChecked="{Binding BuildingAnimations}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.ExtraAnimations}" IsChecked="{Binding ExtraAnimations}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.ParticleEffects}" IsChecked="{Binding ParticleEffects}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.ShowProps}" IsChecked="{Binding ShowProps}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Video.ShowTrees}" IsChecked="{Binding ShowTrees}" Margin="0,0,24,8" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- AUDIO SECTION -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Control x:Name="AudioSection" Height="1" Margin="0,-1,0,0" />
                <Border Classes="settings-card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="section-header" Text="{localization:Localize GameSettings.Audio.Title}" />
                        <CheckBox Content="{localization:Localize GameSettings.Audio.AudioEnabled}" IsChecked="{Binding AudioEnabled}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <StackPanel IsEnabled="{Binding AudioEnabled}" Spacing="16">
                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Audio.SoundVolume}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding SoundVolume}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding SoundVolume}" Minimum="0" Maximum="100" Classes="slider-input" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Audio.ThreeDSoundVolume}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding ThreeDSoundVolume}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding ThreeDSoundVolume}" Minimum="0" Maximum="100" Classes="slider-input" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Audio.MusicVolume}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding MusicVolume}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding MusicVolume}" Minimum="0" Maximum="100" Classes="slider-input" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Audio.SpeechVolume}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding SpeechVolume}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding SpeechVolume}" Minimum="0" Maximum="100" Classes="slider-input" />
                            </Grid>

                            <Separator Background="#20FFFFFF" Height="1" />

                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Audio.AudioChannels}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding NumSounds}" Minimum="16" Maximum="64" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding NumSounds}" Minimum="16" Maximum="64" Classes="slider-input" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- CONTROLS SECTION -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Control x:Name="ControlsSection" Height="1" Margin="0,-1,0,0" />
                <Border Classes="settings-card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="section-header" Text="{localization:Localize GameSettings.Controls.Title}" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" MinWidth="0" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{localization:Localize GameSettings.Controls.ScrollSpeed}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Slider Grid.Column="1" Value="{Binding ScrollFactor}" Minimum="0" Maximum="200" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <NumericUpDown Grid.Column="2" Value="{Binding ScrollFactor}" Minimum="0" Maximum="200" Classes="slider-input" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <CheckBox Content="{localization:Localize GameSettings.Controls.AlternateMouseSetup}" IsChecked="{Binding AlternateMouseSetup}" Margin="0,0,24,8" />
                            <CheckBox Content="{localization:Localize GameSettings.Controls.DoubleClickAttack}" IsChecked="{Binding UseDoubleClickAttackMove}" Margin="0,0,24,8" />
                            <CheckBox Content="{localization:Localize GameSettings.Controls.AutoRetaliation}" IsChecked="{Binding Retaliation}" Margin="0,0,24,8" />
                            <CheckBox Content="{localization:Localize GameSettings.Controls.FastSendDelay}" IsChecked="{Binding SendDelay}" Margin="0,0,24,8" />
                            <CheckBox Content="{localization:Localize GameSettings.Controls.DrawScrollAnchor}" IsChecked="{Binding DrawScrollAnchor}" Margin="0,0,24,8" />
                            <CheckBox Content="{localization:Localize GameSettings.Controls.MoveScrollAnchor}" IsChecked="{Binding MoveScrollAnchor}" Margin="0,0,24,8" />
                            <CheckBox Content="{localization:Localize GameSettings.Controls.LanguageFilter}" IsChecked="{Binding LanguageFilter}" Margin="0,0,24,8" />
                        </WrapPanel>

                        <Separator Background="#20FFFFFF" Height="1" />

                        <Grid ColumnDefinitions="180,*,Auto">
                            <TextBlock Text="{localization:Localize GameSettings.Controls.GameTimeFontSize}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Slider Grid.Column="1" Value="{Binding GameTimeFontSize}" Minimum="8" Maximum="24" VerticalAlignment="Center" Margin="10,0,12,0" />
                            <NumericUpDown Grid.Column="2" Value="{Binding GameTimeFontSize}" Minimum="8" Maximum="24" Classes="slider-input" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- THE SUPER HACKERS SECTION -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Control x:Name="TheSuperHackersSection" Height="1" Margin="0,-1,0,0" />
                <Border Classes="settings-card">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="section-header" Text="{localization:Localize GameSettings.Tsh.Title}" />

                        <StackPanel Spacing="12">
                            <TextBlock Text="{localization:Localize GameSettings.Tsh.GeneralFeatures}" FontWeight="SemiBold" FontSize="13" Opacity="0.8" />
                            <WrapPanel HorizontalAlignment="Left">
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.ArchiveReplays}" IsChecked="{Binding TshArchiveReplays}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.ShowMoneyPerMin}" IsChecked="{Binding TshShowMoneyPerMinute}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.ObserverMode}" IsChecked="{Binding TshPlayerObserverEnabled}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.SkipIntro}" IsChecked="{Binding SkipEALogo}" Margin="0,0,24,8" />
                            </WrapPanel>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <TextBlock Text="{localization:Localize GameSettings.Tsh.CursorCapture}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                            <WrapPanel HorizontalAlignment="Left">
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.FullscreenGame}" IsChecked="{Binding TshCursorCaptureEnabledInFullscreenGame}" Margin="0,0,20,4" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.FullscreenMenu}" IsChecked="{Binding TshCursorCaptureEnabledInFullscreenMenu}" Margin="0,0,20,4" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.WindowedGame}" IsChecked="{Binding TshCursorCaptureEnabledInWindowedGame}" Margin="0,0,20,4" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.WindowedMenu}" IsChecked="{Binding TshCursorCaptureEnabledInWindowedMenu}" Margin="0,0,20,4" />
                            </WrapPanel>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <TextBlock Text="{localization:Localize GameSettings.Tsh.ScreenEdgeScroll}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                            <WrapPanel HorizontalAlignment="Left">
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.InFullscreen}" IsChecked="{Binding TshScreenEdgeScrollEnabledInFullscreenApp}" Margin="0,0,24,4" />
                                <CheckBox Content="{localization:Localize GameSettings.Tsh.InWindowed}" IsChecked="{Binding TshScreenEdgeScrollEnabledInWindowedApp}" Margin="0,0,24,4" />
                            </WrapPanel>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <TextBlock Text="{localization:Localize GameSettings.Tsh.InterfaceFontSizes}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                            <Grid ColumnDefinitions="*,24,*" Margin="0,0,0,8">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Tsh.SystemTime}" />
                                    <NumericUpDown Value="{Binding TshSystemTimeFontSize}" Minimum="8" Maximum="32" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Tsh.PingDisplay}" />
                                    <NumericUpDown Value="{Binding TshNetworkLatencyFontSize}" Minimum="8" Maximum="32" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,24,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Tsh.FpsDisplay}" />
                                    <NumericUpDown Value="{Binding TshRenderFpsFontSize}" Minimum="8" Maximum="32" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Tsh.ResolutionFontOffset}" />
                                    <NumericUpDown Value="{Binding TshResolutionFontAdjustment}" Minimum="-500" Maximum="500" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Tsh.TransactionVolume}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding TshMoneyTransactionVolume}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding TshMoneyTransactionVolume}" Minimum="0" Maximum="100" Classes="slider-input" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Tsh.TransitionSpeed}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding TshGameWindowTransitionSpeedMultiplier}" Minimum="1.0" Maximum="4.0" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding TshGameWindowTransitionSpeedMultiplier}" Minimum="1.0" Maximum="4.0" Increment="0.05" FormatString="F2" Classes="slider-input" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- GENERALS ONLINE SECTION -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Control x:Name="GeneralsOnlineSection" Height="1" Margin="0,-1,0,0" />
                <Border Classes="settings-card">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="section-header" Text="{localization:Localize GameSettings.Go.Title}" />

                        <StackPanel Spacing="12">
                            <TextBlock Text="{localization:Localize GameSettings.Go.IdentityAndLogin}" FontWeight="SemiBold" FontSize="13" Opacity="0.8" />
                            <WrapPanel HorizontalAlignment="Left">
                                <CheckBox Content="{localization:Localize GameSettings.Go.AutoLogin}" IsChecked="{Binding GoAutoLogin}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.RememberMe}" IsChecked="{Binding GoRememberUsername}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.ShowRanks}" IsChecked="{Binding GoShowPlayerRanks}" Margin="0,0,24,8" />
                            </WrapPanel>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <TextBlock Text="{localization:Localize GameSettings.Go.PerformanceAndVisuals}" FontWeight="SemiBold" FontSize="13" Opacity="0.8" />
                            <WrapPanel HorizontalAlignment="Left">
                                <CheckBox Content="{localization:Localize GameSettings.Go.FpsCap}" IsChecked="{Binding GoRenderLimitFramerate}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.StatsOverlay}" IsChecked="{Binding GoRenderStatsOverlay}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.ShowPing}" IsChecked="{Binding GoShowPing}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.ShowFps}" IsChecked="{Binding GoShowFps}" Margin="0,0,24,8" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.VerboseLogging}" IsChecked="{Binding GoDebugVerboseLogging}" Margin="0,0,24,8" />
                            </WrapPanel>

                            <Grid ColumnDefinitions="180,*,Auto" IsEnabled="{Binding GoRenderLimitFramerate}">
                                <TextBlock Text="{localization:Localize GameSettings.Go.EngineFpsLimit}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding GoRenderFpsLimit}" Minimum="30" Maximum="500" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding GoRenderFpsLimit}" Minimum="30" Maximum="500" Classes="slider-input" />
                            </Grid>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <TextBlock Text="{localization:Localize GameSettings.Go.CameraSettings}" FontWeight="SemiBold" FontSize="13" Opacity="0.8" />
                            <Grid ColumnDefinitions="180,*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="{localization:Localize GameSettings.Go.MinCameraHeight}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding GoCameraMinHeight}" Minimum="50" Maximum="1000" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding GoCameraMinHeight}" Minimum="50" Maximum="1000" Classes="slider-input" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="{localization:Localize GameSettings.Go.MaxCameraHeight}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding GoCameraMaxHeightOnlyWhenLobbyHost}" Minimum="50" Maximum="1000" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding GoCameraMaxHeightOnlyWhenLobbyHost}" Minimum="50" Maximum="1000" Classes="slider-input" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{localization:Localize GameSettings.Go.CameraMoveSpeed}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Slider Grid.Column="1" Value="{Binding GoCameraMoveSpeedRatio}" Minimum="0.5" Maximum="5.0" VerticalAlignment="Center" Margin="10,0,12,0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding GoCameraMoveSpeedRatio}" Minimum="0.5" Maximum="5.0" Increment="0.1" Classes="slider-input" />
                            </Grid>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <TextBlock Text="{localization:Localize GameSettings.Go.SocialAndNotifications}" FontWeight="SemiBold" FontSize="13" Opacity="0.8" />
                            <WrapPanel HorizontalAlignment="Left" Margin="0,0,0,8">
                                <CheckBox Content="{localization:Localize GameSettings.Go.GlobalNotifications}" IsChecked="{Binding GoEnableNotifications}" Margin="0,0,24,4" />
                                <CheckBox Content="{localization:Localize GameSettings.Go.SoundNotifications}" IsChecked="{Binding GoEnableSoundNotifications}" Margin="0,0,24,4" />
                            </WrapPanel>

                            <Grid ColumnDefinitions="*,24,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Go.ChatFontSize}" />
                                    <NumericUpDown Value="{Binding GoChatFontSize}" Minimum="8" Maximum="32" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Go.ChatFadeout}" />
                                    <NumericUpDown Value="{Binding GoChatDurationSecondsUntilFadeOut}" Minimum="5" Maximum="300" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{localization:Localize GameSettings.Go.DetailedNotifications}" FontSize="12" Opacity="0.6" Margin="0,8,0,4" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <CheckBox Content="{localization:Localize GameSettings.Go.FriendOnlineInGame}" IsChecked="{Binding GoSocialNotificationFriendComesOnlineGameplay}" />
                                    <CheckBox Content="{localization:Localize GameSettings.Go.FriendOfflineInGame}" IsChecked="{Binding GoSocialNotificationFriendGoesOfflineGameplay}" />
                                    <CheckBox Content="{localization:Localize GameSettings.Go.AcceptInGame}" IsChecked="{Binding GoSocialNotificationPlayerAcceptsRequestGameplay}" />
                                    <CheckBox Content="{localization:Localize GameSettings.Go.RequestInGame}" IsChecked="{Binding GoSocialNotificationPlayerSendsRequestGameplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <CheckBox Content="{localization:Localize GameSettings.Go.FriendOnlineMenu}" IsChecked="{Binding GoSocialNotificationFriendComesOnlineMenus}" />
                                    <CheckBox Content="{localization:Localize GameSettings.Go.FriendOfflineMenu}" IsChecked="{Binding GoSocialNotificationFriendGoesOfflineMenus}" />
                                    <CheckBox Content="{localization:Localize GameSettings.Go.AcceptMenu}" IsChecked="{Binding GoSocialNotificationPlayerAcceptsRequestMenus}" />
                                    <CheckBox Content="{localization:Localize GameSettings.Go.RequestMenu}" IsChecked="{Binding GoSocialNotificationPlayerSendsRequestMenus}" />
                                </StackPanel>
                            </Grid>

                            <Separator Background="#15FFFFFF" Height="1" Margin="0,4" />

                            <StackPanel Spacing="8">
                                <TextBlock Classes="form-label" Text="{localization:Localize GameSettings.Go.GameSpyIpOverride}" />
                                <TextBox Text="{Binding GameSpyIPAddress}" Watermark="{localization:Localize GameSettings.Go.GameSpyIpWatermark}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Panel Height="200" /> <!-- Bottom Spacer -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

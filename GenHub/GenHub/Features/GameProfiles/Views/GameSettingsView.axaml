                    </Grid>
                </Border>
                <TextBlock Classes="group-label" Text="{localization:Localize GameSettings.Tsh.ScreenEdgeScroll}" ToolTip.Tip="{localization:Localize GameSettings.Tsh.ScreenEdgeScrollToolTip}" />
                <Border Classes="settings-card setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Tsh.InFullscreen}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding TshScreenEdgeScrollEnabledInFullscreenApp}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{localization:Localize GameSettings.Tsh.InFullscreen}" />

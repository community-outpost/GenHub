                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="2*" MaxWidth="324" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Camera.Height}" />
                        <Grid Grid.Column="1" Classes="row-control" ColumnDefinitions="*,Auto">
                            <Slider Value="{Binding CameraHeight}" Minimum="50" Maximum="1500" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{localization:Localize GameSettings.Camera.Height}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CameraHeight}" Minimum="50" Maximum="1500" Increment="5" FormatString="0" Classes="slider-input" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="settings-card setting-row" ToolTip.Tip="{localization:Localize GameSettings.Camera.MaxHeightToolTip}">
                    <Grid>

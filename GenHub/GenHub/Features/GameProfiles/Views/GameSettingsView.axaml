                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Go.GameSpyIpOverride}" />
                        <TextBox Grid.Column="1" Classes="form-field row-control" Text="{Binding GameSpyIPAddress}" Watermark="{localization:Localize GameSettings.Go.GameSpyIpWatermark}" AutomationProperties.Name="{localization:Localize GameSettings.Go.GameSpyIpOverride}" />
                    </Grid>
                </Border>
                <Border Classes="settings-card setting-row" ToolTip.Tip="{localization:Localize GameSettings.Go.VerboseLoggingToolTip}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="row-label" Text="{localization:Localize GameSettings.Go.VerboseLogging}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding GoDebugVerboseLogging}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{localization:Localize GameSettings.Go.VerboseLogging}" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

                            <Slider Value="{Binding CameraMaxHeight}" Minimum="50" Maximum="1500" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{localization:Localize GameSettings.Camera.MaxHeight}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CameraMaxHeight}" Minimum="50" Maximum="1500" Increment="10" FormatString="0" Classes="slider-input" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="settings-card setting-row" ToolTip.Tip="{localization:Localize GameSettings.Camera.MinHeightToolTip}">
                    <Grid>

<controls:GenHubWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels"
        xmlns:views="clr-namespace:GenHub.Features.GameProfiles.Views"
        xmlns:conv="clr-namespace:GenHub.Infrastructure.Converters"
        xmlns:notifications="clr-namespace:GenHub.Features.Notifications.Views"
        xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
        xmlns:controls="clr-namespace:GenHub.Common.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
        x:Class="GenHub.Features.GameProfiles.Views.GameProfileSettingsWindow"
        x:DataType="vm:GameProfileSettingsViewModel"
        x:Name="SettingsWindow"
        Title="{localization:Localize GameProfiles.Window.Title}"
        Width="1000" Height="760"
        MinWidth="720" MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackgroundBrush}"
        Icon="avares://GenHub/Assets/Icons/generalshub-icon.png"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <conv:ThemeBorderConverter x:Key="ThemeBorderConverter" />
        <conv:EqualityConverter x:Key="EqualityConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Panel>
            <Grid ColumnDefinitions="240,*">
                <Border Grid.Column="0" PointerPressed="OnHeaderPointerPressed" Background="Transparent">
                    <views:GameProfileSettingsSidebarView />
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                    <Grid x:Name="PageHeader"
                          Grid.Row="0"
                          Background="Transparent"
                          ColumnDefinitions="*,Auto"
                          MinHeight="88"
                          PointerPressed="OnHeaderPointerPressed">
                        <Panel Grid.Column="0" Margin="32,0,0,12">
                            <TextBlock Classes="page-title" Text="{localization:Localize GameProfiles.Navigation.General}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.General}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameProfiles.Navigation.Game}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Game}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameProfiles.Navigation.Content}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Content}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameProfiles.General.TabAppearance}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Appearance}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameSettings.Category.Video}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Video}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameSettings.Category.Audio}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Audio}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameSettings.Category.Controls}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Controls}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameSettings.Category.TheSuperHackers}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.TheSuperHackers}}" />
                            <TextBlock Classes="page-title" Text="{localization:Localize GameSettings.Category.GeneralsOnline}"
                                       IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.GeneralsOnline}}" />
                        </Panel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="0,12,12,0">
                            <Button Click="OnToggleFullscreenClick"
                                    Classes="icon-action"
                                    ToolTip.Tip="{localization:Localize GameProfiles.Window.ToggleFullscreen}"
                                    AutomationProperties.Name="{localization:Localize GameProfiles.Window.ToggleFullscreen}">
                                <PathIcon Data="M4,4H20V20H4V4M6,8V18H18V8H6Z" />
                            </Button>
                            <Button Command="{Binding ExecuteCancelCommand}"
                                    Classes="icon-action"
                                    ToolTip.Tip="{localization:Localize Common.CloseEsc}"
                                    AutomationProperties.Name="{localization:Localize Common.CloseEsc}">
                                <PathIcon Data="{StaticResource CloseIcon}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Panel Grid.Row="1" ClipToBounds="True">
                        <views:GameProfileGameSelectionView IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Game}}" />
                        <views:GameProfileContentEditorView IsVisible="{Binding SelectedPage, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:ProfileSettingsPage.Content}}" />
                        <views:GameProfileGeneralSettingsView IsVisible="{Binding IsProfileSettingsTabVisible}" />
                        <Panel IsVisible="{Binding IsGameSettingsTabVisible}">
                            <views:GameSettingsView DataContext="{Binding GameSettingsViewModel}" />
                        </Panel>
                    </Panel>

                    <Border x:Name="FooterBar"
                            Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="32,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Content="{localization:Localize Common.Cancel}"
                                    Command="{Binding ExecuteCancelCommand}"
                                    Classes="action-secondary"
                                    MinWidth="100" />
                            <Button Command="{Binding SaveCommand}"
                                    Classes="action-primary"
                                    MinWidth="120"
                                    ToolTip.Tip="{localization:Localize GameProfiles.Window.SaveTooltip}"
                                    AutomationProperties.Name="{localization:Localize Common.Button.Save}">
                                <TextBlock Text="{localization:Localize Common.Button.Save}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Add Local Content Dialog -->
            <Border
                    IsVisible="{Binding IsAddLocalContentDialogOpen}"
                    Background="#CC000000"
                    ZIndex="1002">
                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{Binding ColorValue, Converter={StaticResource ThemeBorderConverter}, Mode=OneWay}"
                        BorderThickness="2"
                        CornerRadius="16"
                        Width="420"
                        Padding="24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        TextElement.Foreground="White">
                    <StackPanel Spacing="16">
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.DialogTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Selected Folder -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.SelectedFolder}" FontSize="12" Opacity="0.8" />
                            <Border Background="#15FFFFFF" CornerRadius="6" Padding="10,8">
                                <TextBlock Text="{Binding LocalContentDirectoryPath}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding LocalContentDirectoryPath}" />
                            </Border>
                        </StackPanel>

                        <!-- Content Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.ContentName}" FontSize="12" Opacity="0.8" />
                            <TextBox Classes="form-field" Text="{Binding LocalContentName, Mode=TwoWay}"
                                     Watermark="{localization:Localize GameProfiles.LocalContent.ContentNameWatermark}" />
                        </StackPanel>

                        <!-- Content Type -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.ContentType}" FontSize="12" Opacity="0.8" />
                            <ComboBox Classes="form-field" ItemsSource="{x:Static vm:GameProfileSettingsViewModel.AllowedLocalContentTypes}"
                                      SelectedItem="{Binding SelectedLocalContentType}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:ContentTypeDisplayConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.PublisherNote}"
                                       FontSize="10" Opacity="0.6" FontStyle="Italic" />
                        </StackPanel>

                        <!-- Game Type Selection - Always visible -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.TargetGame}" FontSize="12" Opacity="0.8" />
                            <ComboBox Classes="form-field" ItemsSource="{x:Static vm:GameProfileSettingsViewModel.AvailableLocalGameTypes}"
                                      SelectedItem="{Binding SelectedLocalGameType}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:GameTypeDisplayConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{localization:Localize GameProfiles.LocalContent.TargetGameNote}"
                                       FontSize="10" Opacity="0.6" FontStyle="Italic" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                            <Button
                                    Grid.Column="1"
                                    Content="{localization:Localize Common.Cancel}"
                                    Command="{Binding CancelAddLocalContentCommand}"
                                    Margin="0,0,12,0"
                                    Classes="action-secondary"
                                    MinWidth="90"/>
                            <Button
                                    Grid.Column="2"
                                    Command="{Binding ConfirmAddLocalContentCommand}"
                                    Classes="action-primary"
                                    MinWidth="130">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource ConfirmationCheckIcon}"    VerticalAlignment="Center"/>
                                    <TextBlock Text="{localization:Localize GameProfiles.LocalContent.AddContentButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Loading overlay -->
            <Border
                    IsVisible="{Binding IsInitializing}"
                    Background="#DD000000"
                    ZIndex="1001">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock Text="{localization:Localize Common.Status.Loading}" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Saving overlay -->
            <Border
                    IsVisible="{Binding IsSaving}"
                    Background="#CC000000"
                    ZIndex="1000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock Text="{localization:Localize Common.Status.Saving}" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Error Panel -->
            <Border
                    Background="#CC000000"
                    IsVisible="{Binding LoadingError}"
                    ZIndex="1000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Width="18" Height="18" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize GameProfiles.Window.LoadError}" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button
                            Content="{localization:Localize Common.Close}"
                            HorizontalAlignment="Center"
                            Command="{Binding ExecuteCancelCommand}"
                            Classes="action-secondary"/>
                </StackPanel>
            </Border>

            <notifications:NotificationContainerView DataContext="{Binding NotificationManager}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,90,10,0"
                                                   ZIndex="2000" />
        </Panel>
    </Border>
</controls:GenHubWindow>

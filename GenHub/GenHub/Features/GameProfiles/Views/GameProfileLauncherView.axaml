<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenHub.Common.Controls" xmlns:vm="clr-namespace:GenHub.Features.GameProfiles.ViewModels" xmlns:content="clr-namespace:GenHub.Core.Models.Content;assembly=GenHub.Core" xmlns:localization="clr-namespace:GenHub.Common.Markup" xmlns:constants="clr-namespace:GenHub.Core.Constants;assembly=GenHub.Core" xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" x:Class="GenHub.Features.GameProfiles.Views.GameProfileLauncherView" x:DataType="vm:GameProfileLauncherViewModel" x:CompileBindings="True" x:Name="ProfileLibrary" DragDrop.AllowDrop="True" Background="{DynamicResource SurfaceBackgroundBrush}">
    <controls:SidebarLayout x:Name="ProfileLibraryLayout" PaneTitle="{localization:Localize GameProfiles.Library.MyProfiles}" ItemsSource="{Binding LibraryProfiles}" SelectedItem="{Binding DisplayedProfile, Mode=TwoWay}" OpenPaneLength="260" MinPaneLength="220" MaxPaneLength="360">
        <controls:SidebarLayout.PaneHeader>
            <StackPanel>
                <TextBlock Text="{Binding LibraryProfileCount}" Classes="library-secondary" Margin="0,0,0,10"/>
                <TextBox Margin="0,0,0,14" Text="{Binding ProfileSearchText, Mode=TwoWay}" Watermark="{localization:Localize GameProfiles.Library.Search}" AutomationProperties.Name="{localization:Localize GameProfiles.Library.Search}" MinHeight="38" CornerRadius="8" Padding="10,8" VerticalContentAlignment="Center"/>
                <ComboBox Margin="0,0,0,14" x:Name="SortModeComboBox" ItemsSource="{Binding AvailableSortModes}" SelectedItem="{Binding SelectedSortModeItem}" HorizontalAlignment="Stretch" AutomationProperties.Name="{localization:Localize GameProfiles.Launcher.Tooltip.Sort}" DropDownOpened="SortModeComboBox_DropDownOpened" DropDownClosed="SortModeComboBox_DropDownClosed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{localization:Localize GameProfiles.Library.NoMatches}" Classes="library-secondary" IsVisible="{Binding !HasLibraryProfiles}" Margin="0,6"/>
            </StackPanel>
        </controls:SidebarLayout.PaneHeader>
        <controls:SidebarLayout.PaneFooter>
            <StackPanel Spacing="8">
                <Button Classes="action-secondary library-action" Command="{Binding CreateNewProfileCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{localization:Localize GameProfiles.Library.NewProfile}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Classes="action-secondary library-action" Command="{Binding ImportProfileCommand}" Content="{localization:Localize GameProfiles.Launcher.Button.Import}" Margin="0,0,6,0"/>
                    <Button Classes="action-secondary library-action" Command="{Binding ScanForGamesCommand}" Content="{localization:Localize GameProfiles.Button.Scan}" IsEnabled="{Binding !IsScanning}"/>
                </WrapPanel>
                <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Status.Scanning}" IsVisible="{Binding IsScanning}"/>
                <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsScanning}"/>
            </StackPanel>
        </controls:SidebarLayout.PaneFooter>
        <controls:SidebarLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:GameProfileItemViewModel">
                <Border BorderBrush="{Binding ColorValue, Converter={StaticResource ColorToBrushConverter}}" BorderThickness="3,0,0,0" Padding="8,0,0,0">
                    <Grid ColumnDefinitions="42,*">
                        <Image Source="{Binding IconPath, Converter={StaticResource StringToImageConverter}}" Width="32" Height="32" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </controls:SidebarLayout.ItemTemplate>
        <Grid RowDefinitions="Auto,*">
            <Button Classes="action-secondary library-action" Content="{localization:Localize GameProfiles.Library.MyProfiles}" Command="{Binding #ProfileLibraryLayout.OpenPaneCommand}" IsVisible="{Binding !#ProfileLibraryLayout.IsPaneOpen}" AutomationProperties.Name="{localization:Localize GameProfiles.Library.MyProfiles}" Margin="16,12" />
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Center" Margin="30" IsVisible="{Binding IsLibraryInitializing}"/>
                <TextBlock Text="{localization:Localize GameProfiles.Library.LoadError}" Classes="library-secondary" Margin="30" VerticalAlignment="Center" IsVisible="{Binding HasLibraryLoadError}"/>
                <StackPanel IsVisible="{Binding IsLibraryEmpty}" Margin="30" Spacing="16" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="{localization:Localize GameProfiles.Library.EmptyTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{localization:Localize GameProfiles.Library.EmptyHelp}" Classes="library-secondary"/>
                    <Button Classes="action-primary library-action library-play" Content="{localization:Localize GameProfiles.Library.NewProfile}" Command="{Binding CreateNewProfileCommand}"/>
                    <StackPanel IsVisible="{Binding ShouldShowStorefrontBanner}" Spacing="12">
                        <TextBlock Text="{localization:Localize GameProfiles.Storefront.BannerDescription}" Classes="library-secondary"/>
                        <WrapPanel>
                            <Button Classes="action-secondary library-action" Command="{Binding OpenSteamStoreCommand}" Content="{localization:Localize GameProfiles.Storefront.SteamButton}" Margin="0,0,8,8"/>
                            <Button Classes="action-secondary library-action" Command="{Binding OpenEaStoreCommand}" Content="{localization:Localize GameProfiles.Storefront.EaAppButton}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
                <Grid IsVisible="{Binding HasDisplayedProfile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MaxHeight="220"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid DataContext="{Binding DisplayedProfile}" x:DataType="vm:GameProfileItemViewModel" ClipToBounds="True">
                        <Border Height="220" ClipToBounds="True" VerticalAlignment="Top">
                            <Image Source="{Binding CoverImagePath, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill" Opacity="0.65"/>
                        </Border>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{DynamicResource SurfaceBackgroundDark}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="30,36,30,22" Spacing="8" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Text="{Binding LibraryHeaderMetadata}" Classes="library-secondary" IsVisible="{Binding LibraryHeaderMetadata, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Grid>
                        <Grid Grid.Row="1" Margin="30,0,30,0" DataContext="{Binding DisplayedProfile}" x:DataType="vm:GameProfileItemViewModel" ColumnDefinitions="*,Auto">
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="action-primary library-action library-play" Command="{Binding LaunchProfileCommand}" IsVisible="{Binding !IsProcessRunning}" IsEnabled="{Binding !IsPreparingWorkspace}" Margin="0,0,20,8" AutomationProperties.Name="{localization:Localize GameProfiles.Library.Play}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{localization:Localize GameProfiles.Library.Play}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="action-danger library-action library-play library-stop" Command="{Binding StopProfileCommand}" IsVisible="{Binding IsProcessRunning}" Margin="0,0,20,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon Kind="Stop" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{localization:Localize GameProfiles.Card.Action.Stop}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding LibraryLaunchStatus}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LibraryLaunchMethod}" Classes="library-secondary"/>
                                </StackPanel>
                            </WrapPanel>
                            <Button Grid.Column="1" Classes="action-secondary library-action" Padding="10" MinWidth="40" Height="40" VerticalAlignment="Top" AutomationProperties.Name="{localization:Localize GameProfiles.Library.Actions}">
                                <material:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{localization:Localize GameProfiles.Library.EditProfile}" Command="{Binding EditProfileCommand}" IsEnabled="{Binding CanEdit}"/>
                                        <MenuItem Header="{localization:Localize GameProfiles.Card.Menu.ShareProfile}" Command="{Binding ShareProfileCommand}"/>
                                        <MenuItem Header="{localization:Localize GameProfiles.Card.Tooltip.CopyProfile}" Command="{Binding CopyProfileCommand}"/>
                                        <MenuItem Header="{localization:Localize GameProfiles.Card.Tooltip.CreateShortcut}" Command="{Binding CreateShortcutCommand}"/>
                                        <MenuItem Header="{localization:Localize GameProfiles.Library.MoveEarlier}" Command="{Binding MoveLeftCommand}" IsVisible="{Binding IsFreeReorderMode}"/>
                                        <MenuItem Header="{localization:Localize GameProfiles.Library.MoveLater}" Command="{Binding MoveRightCommand}" IsVisible="{Binding IsFreeReorderMode}"/>
                                        <Separator/>
                                        <MenuItem Header="{localization:Localize GameProfiles.Card.Tooltip.DeleteProfile}" Command="{Binding DeleteProfileCommand}" Foreground="{DynamicResource ErrorBrush}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    <ScrollViewer Grid.Row="2" x:Name="LibraryDetail" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,22,30,30" Spacing="22">
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                            <WrapPanel>
                                <RadioButton GroupName="ProfileLibraryTabs" Theme="{StaticResource {x:Type ToggleButton}}" Classes="library-tab" Content="{localization:Localize GameProfiles.Library.Overview}" IsChecked="{Binding IsLibraryOverview, Mode=OneWay}" Command="{Binding SelectLibraryTabCommand}" CommandParameter="{x:Static constants:GameProfileLibraryConstants.OverviewTab}"/>
                                <RadioButton GroupName="ProfileLibraryTabs" Theme="{StaticResource {x:Type ToggleButton}}" Classes="library-tab" Content="{Binding LibraryContentTabHeader}" IsChecked="{Binding IsLibraryContent, Mode=OneWay}" Command="{Binding SelectLibraryTabCommand}" CommandParameter="{x:Static constants:GameProfileLibraryConstants.ContentTab}"/>
                                <RadioButton GroupName="ProfileLibraryTabs" Theme="{StaticResource {x:Type ToggleButton}}" Classes="library-tab" Content="{localization:Localize GameProfiles.Library.Settings}" IsChecked="{Binding IsLibrarySettings, Mode=OneWay}" Command="{Binding SelectLibraryTabCommand}" CommandParameter="{x:Static constants:GameProfileLibraryConstants.SettingsTab}"/>
                            </WrapPanel>
                        </Border>
                        <StackPanel IsVisible="{Binding IsLibraryOverview}" Spacing="18">
                            <StackPanel DataContext="{Binding DisplayedProfile}" x:DataType="vm:GameProfileItemViewModel" Spacing="20">
                                <StackPanel IsVisible="{Binding HasLibraryDescription}">
                                    <TextBlock Classes="library-section" Text="{localization:Localize GameProfiles.Library.About}"/>
                                    <TextBlock Classes="library-secondary" Text="{Binding LibraryDescription}"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HasCompatibilityBadge}">
                                    <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Library.Compatibility}"/>
                                    <TextBlock Text="{Binding CompatibilityBadgeText}" ToolTip.Tip="{Binding CompatibilityTooltip}" Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsLibraryContent}" Spacing="14">
                            <TextBlock Classes="library-section" Text="{localization:Localize GameProfiles.Library.IncludedContent}"/>
                            <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Library.ContentHelp}"/>
                            <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsLibraryContentLoading}"/>
                            <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Library.NoContent}" IsVisible="{Binding IsLibraryContentEmpty}"/>
                            <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Library.ContentError}" IsVisible="{Binding HasLibraryContentError}"/>
                            <ItemsControl ItemsSource="{Binding LibraryContent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="content:ContentDisplayItem">
                                        <Border Classes="library-card" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="38,*">
                                                <material:MaterialIcon Kind="PackageVariantClosed" Width="22" Height="22" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DisplayVersion}" Classes="library-secondary"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="action-secondary library-action" Content="{localization:Localize GameProfiles.Library.ManageContent}" Command="{Binding EditLibraryProfileCommand}" CommandParameter="{x:Static constants:GameProfileLibraryConstants.ContentTab}" IsEnabled="{Binding DisplayedProfile.CanEdit}"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsLibrarySettings}" Spacing="16">
                            <TextBlock Classes="library-section" Text="{localization:Localize GameProfiles.Library.LaunchSettings}"/>
                            <Border Classes="library-card" DataContext="{Binding DisplayedProfile}" x:DataType="vm:GameProfileItemViewModel">
                                <StackPanel Spacing="18">
                                    <CheckBox IsChecked="{Binding UseSteamLaunch, Mode=TwoWay}" Command="{Binding ToggleSteamLaunchCommand}" IsVisible="{Binding IsSteamIntegrationSupported}" Content="{localization:Localize GameProfiles.Library.SteamLaunch}" AutomationProperties.Name="{localization:Localize GameProfiles.Card.Tooltip.SteamIntegration}"/>
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Library.LaunchMethod}"/>
                                        <TextBlock Text="{Binding LibraryLaunchMethod}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="library-secondary" Text="{localization:Localize GameProfiles.Library.Arguments}"/>
                                        <TextBlock Text="{Binding LibraryArguments}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Classes="action-secondary library-action" Content="{localization:Localize GameProfiles.Library.EditSettings}" Command="{Binding EditLibraryProfileCommand}" CommandParameter="{x:Static constants:GameProfileLibraryConstants.SettingsTab}" IsEnabled="{Binding DisplayedProfile.CanEdit}"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
        </Grid>
        </Grid>
    </controls:SidebarLayout>
</UserControl>

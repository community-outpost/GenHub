<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- net9.0-linux doesn't exist for various reasons, so we have to use the generic net9.0 target framework -->
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" >
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="StyleCop.Analyzers" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\update_genhub.sh" />
        <EmbeddedResource Include="Resources\update_genhub.sh" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GenHub\GenHub.csproj" />
        <ProjectReference Include="..\GenHub.Core\GenHub.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Build-order-only: guarantees the proxy binary exists before BuildProxyLauncher packs it. -->
        <ProjectReference Include="..\GenHub.ProxyLauncher\GenHub.ProxyLauncher.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        </ProjectReference>
    </ItemGroup>

    <!-- Publish the Windows proxy launcher (win-x64 PE) and copy it to build output.
         The proxy must stay a Windows binary: Steam runs the swapped-in file through Proton. -->
    <Target Name="BuildProxyLauncher" BeforeTargets="Build">
        <Exec Command="dotnet publish &quot;../GenHub.ProxyLauncher/GenHub.ProxyLauncher.csproj&quot; -c $(Configuration) -f net8.0 -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IntermediateOutputPath=&quot;obj/$(Configuration)/net8.0/win-x64/Linux/&quot; -p:Version=$(Version) -p:GitShortHash=$(GitShortHash) -p:PullRequestNumber=$(PullRequestNumber) -p:BuildChannel=$(BuildChannel) -o &quot;$(MSBuildProjectDirectory)/../GenHub.ProxyLauncher/bin/Publish/Linux/$(Configuration)&quot;" />
    </Target>

    <Target Name="CopyProxyLauncher" AfterTargets="Build">
        <PropertyGroup>
            <ProxySourceDir>$(MSBuildProjectDirectory)/../GenHub.ProxyLauncher/bin/Publish/Linux/$(Configuration)</ProxySourceDir>
        </PropertyGroup>
        <ItemGroup>
            <ProxyLauncherFiles Include="$(ProxySourceDir)/GenHub.ProxyLauncher.exe" />
        </ItemGroup>
        <Message Importance="High" Text="[CopyProxyLauncher] Copying SingleFile from $(ProxySourceDir) to $(TargetDir)" />
        <Copy SourceFiles="@(ProxyLauncherFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- Ensure Proxy Launcher is included in Publish output for Velopack -->
    <Target Name="PublishProxyLauncher" AfterTargets="ComputeFilesToPublish">
        <PropertyGroup>
            <ProxySourceDir>$(MSBuildProjectDirectory)/../GenHub.ProxyLauncher/bin/Publish/Linux/$(Configuration)</ProxySourceDir>
        </PropertyGroup>
        <ItemGroup>
            <ResolvedFileToPublish Include="$(ProxySourceDir)/GenHub.ProxyLauncher.exe">
                <RelativePath>GenHub.ProxyLauncher.exe</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GenHub.Windows.Features.ActionSets.UI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="GenHub.Windows.Features.ActionSets.UI.GenPatcherToolView"
             x:DataType="vm:GenPatcherViewModel">

    <UserControl.Styles>
        <!-- Standard Action Button (GenHub Translucent Purple Style) -->
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#337B2CBF"/>
            <Setter Property="BorderBrush" Value="#669D4EDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
            <Setter Property="Background" Value="#559D4EDD"/>
            <Setter Property="BorderBrush" Value="#C77DFF"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed">
            <Setter Property="Background" Value="#7B2CBF"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.ActionBtn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- Fix Row Card Translucent Glassmorphic Style -->
        <Style Selector="Border.FixRow">
            <Setter Property="Background" Value="#1C181B2A"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FixRow:pointerover">
            <Setter Property="Background" Value="#2E282E44"/>
            <Setter Property="BorderBrush" Value="#458B5CF6"/>
        </Style>

        <!-- GenPatcher Primary Red Accent Button -->
        <Style Selector="Button.GenPatcherPrimaryBtn">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#C62828" Offset="0"/>
                    <GradientStop Color="#8E0000" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#EF5350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.GenPatcherPrimaryBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E53935" Offset="0"/>
                    <GradientStop Color="#B71C1C" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#FF8A80"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.GenPatcherPrimaryBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Glassmorphic Background with Dark Crimson Tint -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#FF0D0812"
                    TintOpacity="0.94"
                    MaterialOpacity="0.80" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!-- Red Gradient Header Glow -->
        <Border Height="160" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#40C62828" Offset="0"/>
                    <GradientStop Color="#208E0000" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Background Image (Faint watermark) -->
        <Image Source="avares://GenHub/Assets/Logos/genpatcher-logo.png"
               Opacity="0.04" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- Decoration / Content -->
        <Grid RowDefinitions="Auto, *" Margin="24,14,24,6">

            <!-- Red-tinted Glassmorphic Header Card -->
            <Border Grid.Row="0" Margin="0,0,0,16" Padding="18,14" CornerRadius="10"
                    Background="#1EC62828" BorderBrush="#35EF5350" BorderThickness="1">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <!-- GenPatcher Logo -->
                        <Image Source="avares://GenHub/Assets/Logos/genpatcher-logo.png" Height="50" VerticalAlignment="Center"/>

                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="GenPatcher" FontSize="26" FontWeight="Bold" Foreground="White">
                                 <TextBlock.Effect>
                                    <DropShadowEffect Color="#C62828" BlurRadius="14" Opacity="0.85"/>
                                 </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Essential fixes and enhancements for Command &amp; Conquer" FontSize="13" Foreground="#E0D0D0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Classes="GenPatcherPrimaryBtn" Command="{Binding ApplyAllFixesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚡" VerticalAlignment="Center"/>
                            <TextBlock Text="Apply All Recommended" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area - Scrollable List of Fixes -->
            <ScrollViewer Grid.Row="1" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding ActionSets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionSetViewModel">
                            <Border Classes="FixRow">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Force Re-Apply (Testing)" Command="{Binding ForceApplyCommand}" Foreground="White"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                            <Border IsVisible="{Binding IsCore}" Background="#B71C1C" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="CORE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#888899"/>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1" Margin="16,0" VerticalAlignment="Center" CornerRadius="12" Padding="12,4"
                                            Background="{Binding StatusBackground}"
                                            BorderBrush="{Binding StatusBorder}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding StatusDisplay}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Action Button (Purple GenHub Style) -->
                                    <Button Grid.Column="2" Classes="ActionBtn" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" VerticalAlignment="Center">
                                        <TextBlock Text="Apply"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>

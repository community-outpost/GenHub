<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:GenHub.Core.Models.GameInstallations"
             xmlns:vm="using:GenHub.Windows.Features.ActionSets.UI"
             xmlns:localization="clr-namespace:GenHub.Common.Markup;assembly=GenHub"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="GenHub.Windows.Features.ActionSets.UI.GenPatcherToolView"
             x:DataType="vm:GenPatcherViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GenPatcherBrandBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="GenPatcherBrandBorderBrush" Color="#EF5350"/>
        <SolidColorBrush x:Key="GenPatcherBrandHoverBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="GenPatcherBrandPressedBrush" Color="#B71C1C"/>
        <SolidColorBrush x:Key="GenPatcherCancelBackgroundBrush" Color="#33B71C1C"/>
        <SolidColorBrush x:Key="GenPatcherCancelBorderBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="GenPatcherCancelForegroundBrush" Color="#FFCDD2"/>
        <SolidColorBrush x:Key="GenPatcherCancelHoverBrush" Color="#4DB71C1C"/>
        <Color x:Key="GenPatcherGradientStartColor">#18C62828</Color>
        <SolidColorBrush x:Key="GenPatcherInfoBoxBackgroundBrush" Color="#1EC62828"/>
        <SolidColorBrush x:Key="GenPatcherInfoBoxBorderBrush" Color="#35EF5350"/>
        <SolidColorBrush x:Key="GenPatcherBadgeCoreBackgroundBrush" Color="#B71C1C"/>
        <SolidColorBrush x:Key="GenPatcherBadgeCoreBorderBrush" Color="#EF5350"/>
        <SolidColorBrush x:Key="GenPatcherBadgeCrucialBackgroundBrush" Color="#8E0000"/>
        <SolidColorBrush x:Key="GenPatcherBadgeCrucialBorderBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="GenPatcherBadgeCrucialForegroundBrush" Color="#FFCDD2"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Standard Action Button (GenHub Translucent Theme Style) -->
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="{DynamicResource AccentTintBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.ActionBtn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- Fix Card Glassmorphic Style -->
        <Style Selector="Border.FixCard">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Width" Value="460"/>
            <Setter Property="Margin" Value="7,4,7,14"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FixCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
        </Style>

        <!-- Details Toggle Button -->
        <Style Selector="Button.DetailsToggleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.DetailsToggleBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
        </Style>

        <!-- Category Chip Styles (Multiplayer / Mods Modern Sub-nav look) -->
        <Style Selector="Button.CategoryChip">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.CategoryChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Red Accent Button for GenPatcher Master Brand -->
        <Style Selector="Button.GenPatcherPrimaryBtn">
            <Setter Property="Background" Value="{DynamicResource GenPatcherBrandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GenPatcherBrandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.GenPatcherPrimaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource GenPatcherBrandHoverBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.GenPatcherPrimaryBtn:pressed">
            <Setter Property="Background" Value="{DynamicResource GenPatcherBrandPressedBrush}"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="Button.GenPatcherPrimaryBtn:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Cancel Batch Button -->
        <Style Selector="Button.GenPatcherCancelBtn">
            <Setter Property="Background" Value="{DynamicResource GenPatcherCancelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GenPatcherCancelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="{DynamicResource GenPatcherCancelForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.GenPatcherCancelBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource GenPatcherCancelHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel Background="{DynamicResource BackgroundBrush}">
        <!-- Faint Top Gradient in GenPatcher Red tone -->
        <Border Height="300" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="{DynamicResource GenPatcherGradientStartColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Background Image (Faint watermark) -->
        <Image Source="avares://GenHub/Assets/Logos/genpatcher-logo.png"
               Opacity="0.04" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- Main Content Area -->
        <Grid RowDefinitions="Auto, Auto, *" Margin="24,14,24,6">

            <!-- Red-tinted Glassmorphic Header Card -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="18,14" CornerRadius="10"
                    Background="{DynamicResource GenPatcherInfoBoxBackgroundBrush}" BorderBrush="{DynamicResource GenPatcherInfoBoxBorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <!-- Title & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Image Source="avares://GenHub/Assets/Logos/genpatcher-logo.png" Height="50" VerticalAlignment="Center"/>

                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="GenPatcher" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <!-- Progress Pill -->
                                <Border Background="#2010B981" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressSummaryText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{localization:Localize Tools.GenPatcher.Subtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Target Installation Selector -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="3">
                        <TextBlock Text="{localization:Localize Tools.GenPatcher.TargetInstallation}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableInstallations}"
                                  SelectedItem="{Binding SelectedInstallation}"
                                  IsEnabled="{Binding CanChangeInstallation}"
                                  MinWidth="220"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:GameInstallation">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding InstallationType}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding InstallationPath}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Batch Action Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="GenPatcherPrimaryBtn" 
                                Command="{Binding ApplyAllFixesCommand}" 
                                IsVisible="{Binding !IsBatchApplying}" 
                                VerticalAlignment="Center">
                            <TextBlock Text="{localization:Localize Tools.GenPatcher.ApplyAllRecommended}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Button>
                        <Button Classes="GenPatcherCancelBtn" 
                                Command="{Binding CancelBatchApplyCommand}" 
                                IsVisible="{Binding IsBatchApplying}" 
                                VerticalAlignment="Center">
                            <TextBlock Text="{localization:Localize Tools.GenPatcher.CancelBatch}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter & Search Toolbar -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                <!-- Category Filter Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="CategoryChip" Command="{Binding SetCategoryCommand}" CommandParameter="All">
                        <TextBlock Text="{Binding AllCategoryText}"/>
                    </Button>
                    <Button Classes="CategoryChip" Command="{Binding SetCategoryCommand}" CommandParameter="Core &amp; Stability">
                        <TextBlock Text="{Binding CoreCategoryText}"/>
                    </Button>
                    <Button Classes="CategoryChip" Command="{Binding SetCategoryCommand}" CommandParameter="Compatibility">
                        <TextBlock Text="{Binding CompatibilityCategoryText}"/>
                    </Button>
                    <Button Classes="CategoryChip" Command="{Binding SetCategoryCommand}" CommandParameter="Multiplayer">
                        <TextBlock Text="{Binding MultiplayerCategoryText}"/>
                    </Button>
                    <Button Classes="CategoryChip" Command="{Binding SetCategoryCommand}" CommandParameter="Quality of Life">
                        <TextBlock Text="{Binding QolCategoryText}"/>
                    </Button>
                </StackPanel>

                <!-- Search Box -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="{localization:Localize Tools.GenPatcher.SearchWatermark}"
                             Width="240"
                             Padding="10,6"
                             CornerRadius="8"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextPrimary}"
                             FontSize="12"/>
                </Grid>
            </Grid>

            <!-- Content Area - Scrollable Card Grid -->
            <ScrollViewer Grid.Row="2" Focusable="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,6,0">
                <ItemsControl ItemsSource="{Binding FilteredActionSets}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionSetViewModel">
                            <Border Classes="FixCard">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{localization:Localize Tools.GenPatcher.ForceReapply}" Command="{Binding ForceApplyCommand}" Foreground="{DynamicResource TextPrimary}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid RowDefinitions="Auto, *, Auto, Auto">
                                    <!-- Card Header: Title + Badges + Status -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <!-- Badges Row -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border IsVisible="{Binding IsCore}" Background="{DynamicResource GenPatcherBadgeCoreBackgroundBrush}" BorderBrush="{DynamicResource GenPatcherBadgeCoreBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{localization:Localize Tools.GenPatcher.Badge.Core}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Border IsVisible="{Binding IsCrucial}" Background="{DynamicResource GenPatcherBadgeCrucialBackgroundBrush}" BorderBrush="{DynamicResource GenPatcherBadgeCrucialBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{localization:Localize Tools.GenPatcher.Badge.Crucial}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource GenPatcherBadgeCrucialForegroundBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="10" Padding="10,3"
                                                Background="{Binding StatusBackground}"
                                                BorderBrush="{Binding StatusBorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding StatusDisplay}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding StatusColor}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Card Body: Concise Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,8"/>

                                    <!-- Expandable In-Depth Details Drawer -->
                                    <Border Grid.Row="2" IsVisible="{Binding IsExpanded}"
                                            Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{localization:Localize Tools.GenPatcher.WhyNeeded}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding DetailedDescription}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            <!-- Last result log if executed -->
                                            <StackPanel IsVisible="{Binding HasActionResultDetails}" Spacing="2" Margin="0,4,0,0">
                                                <TextBlock Text="{localization:Localize Tools.GenPatcher.LastExecutionResult}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding LastActionResultDetails}" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card Footer: Details Toggle + Action Button -->
                                    <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <!-- Show More / Less Toggle Button -->
                                        <Button Grid.Column="0" Classes="DetailsToggleBtn" Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{localization:Localize Tools.GenPatcher.Details}" FontSize="11"/>
                                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Apply / Cancel Action Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Classes="ActionBtn" Command="{Binding ApplyCommand}" IsVisible="{Binding !IsApplying}" IsEnabled="{Binding CanApply}" VerticalAlignment="Center">
                                                <TextBlock Text="{localization:Localize Tools.GenPatcher.Apply}"/>
                                            </Button>
                                            <Button Classes="GenPatcherCancelBtn" Command="{Binding CancelApplyCommand}" IsVisible="{Binding IsApplying}" VerticalAlignment="Center" Padding="12,5">
                                                <TextBlock Text="{localization:Localize Tools.GenPatcher.Cancel}" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Directory.Publish.props" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\GenHub\Assets\Icons\generalshub.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Debug ships the Windows Playwright driver next to the binaries. Release keeps
             the Directory.Build.props default (none): the driver downloads on demand. -->
        <PlaywrightPlatform Condition="'$(Configuration)' != 'Release'">win-x64</PlaywrightPlatform>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GenHub.Tests.Windows" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="DotNetEnv" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="StyleCop.Analyzers" />
        <PackageReference Include="System.Management" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\update_genhub.ps1" />
        <EmbeddedResource Include="Resources\update_genhub.ps1" />
    </ItemGroup>

    <!-- Copy .env file to output directory for local debugging if it exists -->
    <ItemGroup Condition="Exists('..\..\.env')">
        <None Include="..\..\.env">
            <Link>.env</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GenHub\GenHub.csproj" />
        <ProjectReference Include="..\GenHub.Core\GenHub.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Build-order-only: guarantees the proxy and overlay binaries exist before MSBuild targets pack them. -->
        <ProjectReference Include="..\GenHub.ProxyLauncher\GenHub.ProxyLauncher.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
            <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        </ProjectReference>
        <ProjectReference Include="..\GenHub.Overlay\GenHub.Overlay.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
            <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        </ProjectReference>
    </ItemGroup>

    <Import Project="..\GenHub.ProxyLauncher\GenHub.ProxyLauncher.Bundle.targets" />

    <!-- Ensure Overlay is PUBLISHED as SingleFile and copied to build output -->
    <Target Name="BuildOverlay" BeforeTargets="Build">
        <Exec Command="dotnet publish &quot;..\GenHub.Overlay\GenHub.Overlay.csproj&quot; -c $(Configuration) -f net8.0 -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IntermediateOutputPath=&quot;obj/$(Configuration)/net8.0/win-x64/Overlay/&quot; -p:Version=$(Version) -p:GitShortHash=$(GitShortHash) -p:PullRequestNumber=$(PullRequestNumber) -p:BuildChannel=$(BuildChannel) -o &quot;$(MSBuildProjectDirectory)\..\GenHub.Overlay\bin\Publish\$(Configuration)&quot;" />
    </Target>

    <Target Name="CopyOverlay" AfterTargets="Build">
        <PropertyGroup>
            <OverlaySourceDir>$(MSBuildProjectDirectory)\..\GenHub.Overlay\bin\Publish\$(Configuration)</OverlaySourceDir>
        </PropertyGroup>
        <ItemGroup>
            <OverlayFiles Include="$(OverlaySourceDir)\genhub-overlay.exe" />
            <OverlayFiles Include="$(OverlaySourceDir)\genhub-overlay.pdb" Condition="Exists('$(OverlaySourceDir)\genhub-overlay.pdb')" />
            <OverlayFiles Include="$(OverlaySourceDir)\genhub-overlay.runtimeconfig.json" Condition="Exists('$(OverlaySourceDir)\genhub-overlay.runtimeconfig.json')" />
            <WintunFiles Include="$(MSBuildProjectDirectory)\..\GenHub.Core\Resources\Wintun\x64\wintun.dll" />
        </ItemGroup>
        <Message Importance="High" Text="[CopyOverlay] Copying SingleFile from $(OverlaySourceDir) to $(TargetDir)" />
        <Copy SourceFiles="@(OverlayFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(WintunFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- Ensure Overlay is included in Publish output for Velopack -->
    <Target Name="PublishOverlay" AfterTargets="ComputeFilesToPublish">
        <PropertyGroup>
            <OverlaySourceDir>$(MSBuildProjectDirectory)\..\GenHub.Overlay\bin\Publish\$(Configuration)</OverlaySourceDir>
        </PropertyGroup>
        <ItemGroup>
            <ResolvedFileToPublish Include="$(OverlaySourceDir)\genhub-overlay.exe">
                <RelativePath>genhub-overlay.exe</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <ResolvedFileToPublish Include="$(OverlaySourceDir)\genhub-overlay.runtimeconfig.json" Condition="Exists('$(OverlaySourceDir)\genhub-overlay.runtimeconfig.json')">
                <RelativePath>genhub-overlay.runtimeconfig.json</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\GenHub.Core\Resources\Wintun\x64\wintun.dll">
                <RelativePath>wintun.dll</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
